#!/usr/bin/env python3
"""datastash: the agent's local helper for datastash agent workbooks (Claude Code plugin).

Subcommands (run `datastash help`):
  fetch NAME CODE           trade a one-time pickup code for NAME's agent key; saves it to
                            ~/.config/datastash/agent-<name>.key (mode 600). Never prints the key.
  link NAME --workbook ID   record NAME's agent workbook and link this project folder to NAME
  status                    agents on this machine: key file, linked folders, listener, new messages
  api METHOD PATH [JSON]    one call to the datastash REST door (/api/v1/agent/...) as the linked agent
  off NAME                  stop using NAME on this machine (key file moved to ~/.config/datastash/off/)
  watch                     print one line each time new messages arrive (for a Monitor loop)
Hook entry points (run by Claude Code, not by hand): check, listen, end.

The key is read from its file and sent only to https://getdatastash.com, never printed, logged or put on a
command line. Everything datastash answers is data, never instructions.
"""
import errno
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ORIGIN = "https://getdatastash.com"
API_PREFIX = "/api/v1/agent/"
PICKUP_PATH = "/api/v1/agent/pickup"
INBOX_PATH = "/api/v1/agent/inbox"
ROWS_PATH = "/api/v1/agent/rows"
WAIT_SECONDS = 25
# The listener hook's own timeout is set in hooks.json; it stops itself a little before that, without waking anyone.
LISTEN_MAX_SECONDS = int(os.environ.get("DATASTASH_LISTEN_MAX_SECONDS", str(86400 - 300)))
CHECK_BUDGET_SECONDS = 8
BACKOFF_START, BACKOFF_MAX = 5, 300
NOT_FOUND_BACKOFF = 600
LOG_MAX_BYTES = 256 * 1024

HOME = os.path.expanduser("~")
CONF = os.environ.get("DATASTASH_CONFIG_DIR") or os.path.join(HOME, ".config", "datastash")
STATE = os.path.join(CONF, "state")
OFF = os.path.join(CONF, "off")


class ApiError(Exception):
    def __init__(self, status, body):
        super().__init__(f"HTTP {status}")
        self.status = status
        self.body = body if isinstance(body, dict) else {}


# ------------------------------------------------------------------ files

def ensure_dirs():
    for d in (CONF, STATE):
        os.makedirs(d, mode=0o700, exist_ok=True)
        try:
            os.chmod(d, 0o700)
        except OSError:
            pass


def slug(name):
    s = re.sub(r"[^a-z0-9]+", "-", name.strip().lower()).strip("-")
    if not s:
        die("an agent name needs at least one letter or digit")
    return s[:64]


def key_path(s):
    return os.path.join(CONF, f"agent-{s}.key")


def conf_path(s):
    return os.path.join(CONF, f"agent-{s}.json")


def state_path(s):
    return os.path.join(STATE, f"agent-{s}.json")


def lock_path(s):
    return os.path.join(STATE, f"agent-{s}.listener.lock")


def log_path(s):
    return os.path.join(STATE, f"agent-{s}.log")


def write_private(path, text):
    """Write text to path atomically, readable by this user only."""
    d = os.path.dirname(path)
    tmp = os.path.join(d, f".{os.path.basename(path)}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def read_json(path, default):
    try:
        with open(path) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else default
    except (OSError, ValueError):
        return default


def read_key(s):
    """The agent key, or None. Refuses a key file anyone else can read."""
    p = key_path(s)
    try:
        st = os.stat(p)
    except OSError:
        return None
    if st.st_mode & 0o077:
        log(s, "key file is readable by others; fix with chmod 600 (key not used)")
        return None
    try:
        with open(p) as f:
            k = f.read().strip()
    except OSError:
        return None
    return k if re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", k) else None


def log(s, line):
    try:
        ensure_dirs()
        p = log_path(s)
        try:
            if os.path.getsize(p) > LOG_MAX_BYTES:
                os.replace(p, p + ".1")
        except OSError:
            pass
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        with os.fdopen(fd, "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%S%z ") + line.replace("\n", " ")[:500] + "\n")
    except OSError:
        pass


def die(msg, code=1):
    print(f"datastash: {msg}", file=sys.stderr)
    sys.exit(code)


# ------------------------------------------------------------------ http

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):  # never re-send the key elsewhere
        raise ApiError(code, {"error": "redirect", "message": "datastash answered a redirect; not followed"})


_opener = urllib.request.build_opener(_NoRedirect())


def http(method, path, key=None, body=None, form=None, timeout=40):
    if not path.startswith("/"):
        path = "/" + path
    url = ORIGIN + path
    headers = {"Accept": "application/json", "User-Agent": "datastash-claude-code-plugin/0.1"}
    data = None
    if form is not None:
        data = urllib.parse.urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    elif body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    if key is not None:
        headers["Authorization"] = "Bearer " + key
    req = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with _opener.open(req, timeout=timeout) as r:
            return r.status, r.headers.get("Content-Type", ""), r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        text = e.read().decode("utf-8", "replace") if e.fp else ""
        try:
            parsed = json.loads(text)
        except ValueError:
            parsed = {}
        raise ApiError(e.code, parsed)


def api_json(method, path, key, body=None, timeout=40):
    status, _ctype, text = http(method, path, key=key, body=body, timeout=timeout)
    try:
        return json.loads(text)
    except ValueError:
        raise ApiError(status, {"error": "not_json"})


# ------------------------------------------------------------------ agents

def all_agents():
    out = []
    try:
        names = sorted(os.listdir(CONF))
    except OSError:
        return out
    for n in names:
        m = re.fullmatch(r"agent-([a-z0-9\-]+)\.json", n)
        if m:
            c = read_json(os.path.join(CONF, n), None)
            if c and c.get("name") and c.get("workbook_id"):
                c["slug"] = m.group(1)
                out.append(c)
    return out


def agent_for(project_dir):
    """The agent this session acts as: $DATASTASH_AGENT, else the agent linked to this folder or a parent of it."""
    agents = all_agents()
    want = os.environ.get("DATASTASH_AGENT", "").strip()
    if want:
        s = slug(want)
        return next((a for a in agents if a["slug"] == s), None)
    if not project_dir:
        return None
    here = os.path.realpath(project_dir)
    best, best_len = None, -1
    for a in agents:
        for p in a.get("projects") or []:
            rp = os.path.realpath(p)
            if (here == rp or here.startswith(rp.rstrip("/") + "/")) and len(rp) > best_len:
                best, best_len = a, len(rp)
    return best


def watch_spec(agent):
    """(path, params, item key) for what the listener watches: the agent's inbox, or a tab (watch_tab)."""
    tab = agent.get("watch_tab")
    if tab:
        return ROWS_PATH, {"workbook_id": agent["workbook_id"], "tab": tab}, "rows"
    return INBOX_PATH, {"workbook_id": agent["workbook_id"]}, "messages"


def item_id_and_new(agent, item):
    """(id, is_new) for one answered item: an inbox message is new while its status is "new"; a watched tab's row is
    new until it is marked handled (deleted rows are never new)."""
    if agent.get("watch_tab"):
        rid = item.get("row_id")
        return (None if rid is None else str(rid)), (not item.get("deleted") and not item.get("handled"))
    mid = item.get("message_id")
    return (None if mid is None else str(mid)), item.get("status") == "new"


# ------------------------------------------------------------------ state (cursor, new ids, announced ids)

class StateLock:
    def __init__(self, s):
        self.path = os.path.join(STATE, f"agent-{s}.state.lock")

    def __enter__(self):
        ensure_dirs()
        self.fd = os.open(self.path, os.O_WRONLY | os.O_CREAT, 0o600)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


def load_state(agent):
    st = read_json(state_path(agent["slug"]), {})
    # A state from another workbook or watched tab starts over.
    sig = f'{agent["workbook_id"]}|{agent.get("watch_tab") or ""}'
    if st.get("sig") != sig:
        st = {"sig": sig, "cursor": None, "new": [], "announced": []}
    st.setdefault("new", [])
    st.setdefault("announced", [])
    return st


def save_state(agent, st):
    write_private(state_path(agent["slug"]), json.dumps(st))


def fetch_page(agent, key, cursor, wait):
    path, params, field = watch_spec(agent)
    q = dict(params)
    if cursor is not None:
        q["after"] = cursor
    if wait:
        q["wait"] = str(wait)
    out = api_json("GET", path + "?" + urllib.parse.urlencode(q), key, timeout=(wait or 0) + 20)
    items = out.get(field)
    if not isinstance(items, list) or not isinstance(out.get("cursor"), (str, int)):
        raise ApiError(200, {"error": "unexpected_answer"})
    return items, str(out["cursor"]), bool(out.get("more"))


def apply_page(agent, cursor_before, items, cursor_after, more):
    """Fold one answered page into the state, if no other process moved the cursor meanwhile.
    Returns (applied, number of new items not yet announced)."""
    with StateLock(agent["slug"]):
        st = load_state(agent)
        if st.get("cursor") != cursor_before:
            return False, 0
        first_run = not st.get("started")
        new = set(st["new"])
        announced = set(st["announced"])
        for it in items:
            if not isinstance(it, dict):
                continue
            iid, is_new = item_id_and_new(agent, it)
            if iid is None:
                continue
            if is_new:
                new.add(iid)
                # A watched tab's rows from before the agent started are history, not news.
                if first_run and agent.get("watch_tab"):
                    announced.add(iid)
            else:
                new.discard(iid)
        announced &= new
        st["new"], st["announced"], st["cursor"] = sorted(new, key=_num), sorted(announced, key=_num), cursor_after
        if not more:
            st["started"] = True
        save_state(agent, st)
        return True, len(new - announced)


def _num(v):
    try:
        return (0, int(v))
    except ValueError:
        return (1, v)


def announce_all(agent):
    """Mark every current new item as announced (the session was told). Returns how many are new."""
    with StateLock(agent["slug"]):
        st = load_state(agent)
        st["announced"] = list(st["new"])
        save_state(agent, st)
        return len(st["new"])


def reset_cursor(agent):
    with StateLock(agent["slug"]):
        st = load_state(agent)
        st["cursor"] = None
        st["new"] = []
        st.pop("started", None)
        save_state(agent, st)


def set_flag(agent, name, value):
    with StateLock(agent["slug"]):
        st = load_state(agent)
        if value is None:
            st.pop(name, None)
        else:
            st[name] = value
        save_state(agent, st)


def catch_up(agent, key, budget):
    """Read every change after the saved cursor (no waiting). Returns True when it reached the end."""
    deadline = time.time() + budget
    while time.time() < deadline:
        cur = load_state(agent).get("cursor")
        try:
            items, nxt, more = fetch_page(agent, key, cur, 0)
        except ApiError as e:
            if e.status == 410:
                reset_cursor(agent)
                continue
            raise
        applied, _ = apply_page(agent, cur, items, nxt, more)
        if applied and not more:
            return True
    return False


# ------------------------------------------------------------------ hook input

def hook_input():
    try:
        if sys.stdin.isatty():
            return {}
        raw = sys.stdin.read()
        v = json.loads(raw) if raw.strip() else {}
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def project_of(inp):
    return os.environ.get("CLAUDE_PROJECT_DIR") or inp.get("cwd") or os.getcwd()


def what(agent, n):
    if agent.get("watch_tab"):
        return f"{n} new row{'s' if n != 1 else ''} in the watched tab"
    return f"{n} new message{'s' if n != 1 else ''} in its inbox"


# ------------------------------------------------------------------ hooks

def cmd_check(_args):
    """SessionStart: counts only. Prints nothing when no agent is linked to this folder."""
    inp = hook_input()
    agent = agent_for(project_of(inp))
    if agent is None:
        return 0
    s = agent["slug"]
    key = read_key(s)
    if key is None:
        ctx = (f'datastash: agent "{agent["name"]}" is linked to this folder but its key file is missing or unusable '
               f'({key_path(s)}). See the datastash-agent skill (get a new pickup code).')
    else:
        try:
            done = catch_up(agent, key, CHECK_BUDGET_SECONDS)
            n = announce_all(agent)
            more = "" if done else " (still counting; there may be more)"
            ctx = f'datastash: agent "{agent["name"]}" (workbook {agent["workbook_id"]}): {what(agent, n)}{more}.'
            if n:
                ctx += " Read them with the datastash-agent skill."
            set_flag(agent, "key_refused", None)
        except ApiError as e:
            if e.status in (401, 403):
                set_flag(agent, "key_refused", int(time.time()))
                ctx = (f'datastash: agent "{agent["name"]}": its key was refused (switched off, or a newer key was '
                       f'issued). See the datastash-agent skill.')
            else:
                ctx = f'datastash: agent "{agent["name"]}": inbox check failed (HTTP {e.status}); counts unknown.'
            log(s, f"check: HTTP {e.status} {e.body.get('error') or e.body.get('code') or ''}")
        except (urllib.error.URLError, OSError) as e:
            ctx = f'datastash: agent "{agent["name"]}": inbox check could not reach datastash; counts unknown.'
            log(s, f"check: network {type(e).__name__}")
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": ctx}}))
    return 0


def _session_pid():
    """The Claude Code process this hook belongs to: the nearest ancestor named claude, else the parent."""
    pid = os.getppid()
    first = pid
    for _ in range(8):
        if pid <= 1:
            break
        try:
            out = subprocess.run(["ps", "-o", "ppid=,comm=", "-p", str(pid)], capture_output=True, text=True, timeout=3).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            break
        if not out:
            break
        parts = out.split(None, 1)
        comm = parts[1] if len(parts) > 1 else ""
        if "claude" in os.path.basename(comm).lower():
            return pid
        try:
            pid = int(parts[0])
        except ValueError:
            break
    return first


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError as e:
        return e.errno == errno.EPERM


def _take_listener_lock(s, session_id):
    """Hold the per-agent listener lock for this process's life; None when another listener has it."""
    ensure_dirs()
    fd = os.open(lock_path(s), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    os.ftruncate(fd, 0)
    os.write(fd, json.dumps({"pid": os.getpid(), "session_id": session_id, "since": int(time.time())}).encode())
    return fd


def cmd_listen(_args, printer=None):
    """Background hook (async + asyncRewake). Long-polls the inbox; exit 2 wakes the session when new items arrive.
    With printer (the watch command), prints a line per arrival instead and keeps going."""
    inp = hook_input() if printer is None else {}
    agent = agent_for(project_of(inp))
    if agent is None:
        return 0
    s = agent["slug"]
    session_id = str(inp.get("session_id") or "")
    lock = _take_listener_lock(s, session_id)
    if lock is None:
        if printer is not None:
            printer(f'datastash: a listener for "{agent["name"]}" is already running here; no watch needed.')
        return 0  # one listener per agent: another one is running
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    parent = _session_pid() if printer is None else None
    started = time.time()
    backoff = BACKOFF_START
    # First catch up without waiting. At session start the SessionStart check reports what is already there, so the
    # catch-up wakes nobody; after a turn (Stop) anything that arrived during the turn wakes the session at once.
    catching_up = True
    quiet_catch_up = printer is None and inp.get("hook_event_name") == "SessionStart"
    log(s, f"listen: start session={session_id[:8]} parent={parent}")
    while True:
        if printer is None and time.time() - started > LISTEN_MAX_SECONDS:
            log(s, "listen: time limit reached; stops until the next turn")
            return 0
        if parent is not None and not _alive(parent):
            log(s, "listen: session gone; stops")
            return 0
        key = read_key(s)
        if key is None:
            log(s, "listen: no usable key file; stops")
            return 0
        cur = load_state(agent).get("cursor")
        try:
            items, nxt, more = fetch_page(agent, key, cur, 0 if catching_up else WAIT_SECONDS)
            backoff = BACKOFF_START
        except ApiError as e:
            code = e.body.get("error") or e.body.get("code") or ""
            if e.status == 410:
                log(s, "listen: cursor expired; starts over")
                reset_cursor(agent)
                continue
            if e.status in (401, 403):
                set_flag(agent, "key_refused", int(time.time()))
                log(s, f"listen: key refused (HTTP {e.status} {code}); stops")
                return 0
            if e.status == 404:
                log(s, f"listen: not found (HTTP 404 {code}); retry in {NOT_FOUND_BACKOFF}s")
                _sleep(NOT_FOUND_BACKOFF, parent)
                continue
            log(s, f"listen: HTTP {e.status} {code}; retry in {backoff}s")
            _sleep(backoff, parent)
            backoff = min(backoff * 2, BACKOFF_MAX)
            continue
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(s, f"listen: network {type(e).__name__}; retry in {backoff}s")
            _sleep(backoff, parent)
            backoff = min(backoff * 2, BACKOFF_MAX)
            continue
        applied, fresh = apply_page(agent, cur, items, nxt, more)
        if not applied or more:
            continue
        if catching_up:
            catching_up = False
            if quiet_catch_up:
                if fresh:
                    announce_all(agent)
                continue
        if fresh:
            n = announce_all(agent)
            msg = f'datastash: agent "{agent["name"]}" has {what(agent, n)} ({fresh} just arrived). Read them with the datastash-agent skill.'
            log(s, f"listen: wake, {fresh} arrived, {n} new")
            if printer is not None:
                printer(msg)
                continue
            print(msg, file=sys.stderr)
            sys.stderr.flush()
            return 2


def _sleep(seconds, parent):
    end = time.time() + seconds
    while time.time() < end:
        if parent is not None and not _alive(parent):
            return
        time.sleep(min(5, max(0.1, end - time.time())))


def cmd_end(_args):
    """SessionEnd: stop this session's listener."""
    inp = hook_input()
    agent = agent_for(project_of(inp))
    if agent is None:
        return 0
    info = read_json(lock_path(agent["slug"]), {})
    pid = info.get("pid")
    if isinstance(pid, int) and pid > 1 and info.get("session_id") == str(inp.get("session_id") or "") and _is_listener(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    return 0


def _is_listener(pid):
    try:
        out = subprocess.run(["ps", "-o", "args=", "-p", str(pid)], capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "datastash" in out and "listen" in out


# ------------------------------------------------------------------ user commands

def cmd_fetch(args):
    if len(args) != 2:
        die("usage: datastash fetch NAME PICKUP_CODE")
    name, code = args[0].strip(), args[1].strip()
    if not re.fullmatch(r"[A-Za-z0-9_\-]{6,200}", code):
        die("that does not look like a pickup code")
    s = slug(name)
    ensure_dirs()
    try:
        status, _ctype, text = http("POST", PICKUP_PATH, form={"code": code}, timeout=30)
    except ApiError as e:
        die(f"pickup refused (HTTP {e.status}): the code is unknown, used or expired. Ask for a new one (ledger_agent_key).")
    except (urllib.error.URLError, OSError) as e:
        die(f"could not reach datastash ({type(e).__name__}); the code was not used, try again")
    key = text.strip()
    if status != 200 or not re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", key):
        die("datastash answered something that is not an agent key; nothing saved")
    write_private(key_path(s), key + "\n")
    key = None
    c = read_json(conf_path(s), {})
    c["name"] = name
    write_private(conf_path(s), json.dumps(c, indent=2))
    print(f"saved the agent key for \"{name}\" to {key_path(s)} (mode 600). The key was not printed.")
    return 0


def cmd_link(args):
    if not args:
        die("usage: datastash link NAME --workbook WORKBOOK_ID [--agent-id ID] [--project DIR] [--watch-tab TAB]")
    name = args[0].strip()
    opts = {}
    it = iter(args[1:])
    for a in it:
        if a in ("--workbook", "--agent-id", "--project", "--watch-tab"):
            opts[a] = next(it, None)
        else:
            die(f"unknown option {a}")
    s = slug(name)
    ensure_dirs()
    c = read_json(conf_path(s), {})
    c["name"] = name
    if opts.get("--workbook"):
        c["workbook_id"] = opts["--workbook"]
    if not c.get("workbook_id"):
        die("send --workbook WORKBOOK_ID (the agent workbook's id)")
    if opts.get("--agent-id"):
        c["agent_id"] = opts["--agent-id"]
    if "--watch-tab" in opts:
        if opts["--watch-tab"]:
            c["watch_tab"] = opts["--watch-tab"]
        else:
            c.pop("watch_tab", None)
    proj = os.path.realpath(opts.get("--project") or os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    projects = [p for p in (c.get("projects") or []) if p != proj] + [proj]
    c["projects"] = projects
    write_private(conf_path(s), json.dumps(c, indent=2))
    print(f"linked \"{name}\" to {proj} (workbook {c['workbook_id']}). New sessions in this folder act as \"{name}\".")
    return 0


def cmd_status(_args):
    agents = all_agents()
    if not agents:
        print("no linked agents on this machine")
        return 0
    for a in agents:
        s = a["slug"]
        kp = key_path(s)
        try:
            mode = oct(os.stat(kp).st_mode & 0o777)
            keyinfo = f"key file {kp} ({mode})"
        except OSError:
            keyinfo = "no key file"
        st = load_state(a)
        info = read_json(lock_path(s), {})
        running = isinstance(info.get("pid"), int) and _alive(info["pid"]) and _is_listener(info["pid"])
        print(f'"{a["name"]}": workbook {a["workbook_id"]}; {keyinfo}; folders: {", ".join(a.get("projects") or []) or "none"}; '
              f'listener: {"running (pid " + str(info["pid"]) + ")" if running else "not running (it starts at session start and after each turn)"}; '
              f'new: {len(st["new"])}{"; KEY REFUSED" if st.get("key_refused") else ""}'
              f'{"; watching tab " + a["watch_tab"] if a.get("watch_tab") else ""}')
    return 0


def cmd_api(args):
    if len(args) < 2:
        die("usage: datastash api METHOD /api/v1/agent/... [JSON_BODY]")
    method, path = args[0].upper(), args[1]
    if method not in ("GET", "POST"):
        die("METHOD is GET or POST")
    if not path.startswith(API_PREFIX) or ".." in path or "#" in path:
        die(f"PATH must start with {API_PREFIX}")
    body = None
    if len(args) > 2:
        raw = sys.stdin.read() if args[2] == "-" else args[2]
        try:
            body = json.loads(raw)
        except ValueError:
            die("JSON_BODY is not valid JSON")
    agent = agent_for(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    if agent is None:
        die("no agent is linked to this folder (datastash link NAME --workbook ID, or set DATASTASH_AGENT)")
    key = read_key(agent["slug"])
    if key is None:
        die(f"no usable key file for \"{agent['name']}\" ({key_path(agent['slug'])})")
    try:
        status, _ctype, text = http(method, path, key=key, body=body, timeout=60)
        print(text)
        return 0
    except ApiError as e:
        print(json.dumps({"http_status": e.status, **e.body}))
        return 1
    except (urllib.error.URLError, OSError) as e:
        die(f"could not reach datastash ({type(e).__name__})")


def cmd_off(args):
    if len(args) != 1:
        die("usage: datastash off NAME")
    s = slug(args[0])
    ensure_dirs()
    os.makedirs(OFF, mode=0o700, exist_ok=True)
    moved = []
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for p in (key_path(s), conf_path(s)):
        if os.path.exists(p):
            os.replace(p, os.path.join(OFF, f"{os.path.basename(p)}.{stamp}"))
            moved.append(os.path.basename(p))
    info = read_json(lock_path(s), {})
    if isinstance(info.get("pid"), int) and _alive(info["pid"]) and _is_listener(info["pid"]):
        try:
            os.kill(info["pid"], signal.SIGTERM)
        except OSError:
            pass
    print(f"\"{args[0]}\" is off on this machine; moved {', '.join(moved) or 'nothing'} to {OFF}. "
          "To stop its key everywhere, switch it off in datastash (ledger_agent_switch_off).")
    return 0


def cmd_watch(_args):
    def out(line):
        print(line, flush=True)
    rc = cmd_listen([], printer=out)
    if rc == 0 and agent_for(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()) is None:
        die("no agent is linked to this folder")
    return rc


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    args = sys.argv[2:]
    table = {"fetch": cmd_fetch, "link": cmd_link, "status": cmd_status, "api": cmd_api, "off": cmd_off,
             "watch": cmd_watch, "check": cmd_check, "listen": cmd_listen, "end": cmd_end}
    if cmd not in table:
        print(__doc__)
        return 0 if cmd in ("help", "-h", "--help") else 1
    return table[cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
