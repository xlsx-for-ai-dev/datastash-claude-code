# Every file and keychain item the plugin ever writes, in one table. Per agent ({s}: its local slug, never a server
# name): exactly these. The box (when its last agent goes): these, every per-agent row, and the whole config folder.
AGENT_FILES = (
    "{c}/agent-{s}.key", "{c}/agent-{s}.json", "{c}/agent-{s}.proof", "{c}/agent-{s}.answer", "{st}/agent-{s}.json",
    "{st}/agent-{s}.listener.lock", "{st}/agent-{s}.state.lock", "{st}/agent-{s}.mint.lock", "{st}/agent-{s}.log",
    "{st}/agent-{s}.log.1",
    "{p}/agent-{s}.verifier", "{st}/status-sent-{s}.json", "{st}/status-written-{s}", "{st}/status-out-{s}.json",
    "{st}/status-snap-{s}.json", "{st}/status-reminded-{s}", "{st}/agent-{s}.chatkey")
# Plus each session's standby lock for the agent (XLI-374): {st}/agent-{s}.standby-<16 hex>.listener.lock (standby_path).
AGENT_STANDBY_RE = r"agent-{s}\.standby-[0-9a-f]{{16}}\.listener\.lock"
AGENT_KEYCHAIN = ("agent-answer-{s}",)
BOX_FILES = ("{m}/" + MAIN_MARKER,)  # outside the config folder: only the main folder's marker
BOX_KEYCHAIN = (KEYCHAIN_ACCOUNT, ANSWER_KEY_ACCOUNT)  # the older login's refresh token and answer key
BOX_DIRS = ("{c}",)  # the plugin's own folder, whole: every file README's table lists (login, state/, pending/, off/, ...)


def _fill(t, s=""):
    return t.format(c=CONF, st=STATE, p=PENDING, m=MAIN_DIR, s=s)


def _kc(op, account, value=None):
    """The OS keychain (macOS security, Linux secret-tool) under service datastash: put (True when it reads back), get
    (the value or None), drop. Values go on stdin only, never a command line."""
    mac, lin = sys.platform == "darwin" and shutil.which("security"), shutil.which("secret-tool")
    if op == "put":
        if mac:
            rc, _ = _run(["security", "-i"], f'add-generic-password -U -s {KEYCHAIN_SERVICE} -a {account} -w "{value}"\n')
        elif lin:
            rc, _ = _run(["secret-tool", "store", "--label=datastash", "service", KEYCHAIN_SERVICE, "account", account], value)
        else:
            return False
        return rc == 0 and _kc("get", account) == value
    if op == "get":
        rc, out = (_run(["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w"]) if mac else
                   _run(["secret-tool", "lookup", "service", KEYCHAIN_SERVICE, "account", account]) if lin else (1, ""))
        return (out or "").strip() if rc == 0 and (out or "").strip() else None
    if mac:
        _run(["security", "delete-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account])
    elif lin:
        _run(["secret-tool", "clear", "service", KEYCHAIN_SERVICE, "account", account])
    return None


def server_refused(body, failed=None):
    """ONE line for a refusal datastash answered: its code and its own message (made plain and short), or `failed`
    (else REFUSED_LINE) when the answer carries no readable code."""
    code = (body.get("code") or body.get("error")) if isinstance(body, dict) else None
    if not isinstance(code, str) or not re.fullmatch(r"[a-z0-9_]{1,48}", code):
        return failed or REFUSED_LINE
    msg = body.get("message") if isinstance(body.get("message"), str) else ""
    msg = re.sub(r"\s+", " ", "".join(ch for ch in msg if unicodedata.category(ch)[0] != "C")).strip()[:240]
    msg = re.sub(r"\s*Nothing changed\.?$", "", msg).rstrip(" .")
    return f"Not done: datastash refused it ({code}{': ' + msg if msg else ''}). Nothing changed."


def _session_agent_path(sid):
    return os.path.join(STATE, f"session-agent-{sid}.json")


def bind_session_agent(sid, s, agent_id):
    """XLI-390 install fix: the agent this session's own /datastash:install made, kept for the session (a folder that
    can't be linked, such as the home folder, has no other way to find it again)."""
    if sid and re.fullmatch(SID_RE, sid):
        write_private(_session_agent_path(sid), json.dumps({"slug": s, "agent_id": agent_id.lower(), "at": int(time.time())}))


def session_agent(inp):
    """This session's agent when the folder has none: the one its own install made (bound to the session id), else,
    ONLY in a folder the plugin can't link (home or "/"), the one agent on this computer with no folder of its own. In
    any other folder the one-agent fallback is never used here, so /datastash:install there registers that folder's own
    agent. Only an agent whose config, id and key are all on this computer; never in the person's main session or folder."""
    me, here = this_session(inp), project_of(inp)
    if not _fallback_allowed(here, me):
        return None
    sid = _sid(inp)
    rec = read_json(_session_agent_path(sid), None) if sid else None
    a = None
    if isinstance(rec, dict) and isinstance(rec.get("slug"), str) and re.fullmatch(r"[a-z0-9][a-z0-9\-]{0,63}", rec["slug"]):
        c = read_json(conf_path(rec["slug"]), None)
        if isinstance(c, dict) and c.get("name") and c.get("workbook_id") \
                and str(c.get("agent_id") or "").lower() == str(rec.get("agent_id") or "-").lower():
            a = dict(c, slug=rec["slug"])
    if a is None and _home_or_root(here):
        a = only_agent()
    return a if a is not None and isinstance(a.get("agent_id"), str) and re.fullmatch(GRANT_ID_RE, a["agent_id"].lower()) \
        and read_key(a["slug"]) else None


def _drop_standby_locks(s):
    """Uninstall: every session's standby lock for agent `s` (only names of the fixed standby_path form)."""
    try:
        names = os.listdir(STATE)
    except OSError:
        return
    pat = AGENT_STANDBY_RE.format(s=re.escape(s))
    for f in names:
        if re.fullmatch(pat, f):
            _drop(os.path.join(STATE, f))


def _drop_session_agents(s):
    """Uninstall: every state/session-agent-<sid>.json that names agent `s` (fixed file names; the slug read from each)."""
    try:
        names = os.listdir(STATE)
    except OSError:
        return
    for f in names:
        m = re.fullmatch(r"session-agent-(" + SID_RE + r")\.json", f)
        if m:
            rec = read_json(_session_agent_path(m.group(1)), None)
            if not isinstance(rec, dict) or rec.get("slug") == s:
                _drop(_session_agent_path(m.group(1)))


def _session_name(inp):
    """The name Claude Code gives this session's own agent (`claude --agent NAME`: the hook input's agent_type, never a
    subagent's), made plain as a folder name is; None when there is none."""
    if not isinstance(inp, dict) or inp.get("agent_id") is not None or not isinstance(inp.get("agent_type"), str):
        return None
    n = _folder_name(inp["agent_type"])
    return None if n == "agent" or n.lower() in ("general-purpose", "default") else n


def save_agent_answer(s, key):
    """The agent's answer key (for typed proofs): the keychain, else a mode-600 file. Never printed."""
    if _kc("put", f"agent-answer-{s}", key):
        _drop(_fill("{c}/agent-{s}.answer", s))
        return "keychain"
    write_private(_fill("{c}/agent-{s}.answer", s), key + "\n")
    return "file"


def read_agent_answer(s):
    got = _kc("get", f"agent-answer-{s}") if read_json(conf_path(s), {}).get("answer_store") == "keychain" else \
        _read_key_file(_fill("{c}/agent-{s}.answer", s), AGENT_ANSWER_RE, s)
    return got if isinstance(got, str) and re.fullmatch(AGENT_ANSWER_RE, got) else None


def _stop_listener(s):
    """Stop the listener that holds this agent's lock (any session), checked as stop_session_listeners does."""
    p = lock_path(s)
    info = read_json(p, {})
    pid = info.get("pid")
    if isinstance(pid, int) and not isinstance(pid, bool) and pid > 1 and pid != os.getpid() and _lock_held(p) \
            and (info.get("start") is None or _proc_start(pid) == info.get("start")) and _is_listener(pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass


def remove_agent_here(s):
    """Uninstall one agent on this computer: stop its listener, drop its keychain items and every fixed path of the
    table (plus its folders' maps and waiting records); the whole box when it was the last agent. True when the box
    went too. Only local fixed paths: nothing the server says picks a path."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9\-]{0,63}", s or ""):
        return False
    c = read_json(conf_path(s), {})
    _REMOVED_HERE.add(s)
    _stop_listener(s)
    for a in AGENT_KEYCHAIN:
        _kc("drop", _fill(a, s))
    for folder in c.get("projects") or []:
        if isinstance(folder, str):
            _drop(map_local_path(folder))
            try:
                _set_enrolled(folder, None)
            except OSError:
                pass
    clear_notices(notice_causes({"slug": s}))
    for t in AGENT_FILES:
        _drop(_fill(t, s))
    _drop_standby_locks(s)
    _drop_session_agents(s)
    left = [a for a in all_agents() if not is_person(a)]
    wb = c.get("workbook_id")
    if isinstance(wb, str) and wb and not any(a.get("workbook_id") == wb for a in left):
        _drop(status_cache_path(wb))  # its workbook's status copy, once no agent here uses that workbook
        _drop(os.path.join(STATE, f"agent-status-{_wb_tag(wb)}.state.lock"))
    if left:
        return False
    remove_box()
    return True


def _gone_path():
    """The uninstall's tombstone: outside the plugin's folder (that folder is gone), in this user's temp folder, one
    small file with only a time in it; it lapses after GONE_SECONDS, and the next /datastash:install drops it."""
    return os.path.join(tempfile.gettempdir(), f"datastash-removed-{os.getuid()}-{hashlib.sha256(CONF.encode()).hexdigest()[:12]}")


GONE_SECONDS = 3600


def box_gone():
    """True while a fresh uninstall tombstone stands and the plugin's folder is not there: the hooks of the uninstall's
    own turn (and any later hook within the hour) make nothing in it."""
    if os.path.isdir(CONF):
        return False
    try:
        st = os.lstat(_gone_path())
    except OSError:
        return False
    return stat.S_ISREG(st.st_mode) and st.st_uid == os.getuid() and time.time() - st.st_mtime < GONE_SECONDS


def _mark_gone(on):
    try:
        if on:
            fd = os.open(_gone_path(), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, "O_NOFOLLOW", 0), 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(str(int(time.time())) + "\n")
        else:
            _drop(_gone_path())
    except OSError:
        pass


def remove_box():
    """The last agent went: every box row of the table, the keychain items and the plugin's own folder."""
    for a in BOX_KEYCHAIN:
        _kc("drop", a)
    for t in BOX_FILES:
        _drop(_fill(t))
    for t in BOX_DIRS:
        d = _fill(t)
        home = os.path.realpath(HOME)
        if os.path.isdir(d) and not os.path.islink(d) and os.path.realpath(d) not in (home, "/") \
                and (os.path.basename(d) == "datastash" or os.environ.get("DATASTASH_CONFIG_DIR") == d):
            shutil.rmtree(d, ignore_errors=True)
    _mark_gone(True)


def _shown_full(v):
    """show_name without the 64-character cut ("" when nothing is left)."""
    v = "".join(ch for ch in str(v) if unicodedata.category(ch)[0] != "C" and ch not in "‎‏‪‫‬"
                "‭‮⁦⁧⁨⁩")
    return re.sub(r"\s+", " ", v).strip()


def show_name(v):
    """An agent name as the person sees it: no control or bidi characters, at most 64 characters (EPM MUST 2)."""
    return _shown_full(v)[:64] or "?"


_LOOKALIKE = str.maketrans("01i|53", "olllse")


def fold_name(v):
    """Names that differ only by case, spaces, dashes or look-alike letters fold the same (EPM MUST 2)."""
    v = unicodedata.normalize("NFKD", unicodedata.normalize("NFKC", show_name(v)).casefold())
    v = "".join(ch for ch in v if not unicodedata.combining(ch)).replace("rn", "m").translate(_LOOKALIKE)
    return re.sub(r"[\s_\-.]+", "", v)


def norm_list(body):
    """{list_id, agents: [{id, name, shut}]} from a ledger_agents_list answer (X2: {list_id, agents: [{agent_id, name,
    visibility "public" | "private"}]}), or None. Anything but "public" shows as private (fail closed)."""
    if not isinstance(body, dict) or not isinstance(body.get("list_id"), str) or not re.fullmatch(GRANT_ID_RE, body["list_id"].lower()):
        return None
    out = []
    for a in body.get("agents") if isinstance(body.get("agents"), list) else []:
        if isinstance(a, dict) and isinstance(a.get("agent_id"), str) and re.fullmatch(GRANT_ID_RE, a["agent_id"].lower()):
            out.append({"id": a["agent_id"].lower(), "name": show_name(a.get("name")), "shut": a.get("visibility") != "public",
                        "plain": plain_name(a.get("name"))})  # 1.0.11 final: the STORED name matches the strict rule
    return {"list_id": body["list_id"].lower(), "agents": out[:500]}


def list_lines(lst, head):
    return [head] + [f"- {a['name']} ({'private' if a['shut'] else 'public'})" for a in lst["agents"]]


_PICK_TOKEN_RE = re.compile(r'"([^"]*)"|“([^”"]*)”|([^\s,"“”]+)|(["“”])')
_RESERVED = ("all", "this")


def pick_tokens(text, keep_and=False):
    """The typed names as ([(token, quoted)], error | None). Tokens are split at whitespace, commas and the word "and";
    a double-quoted piece is one token (1.0.11 final: one with a space is never a plain name). Tokens are never joined
    into a longer name. keep_and: a bare "and" is kept as a token too (pick_check tells it from a name)."""
    out, err = [], None
    for m in _PICK_TOKEN_RE.finditer(text or ""):
        q, cq, word, stray = m.groups()
        if stray is not None:
            err = err or "quote"
        elif word is not None:
            if keep_and or word.casefold() != "and":
                out.append((word, False))
        else:
            out.append((q if q is not None else cq, True))
    return out, err


# Letters that show as blank but are not spaces or format characters (Hangul fillers, the blank braille cell).
_BLANK_LETTERS = "\u115f\u1160\u3164\uffa0\u2800"


def _listed_plain(a):
    """True when a listed agent's stored name is a plain name: the whole name matches PLAIN_NAME_RE (a-z, 0-9, "-", "_",
    ".", ignoring case). Anything else ("all,", "all and", "a b", "x;y", a look-alike) is an old-style name, never
    picked by name. An older saved list has no "plain": its shown name decides."""
    return a["plain"] if isinstance(a.get("plain"), bool) else plain_name(a["name"])


def _shape(v):
    """A name's shape for telling whether typed ASCII may stand for it: case, width, marks, spaces, "-", "_", ".",
    invisible and blank characters dropped, look-alike digits folded; every other character that is not ASCII is a
    wildcard (None) standing for any one letter."""
    v = unicodedata.normalize("NFKD", unicodedata.normalize("NFKC", str(v)).casefold())
    out = []
    for ch in v:
        if unicodedata.category(ch)[0] in "CMZ" or ch.isspace() or ch in "-_." or ch in _BLANK_LETTERS:
            continue
        out.append(ch.translate(_LOOKALIKE) if ch.isascii() else None)
    return out


def _shape_hit(tok_shape, shape):
    return len(tok_shape) == len(shape) and all(s is None or s == t for t, s in zip(tok_shape, shape))


def _subseq(part, word):
    it = iter(word)
    return all(ch in it for ch in part)


def _reads_as_words(shape):
    """The pick words a name that is not plain ASCII may read as: every word when it is at most 4 letters long once
    invisible ones are dropped (one odd letter can look like two: "aǁ"), else each of "all", "this", "and" its ASCII
    letters all fit inside, in order ("Ꭺll", "ᴛhis", "ᴀʟʟ"; a name with no ASCII letter at all fits every word)."""
    part = "".join(ch for ch in shape if ch is not None)
    return set(PICK_WORDS) if len(shape) <= 4 else {w for w in PICK_WORDS if _subseq(part, w)}


def _old_words(name):
    """The pick words an old-style listed name (as shown) may read as: for a name with a character that is not ASCII,
    by its shape (_reads_as_words); for a plain-ASCII one ("all,", "all and", "this,", "a n d", "this?") the word it
    reads as itself, as each token the parser would split it into, or with every character but a-z and 0-9 dropped
    (1.0.11 stored-name LOW 1: "all!", "(all)", "t,his"). "all" is in the set, but it never blocks: "all" alone always
    asks the person to confirm the whole list (see pick_check)."""
    if not name.isascii():
        return _reads_as_words(_shape(name))
    got = {pick_word_like(name), pick_word_like(re.sub(r"[^a-z0-9]", "", name.casefold()))}
    got |= {pick_word_like(t) for t, _ in pick_tokens(name, keep_and=True)[0]}
    return got - {None}


def _old_typed(text, lst):
    """The listed agents with an old-style name (one with a letter or digit) that the typed text holds as it is shown,
    ignoring case and runs of spaces, at token edges: "all," typed with "all," listed ("a b" is not held by "alpha
    beta"). Such a pick is refused whole ("old")."""
    t = _shown_full(text or "").casefold()
    return [a for a in lst["agents"] if not _listed_plain(a) and re.search(r"[A-Za-z0-9]", a["name"])
            and re.search(_old_edge(a["name"]), t)]


_PICK_SEP = '\\s,"“”'


def _old_edge(name):
    """The pattern finding a shown name in typed text, casefolded, starting and ending at a separator or the text's edge
    (an edge that is itself a separator, as in "all,", needs none)."""
    n = name.casefold()
    pre = "" if n[:1] in ' ,"“”' else f"(?<![^{_PICK_SEP}])"
    post = "" if n[-1:] in ' ,"“”' else f"(?![^{_PICK_SEP}])"
    return pre + re.escape(n) + post


def _pick_index(lst):
    """(listed plain names by casefold, how many listed names share each fold, [(pick word, agent)] for every listed
    agent named like a pick word, [(shape, agent, may read as a pick word)] for every listed agent whose stored name is
    not plain ASCII): built once per pick. An agent whose name is not plain ASCII is never picked by name, and while one
    that may read as "this" or "and" is listed ("ᴛhis", "this,", "a n d", _old_words) that word is refused too."""
    low, folds, kept, odd = {}, {}, [], []
    for a in lst["agents"]:
        f = fold_name(a["name"])
        folds[f] = folds.get(f, 0) + 1
        if not _listed_plain(a):
            odd.append((_shape(a["name"]), a, _old_words(a["name"])))
            continue
        low.setdefault(a["name"].casefold(), []).append(a)
        w = pick_word_like(a["name"])
        if w:
            kept.append((w, a))
    return low, folds, kept, odd


def _pick_match(tok, quoted, idx):
    """("reserved" | "kept" | "skip" | "one" | "two" | "unknown", ids) for one token. A pick word is never a name: a
    token that reads as one is "kept" when a listed agent is named like that word (ambiguous: refused), else the word
    itself unquoted ("reserved"; a bare "and" is a separator, "skip"), else "unknown". Otherwise the token must equal
    exactly one listed name, ignoring case, with no other listed name that differs from it only by case, spaces,
    dashes or look-alike letters; in double quotes, a name typed character for character as exactly one listed name
    picks it even then. 1.0.11 final: a token that is not plain ASCII is "ascii" (refused); "this" or "and" while an
    agent with an old-style name that may read as that word is listed is "odd-word"; a token that may stand for the name of an
    agent whose name is not plain ASCII is "odd" (same length, each odd letter standing for any one letter)."""
    low, folds, kept, odd = idx
    if not ascii_text(tok):
        return "ascii", []
    w = pick_word_like(tok)
    if w is not None:
        if any(k == w for k, _ in kept):
            return "kept", []
        # 1.0.11 stored-name HIGH (PM ruling): "this" and a bare "and" are refused only while an old-style listed
        # name may read as that very word; "all" is never blocked by one (alone it asks to confirm the whole list)
        if w != "all" and any(w in r for _, _, r in odd):
            return "odd-word", []
        if not quoted and tok.casefold() == "and":
            return "skip", []
        if not quoted and tok.casefold() in _RESERVED:
            return "reserved", []
        return "unknown", []
    if not plain_name(tok):  # 1.0.11 final: a typed name matches the same strict rule as a stored one
        return "notplain", []
    full = _shown_full(tok)
    if not full or len(full) > 64:  # cycle 2 LOW 1: never a match on the first 64 characters of a longer token
        return "unknown", []
    ts = _shape(full)
    if any(_shape_hit(ts, sh) for sh, _, _ in odd):
        return "odd", []
    same = low.get(full.casefold(), [])
    if not same:
        return "unknown", []
    if len(same) == 1 and folds.get(fold_name(full), 0) <= 1:
        return "one", [same[0]["id"]]
    exact = [a for a in same if a["name"] == full]
    return ("one", [exact[0]["id"]]) if quoted and len(exact) == 1 else ("two", [])


def pick_check(text, lst, own, reserved=True):
    """The one strict parser for every command that takes agent names (uninstall, make <names> private/public).
    (picked ids | "none" | None, the token that failed or None, why). "none" when no token names anything (the prompt is
    something else, and the failing token, if any, is still given); None refuses the whole command, changing nothing:
    typed text holding a listed old-style name as shown ("old": a stored name that is not a plain name, "all,", "a b"),
    a token that is not plain ASCII ("ascii"), not a plain name ("notplain"), unknown ("unknown") or matching two agents
    ("two"), a pick word while a listed agent is named like it ("kept") or one with an old-style name may read as it
    ("odd-word"), a token that may stand for such an agent ("odd"), "all"/"this" next to any other token ("mixed") or
    where they are not names ("reserved", when reserved is False), an unclosed quote ("quote"), more than 100 names
    ("many"). 1.0.11 stored-name HIGH (PM ruling): "all" typed alone (uninstall only) is never refused and never
    removes anything by itself: it is "confirm" (with every listed agent; why "all"), and the plugin asks the person to
    type "remove all N" (all_confirm_lines)."""
    toks, err = pick_tokens(text, keep_and=True)
    if reserved and not err and (text or "").strip().casefold() == "all":
        return ("confirm", None, "all") if lst["agents"] else (None, toks[0][0], "unknown")
    old = _old_typed(text, lst)
    if old:  # 1.0.11 final (PM ruling): an old-style name typed as listed is refused, whatever its tokens read as
        return None, old[0]["name"], "old"
    if reserved and any(not q and t.casefold() == "all" for t, q in toks):
        # 1.0.11 confirm review HIGH (PM ruling): typed "all" anywhere must be the whole input, "all" alone; with any
        # other token or stray separator ("all and", "and all", "all,", ", all", "all all") the command is refused
        return None, next(t for t, q in toks if not q and t.casefold() == "all"), "mixed"
    idx = _pick_index(lst)
    seen = [(t, q, *_pick_match(t, q, idx)) for t, q in toks]
    seen = [x for x in seen if x[2] != "skip"]
    hits = sum(1 for _, _, k, _ in seen if k in ("one", "two", "kept", "ascii", "odd", "odd-word")
               or (reserved and k == "reserved"))
    first_bad = next(((t, k) for t, _, k, _ in seen if k in ("unknown", "two", "notplain")), (None, "unknown"))
    if hits == 0:
        return "none", *first_bad
    if len(seen) > 100:  # cycle 2 LOW 2: after "names nothing", so a long ordinary prompt passes through
        return None, None, "many"
    if err:
        return None, '"', "quote"
    for why in ("ascii", "kept", "odd-word", "odd"):
        bad = next((t for t, _, k, _ in seen if k == why), None)
        if bad is not None:
            return None, bad, why
    res = [t for t, _, k, _ in seen if k == "reserved"]
    if res:
        if not reserved:
            return None, res[0], "reserved"
        if len(seen) > 1:
            return None, res[0], "mixed"
        # 1.0.11 confirm review HIGH (PM ruling): only a typed "this" alone picks this session's agent; never a fallback
        if res[0].casefold() == "this" and own:
            return [own], None, None
        return None, res[0], "unknown"
    if first_bad[0] is not None:
        return None, *first_bad
    picked = []
    for _, _, _, ids in seen:
        picked += [i for i in ids if i not in picked]
    return picked, None, None


def resolve_picks(text, lst, own, reserved=True):
    """The agent ids the person's typed names pick; "none" when no token names anything (the prompt is something
    else); "confirm" for "all" alone (nothing is picked until the person types "remove all N"); None when the whole
    command is refused (pick_check)."""
    return pick_check(text, lst, own, reserved)[0]


def all_confirm(lst):
    """The confirm step "all" opens: every listed agent's id and their count, bound to this list."""
    return {"n": len(lst["agents"]), "ids": [a["id"] for a in lst["agents"]], "list_id": lst["list_id"]}


def all_confirm_lines(lst):
    """The person's lines for "all": every listed agent by its shown name (old-style names too), then the one reply that
    goes ahead."""
    n = len(lst["agents"])
    return "\n".join(list_lines(lst, ALL_HEAD.format(n=n, s="" if n == 1 else "s")) + [ALL_CONFIRM_LINE.format(n=n)])


def all_confirmed(prompt, rec):
    """True when the person's reply is exactly "remove all N" for the confirm step open in rec, and the step still
    matches its list (same list id, the same agents, the count shown). Case and runs of spaces are ignored."""
    c, lst = rec.get("confirm"), rec.get("list")
    if not isinstance(c, dict) or not isinstance(lst, dict) or not isinstance(prompt, str):
        return False
    ids = [a["id"] for a in lst["agents"]]
    return (c.get("list_id") == lst["list_id"] and c.get("ids") == ids and c.get("n") == len(ids) and len(ids) > 0
            and " ".join(prompt.split()).casefold() == ALL_CONFIRM_TEXT.format(n=len(ids)))


def pick_refused_why(text, lst, own, reserved=True):
    """Why a pick was refused, naming the failing token and the listed names closest to it, or None."""
    _, tok, why = pick_check(text, lst, own, reserved)
    if why == "many":
        return "more than 100 names were typed"
    if why == "quote":
        return "a quote is not closed"
    if tok is None:
        return None
    t, names = show_name(tok) + ("..." if len(_shown_full(tok)) > 64 else ""), [a["name"] for a in lst["agents"]]
    q = lambda ns: ", ".join(chr(34) + n + chr(34) for n in ns)  # noqa: E731
    if why == "ascii":
        return (f'"{t}" has a character that is not plain ASCII (an accent, a look-alike or invisible letter); type '
                "names with plain letters a-z, digits, \"-\", \"_\" and \".\" only")
    if why == "kept":
        w = pick_word_like(tok)
        kept = [a["name"] for k, a in _pick_index(lst)[2] if k == w]
        return (f'"{t}" is a word this command keeps, never a name, and your agent {q(kept)} is named like it, so '
                "that agent can't be picked by name")
    if why in ("odd", "odd-word", "old"):
        odd = _pick_index(lst)[3]
        ts, w = _shape(_shown_full(tok)), pick_word_like(tok)
        if why == "old":
            who = [a["name"] for a in _old_typed(text, lst)]
        else:
            who = [a["name"] for sh, a, r in odd if (w in r if why == "odd-word" else _shape_hit(ts, sh))]
        names_ = f"{q(who[:3])}{' and others' if len(who) > 3 else ''}"
        head = {"odd-word": f'"{t}" is a word this command keeps, and your agent {names_} has an old-style name that '
                            f'may read as it, so "{t}" is refused while that agent is on the list',
                "odd": f'"{t}" may stand for your agent {names_}, which has an old-style name, so "{t}" is refused while '
                       "that agent is on the list",
                "old": f"your agent {names_} can't be picked by name"}[why]
        return head
    if why == "notplain":
        return (f'"{t}" is not a plain name: type names with plain letters a-z, digits, "-", "_" and "." only, as the '
                "list shows them")
    if why == "mixed":
        return f'"{t}" must be typed alone, never with other names'
    if why == "reserved":
        return f'"{t}" is not a name here; type the names exactly as the list shows them'
    if why == "two":
        close = [n for n in names if fold_name(n) == fold_name(tok)]
        head = f'"{t}" matches more than one agent'
        tail = "; type one in double quotes exactly as the list shows it"
        return head + (f" (closest exact names: {', '.join(chr(34) + n + chr(34) for n in close)})" if close else "") + tail
    low = {n.casefold(): n for n in names}
    close = [low[c] for c in difflib.get_close_matches(t.casefold(), list(low), n=3, cutoff=0.5)]
    head = f'"{t}" is not on the list'
    return head + (f" (closest exact names: {', '.join(chr(34) + n + chr(34) for n in close)})" if close else "")


def _way_out(text, lst, own, reserved):
    """True when the refusal is about an agent that can't be picked by name (an old-style name, or one named like a
    pick word): its line ends with OLD_STYLE_LINE, the one way out (1.0.11 stored-name HIGH; no web page)."""
    return pick_check(text, lst, own, reserved)[2] in ("old", "odd", "odd-word", "kept")


def pick_refused_line(text, lst, own):
    """The one line for a refused uninstall pick: which name failed, and the listed names closest to it."""
    why = pick_refused_why(text, lst, own)
    if why and _way_out(text, lst, own, True):
        return PICK_OLD_LINE.format(why=why)
    return PICK_REFUSED_LINE.format(why=why) if why else PICK_UNKNOWN_LINE


def vis_refused_line(text, lst):
    """The one line for a refused make <names> private/public: which name failed. Nothing was changed."""
    why = pick_refused_why(text, lst, None, reserved=False)
    if why and _way_out(text, lst, None, False):
        return VIS_OLD_LINE.format(why=why)
    return VIS_REFUSED_LINE.format(why=why) if why else VIS_PICK_LINE


def _cmd_path(sid):
    return os.path.join(STATE, f"command-{sid}.json")


def load_cmd(sid):
    rec = read_json(_cmd_path(sid), None) if sid else None
    at = rec.get("at") if rec else None
    return rec if isinstance(at, (int, float)) and time.time() - at <= CMD_MAX_AGE else None


def save_cmd(sid, rec):
    ensure_dirs()
    write_private(_cmd_path(sid), json.dumps(rec))


def _own(inp):
    """This session's agent with its key: the folder's, else the session's own (session_agent)."""
    a = agent_for(project_of(inp), me=this_session(inp))
    a = a if a is not None and isinstance(a.get("agent_id"), str) and read_key(a["slug"]) else None
    return a if a is not None else session_agent(inp)


def command_prompt(inp):
    """UserPromptSubmit: (line for the person or None, AI context or None, block) for the install or uninstall command,
    or for the person's pick after the uninstall list; None for any other prompt."""
    shape, prompt = hook_shape(inp), inp.get("prompt") if isinstance(inp, dict) else None
    if shape is None or not isinstance(prompt, str) or len(prompt) > 4000:
        return None
    sid, tp, pid = shape
    base = {"sid": sid, "tp": tp, "pid": pid, "prompt": prompt, "at": time.time()}
    m = UNINSTALL_RE.fullmatch(prompt)
    if INSTALL_RE.fullmatch(prompt):
        _mark_gone(False)  # the person's own install: the plugin may set itself up here again
        me, here = this_session(inp), project_of(inp)
        try:
            kind, name = auto_name(here, me, session_name=_session_name(inp))
        except SystemExit:
            return INSTALL_FAILED_LINE, None, True
        if kind == "main":
            return MAIN_HERE_LINE, None, True
        own = _own(inp)
        if own is not None and read_agent_answer(own["slug"]):
            name = own["name"]  # XLI-390 install fix: this session's agent again, never a new "-2"
        save_cmd(sid, dict(base, kind="install", name=name, here=here))
        steps = "" if own is not None and read_agent_answer(own["slug"]) else INSTALL_KEY_STEPS.format(name=name)
        return None, INSTALL_AI.format(steps=steps), False
    if m:
        save_cmd(sid, dict(base, kind="uninstall", picks=m.group(1) or ""))
        return None, UNINSTALL_LIST_AI, False
    v = VISIBILITY_RE.fullmatch(prompt)
    if v and _own(inp) is not None:
        toks, _ = pick_tokens(v.group(1))  # "make this private" alone stays an ordinary prompt; mixed is refused later
        if toks and not (len(toks) == 1 and not toks[0][1] and toks[0][0].casefold() in _RESERVED):
            kind = v.group(2).lower()
            save_cmd(sid, dict(base, kind=kind, picks=v.group(1)))
            return None, VIS_AI.format(kind=kind), False
    rec = load_cmd(sid)
    if rec and rec.get("kind") == "uninstall" and rec.get("confirm") is not None:
        # 1.0.11 stored-name HIGH: the step "all" opened. Only "remove all N" goes ahead (signed later as the person's
        # own typed prompt, like any pick); any other reply closes the step and removes nothing. No name parsing here.
        if not all_confirmed(prompt, rec):
            _drop(_cmd_path(sid))
            return ALL_NOT_CONFIRMED_LINE, None, True
        save_cmd(sid, dict(rec, **base, targets=list(rec["confirm"]["ids"]), confirm=None))
        return None, UNINSTALL_NOTE_AI.format(list=""), False
    if not rec or rec.get("kind") != "uninstall" or rec.get("picks") or not isinstance(rec.get("list"), dict):
        return None
    own = _own(inp)
    got = resolve_picks(prompt, rec["list"], own["agent_id"].lower() if own else None)
    if got == "none":
        _drop(_cmd_path(sid))
        return None
    if got == "confirm":  # "all" alone: show every agent, remove nothing yet
        save_cmd(sid, dict(rec, at=time.time(), confirm=all_confirm(rec["list"])))
        return all_confirm_lines(rec["list"]), None, True
    if got is None:
        return pick_refused_line(prompt, rec["list"], own["agent_id"].lower() if own else None), None, True
    save_cmd(sid, dict(rec, **base, targets=got))
    return None, UNINSTALL_NOTE_AI.format(list=""), False


def tool_answer(resp):
    """The one JSON object a connector answer carries (one text block, or the object itself), else None."""
    if isinstance(resp, dict) and not ({"content", "type", "text"} & set(resp)):
        return resp
    texts = [t for t in _strings(resp, []) if t != "text"]
    try:
        body = json.loads(texts[0]) if len(texts) == 1 else None
    except ValueError:
        return None
    return body if isinstance(body, dict) else None


def _command_origin(v):
    """A plugin slash command's entry as Claude Code writes it when the person types it in an interactive session:
    origin.kind "human", no promptSource (Claude Code marks typed text "typed" and these not at all), entrypoint "cli"
    (never sdk-cli or any other headless run), not meta, not a side chain. Anything else fails closed."""
    o = v.get("origin")
    return (isinstance(o, dict) and o.get("kind") == "human" and "promptSource" not in v and v.get("entrypoint") == "cli"
            and v.get("turnOrigin", "human") == "human" and not v.get("isMeta") and v.get("isSidechain") is False)


def _typed_entry(rec):
    """The person's own typed entry for the command's prompt (its slash-command form too), or "not person", or None."""
    want = rec["prompt"].strip()
    deadline = time.time() + 3
    while True:
        for v in reversed(_jsonl_tail(rec["tp"], 1024 * 1024) if _transcript_ok(rec["tp"], rec["sid"]) else []):
            t = _typed_text(v)
            if t is None or v.get("promptId") != rec["pid"]:
                continue
            tag = CMD_TAG_RE.fullmatch(t)
            if tag:
                if tag.group(1) != tag.group(2):
                    return None
                t = f"/{tag.group(2)} {(tag.group(3) or '').strip()}".strip()
                if " ".join(t.split()) != " ".join(want.split()):
                    return None
                return v if _command_origin(v) else "not person"
            if t.strip() != want:
                return None
            return v if _person_origin(v) else "not person"
        if time.time() > deadline:
            return None
        time.sleep(0.2)


def note_proof(key, signer, list_id, kind, targets, prompt_id, typed_text, typed_at, iat):
    """The typed proof of an agents note, exactly as X2 checks it (src/agents/agent-notes.ts proofInput): HMAC-SHA256
    with the agent's answer key over 9 lines (the label, signer, list id, kind, the sorted target ids, prompt id, sha256
    of the typed text, typed_at, iat in ms; ids lowercased). The proof is exactly {v, agent_id, prompt_id, typed_sha256,
    typed_at, iat, mac}: the server refuses any other field."""
    typed_sha = hashlib.sha256(typed_text.encode("utf-8", "surrogatepass")).hexdigest()
    lines = [NOTE_PROOF_LABEL, signer.lower(), list_id.lower(), kind, ",".join(sorted(t.lower() for t in targets)),
             prompt_id, typed_sha, str(typed_at), str(iat)]
    mac = hmac.new(key.encode(), "\n".join(lines).encode(), hashlib.sha256).hexdigest()
    return {"v": 1, "agent_id": signer.lower(), "prompt_id": prompt_id, "typed_sha256": typed_sha, "typed_at": typed_at,
            "iat": iat, "mac": mac}


def _deny(line):
    return {"systemMessage": line, "hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                                          "permissionDecisionReason": f"{CMD_NOTE}: {line}"}}


def _post(line=None, ai=None, event="PostToolUse"):
    out = {"hookSpecificOutput": {"hookEventName": event, **({"additionalContext": ai} if ai else {})}}
    return dict(out, systemMessage=line) if line else out


def note_input(inp, rec):
    """PreToolUse of ledger_agents_note: the call's whole input, written by the plugin (kind, list id, target ids and the
    typed proof), or a deny with its fixed line. Only for the person's own typed command, once, while fresh."""
    targets, lst, own = rec.get("targets"), rec.get("list"), _own(inp)
    if not isinstance(targets, list) or not targets or not isinstance(lst, dict):
        return _deny(NO_STEP_LINE)
    if own is None:
        return _deny(NO_OWN_AGENT_LINE)
    used = read_json(_typed_used_path(rec["sid"]), {}).get("ids")
    used = used if isinstance(used, list) else []
    if rec["pid"] in used:
        return _deny(USED_LINE)
    entry = _typed_entry(rec)
    if not isinstance(entry, dict):
        return _deny(NOT_PERSON_LINE if entry == "not person" else NOT_TYPED_LINE)
    typed_at = _when(entry.get("timestamp"))
    write_private(_typed_used_path(rec["sid"]), json.dumps({"ids": (used + [rec["pid"]])[-50:]}))
    mine = own["agent_id"].lower()
    if rec["kind"] == "uninstall" and targets == [mine]:
        return _deny(uninstall_self(own))  # an agent may always end itself, on its own key (no proof needed)
    key = read_agent_answer(own["slug"])
    if key is None or typed_at is None:
        return _deny(NO_ANSWER_KEY_LINE)
    targets = sorted(t.lower() for t in targets)
    proof = note_proof(key, mine, lst["list_id"], rec["kind"], targets, rec["pid"], rec["prompt"],
                       int(typed_at * 1000), int(time.time() * 1000))
    key = None
    # Exactly the note tool's fields (additionalProperties false): the signer rides in the proof, never as agent_id.
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "updatedInput": {
        "kind": rec["kind"], "list_id": lst["list_id"], "targets": targets, "typed_proof": proof}}}


def uninstall_self(own, run_id=None):
    """This agent only: POST uninstall on its own key (X2 {run_id?}: the uninstall run it signed, where it goes last;
    braked server-side), then the local cleanup."""
    try:
        api_json("POST", UNINSTALL_SELF_PATH, read_key(own["slug"]), body={"run_id": run_id} if run_id else {}, timeout=20)
    except ApiError as e:
        if e.status == 429:
            return BRAKED_LINE
        if e.status not in (401, 410):
            return REFUSED_LINE
    except (urllib.error.URLError, httpclient.HTTPException, OSError, ValueError):
        return REFUSED_LINE
    remove_agent_here(own["slug"])
    return " ".join([OFF_LINE.format(names=f'"{show_name(own["name"])}"'), CONNECTOR_SAME_LINE])


def collect_key(verifier, mint_id):
    """X1's collect: the key and answer key a connector mint holds for this verifier, once. The answer or None."""
    try:
        body = api_json("POST", COLLECT_PATH, None, body={"verifier": verifier, "mint_id": mint_id}, timeout=20)
    except (ApiError, urllib.error.URLError, httpclient.HTTPException, OSError, ValueError):
        return None
    ok = isinstance(body, dict) and isinstance(body.get("key"), str) and re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", body["key"]) \
        and isinstance(body.get("answer_key"), str) and re.fullmatch(AGENT_ANSWER_RE, body["answer_key"]) \
        and isinstance(body.get("agent_id"), str) and re.fullmatch(GRANT_ID_RE, body["agent_id"].lower())
    return body if ok else None


def collect_after_mint(inp, rec, body):
    """PostToolUse of ledger_agent_key that answered collect: ready: collect with this machine's verifier, save the key
    (mode 600) and answer key (keychain or mode 600), link this folder. The person's fixed line, or None."""
    name = (inp.get("tool_input") or {}).get("name")
    mint = body.get("mint_id")
    if body.get("collect") != "ready" or not isinstance(name, str) or not isinstance(mint, str) or not re.fullmatch(GRANT_ID_RE, mint.lower()):
        return None
    s = slug(name)
    v = read_verifier(f"agent-{s}")
    got = collect_key(v, mint) if v else None
    _drop(verifier_path(f"agent-{s}"))
    v = None
    wb = (got or {}).get("workbook_id") or (rec or {}).get("workbook_id")
    if got is None or not isinstance(wb, str) or not re.fullmatch(AGENT_ID_RE, wb):
        return INSTALL_FAILED_LINE
    here = (rec or {}).get("here") or project_of(inp)
    save_agent(name, got["agent_id"].lower(), got["key"], wb, here)
    c = read_json(conf_path(s), {})
    c["answer_store"] = save_agent_answer(s, got["answer_key"])
    write_private(conf_path(s), json.dumps(c, indent=2))
    bind_session_agent(_sid(inp), s, got["agent_id"])  # XLI-390 install fix: found again in a folder it can't link
    got = None
    return MINT_LINE.format(name=show_name(name))


def _note_ok(note):
    """X2's note shape (src/agents/agent-notes.ts takeAgentNote): {note_id, run_id, kind, agent_id, sent_by}; only an
    install note the person sent counts here (an uninstall reaches an agent only as its own key's 410)."""
    return (isinstance(note, dict) and note.get("kind") == "install" and note.get("sent_by") == "person"
            and all(isinstance(note.get(k), str) and re.fullmatch(GRANT_ID_RE, note[k].lower()) for k in ("note_id", "agent_id")))


def _notes_seen_path(sid):
    return os.path.join(STATE, f"notes-seen-{sid}.json")


def result_notes(inp):
    """EPM MUST 3: install notes only from the dedicated `_meta.datastash_note` field of a datastash connector call's
    result: the hook's own tool_response when it carries `_meta`, or the result entry Claude Code writes to this
    session's transcript (its `mcpMeta._meta`, which only the MCP server sets; never the model's text, a row, a message
    or a result's text). The entry's tool_use_id must be a call of this session (not a side chain), and the connector
    must be datastash's by its configured URL (_trusted_connector), never by its name."""
    notes = []
    tr = inp.get("tool_response")
    meta = tr.get("_meta") if isinstance(tr, dict) else None
    name = str(inp.get("tool_name") or "")
    if isinstance(meta, dict) and _note_ok(meta.get(NOTE_FIELD)) and _trusted_connector(inp, name):
        notes.append(meta[NOTE_FIELD])
    sid, tp = _sid(inp), inp.get("transcript_path")
    if not sid or not isinstance(tp, str) or not _transcript_ok(tp, sid):
        return notes
    try:
        with open(tp, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 512 * 1024))
            if b'"' + NOTE_FIELD.encode() + b'"' not in f.read():
                return notes  # the common case: no note anywhere near, nothing parsed
    except OSError:
        return notes
    entries = _jsonl_tail(tp, 512 * 1024)
    calls = {}
    for v in entries:
        if v.get("type") == "assistant" and not v.get("isSidechain"):
            msg = v.get("message") if isinstance(v.get("message"), dict) else {}
            for c in msg.get("content") if isinstance(msg.get("content"), list) else []:
                if isinstance(c, dict) and c.get("type") == "tool_use" and isinstance(c.get("id"), str):
                    calls[c["id"]] = str(c.get("name") or "")
    for v in entries:
        mm = v.get("mcpMeta")
        if v.get("type") != "user" or v.get("isSidechain") or not isinstance(mm, dict) or not isinstance(mm.get("_meta"), dict):
            continue
        msg = v.get("message") if isinstance(v.get("message"), dict) else {}
        c = msg.get("content")
        ids = [x.get("tool_use_id") for x in c if isinstance(x, dict) and x.get("type") == "tool_result"] if isinstance(c, list) else []
        call = calls.get(ids[0], "") if len(ids) == 1 and isinstance(ids[0], str) else ""
        if _note_ok(mm["_meta"].get(NOTE_FIELD)) and _trusted_connector(inp, call):
            notes.append(mm["_meta"][NOTE_FIELD])
    return notes


def _own_agent(inp):
    """This session's own agent (its local record with an agent_id; a key is not needed), or None."""
    a = agent_for(project_of(inp), me=this_session(inp)) or session_agent(inp)
    return a if a is not None and not is_person(a) and isinstance(a.get("agent_id"), str) \
        and re.fullmatch(GRANT_ID_RE, a["agent_id"].lower()) else None


def install_note_ai(inp):
    """An install note for this session's own agent (its agent_id, never another's), once per note: the fixed AI step
    for it to get its key, or None (no note, another agent's, already handled, this folder off or private, or this agent
    already has its key). The name and id come from this agent's own local record, never from the note."""
    sid = _sid(inp)
    notes = result_notes(inp)
    if not sid or not notes:
        return None
    seen = read_json(_notes_seen_path(sid), {}).get("ids")
    seen = seen if isinstance(seen, list) else []
    fresh = [n for n in notes if n["note_id"].lower() not in seen]
    if not fresh:
        return None
    try:
        write_private(_notes_seen_path(sid), json.dumps({"ids": (seen + [n["note_id"].lower() for n in fresh])[-50:]}))
    except OSError:
        return None  # can't mark it handled: never act twice
    own = _own_agent(inp)
    if own is None or not any(n["agent_id"].lower() == own["agent_id"].lower() for n in fresh):
        return None
    if read_key(own["slug"]) or off_here(inp) or private_here(inp):
        return None
    return NOTE_INSTALL_AI.format(name=show_name(own["name"]), agent_id=own["agent_id"].lower())


def command_tool(inp):
    """PreToolUse / PostToolUse of the install and uninstall calls, and any datastash answer's install note: the hook's
    output, or None (nothing to do)."""
    event, name = inp.get("hook_event_name"), str(inp.get("tool_name") or "")
    m = CMD_TOOL_RE.fullmatch(name)
    sid = _sid(inp)
    rec = load_cmd(sid)
    if event == "PreToolUse":
        if m and m.group(1) == "ledger_agent_register":  # 1.0.11: a new agent's name is plain, never a pick word
            ti = inp.get("tool_input") if isinstance(inp.get("tool_input"), dict) else {}
            nm = ti.get("name")
            return _deny(new_name_refused(nm)) if new_name_refused(nm) else None
        if not m or m.group(1) != "ledger_agents_note":
            return None
        return note_input(inp, rec) if rec and rec.get("kind") in ("install", "uninstall") + VIS_KINDS and rec.get("targets") \
            else _deny(NO_STEP_LINE)
    if event not in ("PostToolUse", "PostToolUseFailure") or not name.startswith("mcp__") or "datastash" not in name.lower():
        return None
    body = tool_answer(inp.get("tool_response")) if event == "PostToolUse" else None
    tool = m.group(1) if m else None
    if tool == "ledger_agent_register" and rec and rec.get("kind") == "install":
        tabs = [t.get("workbook_id") for t in (body or {}).get("notes_tabs") or [] if isinstance(t, dict)]
        if tabs:
            save_cmd(sid, dict(rec, workbook_id=tabs[0]))
        return None
    if tool == "ledger_agent_key" and body is not None:
        line = collect_after_mint(inp, rec, body)
        return _post(line) if line else None
    if tool == "ledger_agents_list" and rec and rec.get("kind") in ("install", "uninstall") + VIS_KINDS:
        lst = norm_list(body)
        if lst is None:
            if rec["kind"] in VIS_KINDS:
                _drop(_cmd_path(sid))
            return _post(server_refused(body))
        if rec["kind"] in VIS_KINDS:  # X6: the typed name, bound to an agent id from this list
            got = resolve_picks(rec.get("picks") or "", lst, None, reserved=False)
            if not isinstance(got, list):
                _drop(_cmd_path(sid))
                return _post(None, VIS_NOT_AGENT_AI) if got == "none" else \
                    _post(vis_refused_line(rec.get("picks") or "", lst), VIS_REFUSED_AI)
            save_cmd(sid, dict(rec, list=lst, targets=got))
            return _post(None, VIS_NOTE_AI.format(kind=rec["kind"]))
        own = _own(inp)
        mine = own["agent_id"].lower() if own else None
        rec = dict(rec, list=lst)
        if rec["kind"] == "install":
            rec["targets"] = [a["id"] for a in lst["agents"] if a["id"] != mine]
            if not rec["targets"]:  # this is the account's only agent: no note to send, the list is the whole answer
                _drop(_cmd_path(sid))
                tpc_install_kick(inp)
                return _post("\n".join(list_lines(lst, ON_HEAD) + after_install(inp)),
                             "The plugin showed the person the list. Make no more datastash calls; say nothing more.")
        elif rec.get("picks"):
            got = resolve_picks(rec["picks"], lst, mine)
            if got == "confirm":  # 1.0.11 stored-name HIGH: "/datastash:uninstall all" asks to confirm first
                save_cmd(sid, dict(rec, picks="", confirm=all_confirm(lst)))
                return _post(all_confirm_lines(lst), ALL_CONFIRM_AI)
            if not isinstance(got, list):
                _drop(_cmd_path(sid))
                return _post(pick_refused_line(rec["picks"], lst, mine), PICK_REFUSED_AI)
            rec["targets"] = got
            save_cmd(sid, rec)
            return _post(None, UNINSTALL_NOTE_AI.format(list=""))
        save_cmd(sid, rec)
        if rec["kind"] == "uninstall":
            return _post("\n".join(list_lines(lst, LIST_HEAD) + [PICK_LINE]), "The plugin showed the person the list. "
                         "Say nothing more; wait for their answer.")
        return None
    if tool == "ledger_agents_note" and rec and rec.get("kind") in ("install", "uninstall") + VIS_KINDS:
        _drop(_cmd_path(sid))
        if rec["kind"] == "install":
            tpc_install_kick(inp)
        return _post(note_result(inp, rec, body))
    return None


RUN_PATH_RE = re.compile(r"/api/v1/agent/uninstall/" + GRANT_ID_RE)


def _run_waiting(own, path, others):
    """The names of the run's agents that have not confirmed yet (X2 GET status_path, on this agent's still-live key),
    else every other target's name (nothing confirmed is the safe default)."""
    if isinstance(path, str) and RUN_PATH_RE.fullmatch(path.lower()):
        try:
            st = api_json("GET", path.lower(), read_key(own["slug"]), timeout=10)
            got = st.get("not_confirmed") if isinstance(st, dict) else None
            if isinstance(got, list):
                mine = show_name(own["name"])
                return [show_name(n) for n in got if isinstance(n, str) and show_name(n) != mine][:100]
        except (ApiError, urllib.error.URLError, httpclient.HTTPException, OSError, ValueError):
            pass
    return others


def note_result(inp, rec, body):
    """The person's fixed lines after the note (X2 answers {run_id, kind, targets, removed?, this_agent_last?,
    status_path}): the install list, or what uninstall removed; this agent, when picked, goes last on its own key
    (POST uninstall with the run id), then its local cleanup."""
    lst, targets = rec.get("list") or {"agents": []}, rec.get("targets") or []
    if rec["kind"] in VIS_KINDS:
        return visibility_result(rec, lst, targets, body)
    if not isinstance(body, dict) or body.get("error") or body.get("code"):
        code = body.get("code") if isinstance(body, dict) else None
        return server_refused(body, OTHERS_FAILED_LINE) if rec["kind"] == "install" else (
            BRAKED_LINE if code in ("braked", "rate_limit_exceeded") else server_refused(body))
    if rec["kind"] == "install":
        return "\n".join(list_lines(lst, ON_HEAD) + after_install(inp))
    names = {a["id"]: a["name"] for a in lst["agents"]}
    own = _own(inp)
    mine = own["agent_id"].lower() if own else None
    others = [names[t] for t in targets if t != mine and t in names]
    waiting = _run_waiting(own, body.get("status_path"), others) if own and others else others
    lines = [OFF_LINE.format(names=", ".join(f'"{names[t]}"' for t in targets if t in names)),
             REMOVED_LINE.format(n=len(targets))]
    if waiting:
        lines.append(UNCONFIRMED_LINE.format(names=", ".join(f'"{n}"' for n in waiting)))
    if own is not None and mine in targets:
        run = body.get("run_id")
        last = uninstall_self(own, run if isinstance(run, str) and re.fullmatch(GRANT_ID_RE, run.lower()) else None)
        if last in (BRAKED_LINE, REFUSED_LINE):
            lines.append(f'"{show_name(own["name"])}" (this agent): {last}')
    return " ".join(lines + [CONNECTOR_SAME_LINE])


def _vis_line_ok(line, kind, names):
    """True when the server's line is X6's fixed line (src/agents/agent-notes.ts visibilityLine) over names from this
    list only: nothing else the server could say is shown as the plugin's line."""
    if not isinstance(line, str) or len(line) > 4000 or not names:
        return False
    alt = "|".join(re.escape(n) for n in sorted(set(names), key=len, reverse=True))
    q = f'"(?:{alt})"'
    now = (f"{q} is private now: it shares nothing with your other agents\\." if kind == "private" else f"{q} is public now\\.")
    same = f"{q}(?:, {q})* (?:is|are) already {kind}, or switched off\\."
    return re.fullmatch(f"(?:{now})(?: {now})*(?: {same})?|{same} Nothing changed\\.", line) is not None


def vis_line(kind, changed, unchanged):
    """The same fixed line, made here from list names (when the server's is not that line)."""
    on = kind == "private"
    lines = [f'"{n}" is private now: it shares nothing with your other agents.' if on else f'"{n}" is public now.'
             for n in changed]
    if unchanged:
        lines.append(", ".join(f'"{n}"' for n in unchanged) + f" {'is' if len(unchanged) == 1 else 'are'} already "
                     f"{kind}, or switched off.")
    if not changed:
        lines.append("Nothing changed.")
    return " ".join(lines)


def visibility_result(rec, lst, targets, body):
    """X6: the person's line after "make <name> private|public" (X6 answers {kind, changed, line}): the server's fixed
    line, shown only when it is that line over names on the list; this computer's private record follows what changed."""
    if not isinstance(body, dict) or body.get("error") or body.get("code"):
        code = body.get("code") or body.get("error") if isinstance(body, dict) else None
        return VIS_BRAKED_LINE if code in ("braked", "rate_limit_exceeded") else server_refused(body)
    names = {a["id"]: a["name"] for a in lst["agents"]}
    changed = body.get("changed") if isinstance(body.get("changed"), list) else []
    line = body.get("line")
    if body.get("kind") != rec["kind"]:
        return REFUSED_LINE
    said = [show_name(c) for c in changed if isinstance(c, str)]
    done = [t for t in targets if names.get(t) in said]
    local = {a["agent_id"].lower(): a.get("slug") for a in all_agents() if isinstance(a.get("agent_id"), str)}
    for t in done:
        if t in local:
            note_private(dict(private=rec["kind"] == "private"), t, local[t])  # the local record only, never a request
    if _vis_line_ok(line, rec["kind"], list(names.values())):
        return line
    return vis_line(rec["kind"], [names[t] for t in done], [names[t] for t in targets if t in names and t not in done])


def agent_removed(agent, key):
    """A 410 agent_removed on this agent's own key: confirm with the dead key (its one allowed call), then the local
    cleanup of the fixed paths. The fixed line for the session."""
    try:
        api_json("POST", UNINSTALL_CONFIRM_PATH, key, body={}, timeout=15)
    except (ApiError, urllib.error.URLError, httpclient.HTTPException, OSError, ValueError):
        pass  # the key is dead server-side anyway; the cleanup goes on
    remove_agent_here(agent["slug"])
    return REMOVED_HERE_LINE


# ------------------------------------------------------------------ XLI-391: the person's chatstash setting, said by the plugin
# The person's chatstash setting (on or off, who set it and when) reaches every agent session as a datastash note, the
# trusted channel, never as a line in a tool result: at session start (always) and from the background listener when it
# changes. The setting and this chat's chat_key come from GET /api/v1/agent/chatstash on the agent's own key. The plugin
# holds the chat_key (state/agent-<name>.chatkey, mode 600, per session) and adds it to the connector's chat_save calls
# itself; the model never sees it (the hook takes it out of datastash answers), so saving needs nobody to ask for it.
CHATSTASH_PATH = "/api/v1/agent/chatstash"  # {chatstash: {state, set_by, set_at}, chat_key}; ?chat_key= keeps one
CHATSTASH_NOTE = "datastash note (chatstash; the person's own setting)"
CHATSTASH_ON = (CHATSTASH_NOTE + ": chatstash is on for this account ({who}). After each reply, save the exchange with "
                "the datastash connector's chat_save (user_message, ai_reply, and turn 1, 2, 3 ...), without asking the "
                "person; the plugin adds this chat's chat_key itself, so never send, ask for or look for one.")
CHATSTASH_OFF = (CHATSTASH_NOTE + ": chatstash is off for this account ({who}). Save this chat's exchanges only when "
                 "the person asks.")
CHATSTASH_WHO = "set by {by} at {at}"
CHATSTASH_WHO_BY = "set by {by}; when is not recorded"
CHATSTASH_WHO_AT = "set at {at}; who set it is not recorded"
CHATSTASH_WHO_NONE = "who set it and when is not recorded"
CHATSTASH_EVERY = 60  # the listener reads the setting at most this often
CHATSTASH_FIRST = 20  # and first this long after it starts (the session start has just said it)
CHAT_KEY_RE = r"[A-Za-z0-9._:\-]{1,100}"  # the server's own chat_key shape
CHAT_KEY_HIDDEN = "(this chat's key, held by the datastash plugin)"
# A failed call's text can't be rewritten (Claude Code's PostToolUseFailure output takes additionalContext only), so a
# held chat_key that shows up there is retired: the plugin reads a new one for the next chat_save and never sends the
# shown one again.
CHAT_KEY_RETIRED = ("datastash note (chatstash): that failed datastash call's text showed this chat's key. The plugin "
                    "retired it and adds a new one to the next chat_save itself; never send, keep or repeat a chat_key.")
CHAT_SAVE_RE = re.compile(r"mcp__(.+?)__chat_save")
CHATS_KEEP = 50  # sessions remembered per agent
_WHEN_RE = re.compile(r"(\d{4}-\d\d-\d\d)[T ](\d\d:\d\d)(?::\d\d(?:\.\d+)?)?(Z|[+-]00:?00)?")


def chatkey_path(s):
    return _fill("{st}/agent-{s}.chatkey", s)


def _chat_sessions(s):
    rec = read_json(chatkey_path(s), {})
    ses = rec.get("sessions") if isinstance(rec, dict) else None
    return {k: v for k, v in ses.items() if isinstance(v, dict)} if isinstance(ses, dict) else {}


def _chat_put(s, sid, **fields):
    """Records fields for this session (its chat_key, what it was told), mode 600, the newest CHATS_KEEP sessions."""
    ensure_dirs()
    with StateLock(s):
        ses = _chat_sessions(s)
        cur = ses.pop(sid, {})
        cur.update(fields, at=int(time.time()))
        ses[sid] = cur
        write_private(chatkey_path(s), json.dumps({"sessions": dict(list(ses.items())[-CHATS_KEEP:])}))


def held_chat_key(s, sid):
    k = _chat_sessions(s).get(sid, {}).get("key") if sid else None
    return k if isinstance(k, str) and re.fullmatch(CHAT_KEY_RE, k) else None


def _when_text(v):
    m = _WHEN_RE.fullmatch(v.strip()) if isinstance(v, str) else None
    return f"{m.group(1)} {m.group(2)}{' UTC' if m.group(3) else ''}" if m else None


def chatstash_setting(body):
    """{state, by, at} from the chatstash route's answer or a _meta.datastash_settings object, else None."""
    c = body.get("chatstash") if isinstance(body, dict) else None
    if not isinstance(c, dict) or c.get("state") not in ("on", "off"):
        return None
    by = c.get("set_by")
    by = show_name(by).replace('"', "'") if isinstance(by, str) and by.strip() else None
    return {"state": c["state"], "by": by, "at": _when_text(c.get("set_at"))}


def chatstash_line(st):
    """The fixed note for a setting: on or off, who set it and when."""
    by = f'"{st["by"]}"' if st["by"] else None
    who = (CHATSTASH_WHO.format(by=by, at=st["at"]) if by and st["at"] else CHATSTASH_WHO_BY.format(by=by) if by else
           CHATSTASH_WHO_AT.format(at=st["at"]) if st["at"] else CHATSTASH_WHO_NONE)
    return (CHATSTASH_ON if st["state"] == "on" else CHATSTASH_OFF).format(who=who)


def _chat_sig(st):
    return [st["state"], st["by"], st["at"]]


def chatstash_fetch(agent, key, sid, timeout=10):
    """The setting, read on the agent's own key, keeping this session's chat_key (the new one is saved, mode 600).
    Raises the network and HTTP errors; None for an answer of the wrong shape."""
    held = held_chat_key(agent["slug"], sid)
    q = "?" + urllib.parse.urlencode({"chat_key": held}) if held else ""
    body = api_json("GET", CHATSTASH_PATH + q, key, timeout=timeout)
    st = chatstash_setting(body)
    ck = body.get("chat_key") if isinstance(body, dict) else None
    retired = _chat_sessions(agent["slug"]).get(sid, {}).get("retired") if sid else None
    if st is not None and sid and isinstance(ck, str) and re.fullmatch(CHAT_KEY_RE, ck) and ck != held \
            and ck not in (retired if isinstance(retired, list) else []):
        _chat_put(agent["slug"], sid, key=ck)
    return st


def chatstash_note(agent, key, sid, only_changed=False, timeout=10):
    """(note, told) for this session: at session start always, from the listener only when the setting differs from
    what this session was last told; None when nothing is to be said or it can't be read. Nothing is recorded here: the
    caller records `told` with chat_told only after the note was shown (a note that never reached the session is said
    again)."""
    if is_person(agent) or not sid:
        return None
    try:
        st = chatstash_fetch(agent, key, sid, timeout)
    except (ApiError, urllib.error.URLError, httpclient.HTTPException, OSError, ValueError):
        return None
    if st is None:
        return None
    if only_changed and _chat_sessions(agent["slug"]).get(sid, {}).get("told") == _chat_sig(st):
        return None
    return chatstash_line(st), _chat_sig(st)


def chat_told(s, sid, told):
    """Records that this session was shown the chatstash note `told` (after it was shown). Never in the way."""
    try:
        _chat_put(s, sid, told=told)
    except OSError:
        pass


def _datastash_call(inp, name):
    return _trusted_connector(inp, name)


def chat_key_binding(inp, args):
    """PreToolUse of a datastash connector's chat_save: args with chat_key set to the key the plugin holds for this
    session (any chat_key the AI sent is replaced; read now when none is held yet), or None when nothing changes."""
    if not isinstance(inp, dict) or inp.get("hook_event_name") != "PreToolUse" or not isinstance(args, dict):
        return None
    name = str(inp.get("tool_name") or "")
    sid = _sid(inp)
    if not CHAT_SAVE_RE.fullmatch(name) or not sid or not _datastash_call(inp, name):
        return None
    own = _own(inp)
    if own is None:
        return None
    held = held_chat_key(own["slug"], sid)
    if held is None:
        try:
            chatstash_fetch(own, read_key(own["slug"]), sid, timeout=5)
        except (ApiError, urllib.error.URLError, httpclient.HTTPException, OSError, ValueError):
            return None
        held = held_chat_key(own["slug"], sid)
    if held is None:
        return None
    out = dict(args, chat_key=held)
    return out if out != args else None


def _swap(v, old, new):
    if isinstance(v, str):
        return v.replace(old, new)
    if isinstance(v, list):
        return [_swap(x, old, new) for x in v]
    if isinstance(v, dict):
        return {k: _swap(x, old, new) for k, x in v.items()}
    return v


def chat_key_hidden(inp):
    """PostToolUse of a datastash connector call: its output with this session's held chat_key taken out, or None."""
    name = str(inp.get("tool_name") or "")
    sid, tr = _sid(inp), inp.get("tool_response")
    if inp.get("hook_event_name") != "PostToolUse" or not sid or tr is None or not _datastash_call(inp, name):
        return None
    own = _own_agent(inp)
    held = held_chat_key(own["slug"], sid) if own else None
    if held is None or held not in json.dumps(tr, ensure_ascii=False):
        return None
    return _swap(tr, held, CHAT_KEY_HIDDEN)


def chat_key_failed(inp):
    """PostToolUseFailure of a datastash connector call whose error text shows this session's held chat_key: that key is
    retired (the next chat_save reads a new one) and the AI line, else None. The error text itself can't be replaced."""
    name = str(inp.get("tool_name") or "")
    sid = _sid(inp)
    if inp.get("hook_event_name") != "PostToolUseFailure" or not sid or not _datastash_call(inp, name):
        return None
    own = _own_agent(inp)
    held = held_chat_key(own["slug"], sid) if own else None
    err = inp.get("error")
    if held is None or held not in (err if isinstance(err, str) else json.dumps(err, ensure_ascii=False)):
        return None
    with StateLock(own["slug"]):
        ses = _chat_sessions(own["slug"])
        cur = ses.get(sid, {})
        cur.pop("key", None)
        cur["retired"] = (cur.get("retired") or [])[-4:] + [held]  # never taken back from a ?chat_key= answer
        ses[sid] = cur
        write_private(chatkey_path(own["slug"]), json.dumps({"sessions": dict(list(ses.items())[-CHATS_KEEP:])}))
    return CHAT_KEY_RETIRED


def chatstash_meta_note(inp):
    """PostToolUse of a datastash connector call whose answer carries _meta.datastash_settings: the note when the
    chatstash setting there differs from what this session was last told, else None."""
    name, sid, tr = str(inp.get("tool_name") or ""), _sid(inp), inp.get("tool_response")
    meta = tr.get("_meta") if isinstance(tr, dict) else None
    st = chatstash_setting(meta.get("datastash_settings")) if isinstance(meta, dict) else None
    if st is None or not sid or not _datastash_call(inp, name):
        return None
    own = _own_agent(inp)
    if own is None or not read_key(own["slug"]) or _chat_sessions(own["slug"]).get(sid, {}).get("told") == _chat_sig(st):
        return None
    _chat_put(own["slug"], sid, told=_chat_sig(st))
    return chatstash_line(st)


# --- XLI-378 B: datastash ci-report, per-test results from CI into the "tests" preset (ledger_feeds_setup services
# ["tests"]: Tests, Test failures, Test weeks), plus the "Test runs" tab this command keeps for flaky bookkeeping.
#
# Privacy (plan section 2): the JUnit XML is parsed here, in CI, with the standard library's expat parser and no DTD
# (a DOCTYPE or an entity declaration is refused before it is read, so no entity expansion, billion laughs or external
# fetch). Only allow-listed fields leave CI: test ids and file paths (as the runner names them), counts, times, the error
# class and a sha256 of the first message line with numbers and hex ids stripped. Failure messages, stack traces,
# stdout and stderr are read only to take that hash and are never sent or printed.
#
# Flaky, order-independent (card A review, cycle 2): one rule on both sides: a test is flaky on a commit when one report
# passed it and another (or the same, a retry) failed it. Every report first records its outcome on the commit (its
# failure rows, and its "Test runs" rows: the hash of the tests it ran, the ids it failed and a short hash of each test it
# passed), and only then reads the commit's failure rows and Test runs rows. Writes to one workbook are serialized, so of
# two reports on one commit the later one always sees the earlier: a pass sees the failure row; a failure sees the pass
# hash, whatever tests each job ran. When both run at once both see it; the first to move the failure row's passes from
# 0 (save only if unchanged) adds flaky_commits once. A --local run (uncommitted edits) never writes or reads these.
#
# A reporting problem never fails the build: the command prints one line and exits 0. A brake (429) or busy answer is
# waited out (Retry-After), up to DATASTASH_CI_WAIT_SECONDS in all (a bad value: the default); each page is sent with an
# idempotency key, so a retry never counts twice. A server that does not answer is given CI_CALL_SECONDS a call and
# CI_HANG_SECONDS in all.
CI_USAGE = ("usage: datastash ci-report <junit.xml ...> --repo OWNER/NAME --sha SHA --branch BRANCH --run-url URL "
            "[--job NAME] [--default-branch main] [--workbook ID] [--local]  (agent key in DATASTASH_AGENT_KEY, "
            "workbook id in DATASTASH_WORKBOOK_ID or --workbook)")
CI_TESTS, CI_FAILURES, CI_WEEKS, CI_RUNS = "Tests", "Test failures", "Test weeks", "Test runs"
CI_PAGE = 1000  # rows per upsert or read (a transport detail, not a cap)


def _ci_env_seconds(name, default, zero_ok=False):
    """A positive number of seconds from the environment (0 too when zero_ok); anything else (empty, text, nan, inf, less
    than that) is the default."""
    try:
        v = float(os.environ.get(name) or default)
    except (TypeError, ValueError):
        return default
    return v if math.isfinite(v) and (v > 0 or (zero_ok and v == 0)) else default


CI_WAIT_SECONDS = _ci_env_seconds("DATASTASH_CI_WAIT_SECONDS", 900.0)
CI_CALL_SECONDS = 60.0  # the longest one call may go unanswered
CI_HANG_SECONDS = 180.0  # unanswered calls (timeouts, network errors) in all, before the report stops
CI_RETRIES = 4  # tries for a network or server error that is not a brake
CI_RETRY_SECONDS = _ci_env_seconds("DATASTASH_CI_RETRY_SECONDS", 2.0, zero_ok=True)  # a bad value: the default
CI_IDS_CHARS = 60_000  # failed ids listed on a Test runs row; past it the row says the list is not complete
CI_PASS_HASH = 12  # hex characters of sha256(test id) listed per passed test, CI_IDS_CHARS per Test runs row
CI_RUNS_KEEP_DAYS = 14  # Test runs rows are needed only while a commit's jobs report; older ones are removed
CI_CAS_TRIES = 6
CI_READ_CHUNK = 1 << 16
CI_REPO_RE = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9._-]+")
CI_SHA_RE = re.compile(r"[0-9a-fA-F]{7,64}")
CI_WB_RE = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
CI_CLASS_RE = re.compile(r"[A-Za-z_$][\w$.]*")
CI_HASH_STRIP = [re.compile(p) for p in (
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}",  # uuids
    r"0[xX][0-9a-fA-F]+",  # 0x... addresses
    r"\b(?=[0-9a-fA-F]*[0-9])(?=[0-9a-fA-F]*[a-fA-F])[0-9a-fA-F]{6,}\b",  # hex ids (shas, object ids)
    r"\d+",  # numbers
)]


class CiProblem(Exception):
    """A reporting problem: its one plain line is printed and the command exits 0."""


class _CiWait(Exception):
    def __init__(self, seconds):
        super().__init__("wait")
        self.seconds = seconds


def ci_clean(s, n=1000):
    """Text as a field: control characters to spaces, trimmed, at most n characters."""
    return re.sub(r"[\x00-\x1f\x7f]+", " ", str(s or "")).strip()[:n]


def ci_error_hash(first_line):
    """sha256 of the first message line with uuids, hex ids and numbers stripped, so one failure groups across runs."""
    t = first_line or ""
    for rx in CI_HASH_STRIP:
        t = rx.sub("#", t)
    return hashlib.sha256(re.sub(r"\s+", " ", t).strip().encode("utf-8", "replace")).hexdigest()


def ci_error_class(typ, tag):
    """The error class from a failure's type attribute (AssertionError, pytest.fail.Exception), never more."""
    m = CI_CLASS_RE.match((typ or "").strip())
    v = m.group(0).rstrip(".")[:100] if m else ""
    return v or ("Error" if tag == "error" else "Failure")


def ci_test_id(file, classname, name):
    parts = []
    for p in (file, classname, name):
        p = ci_clean(p, 400)
        if p and p not in parts:
            parts.append(p)
    return " > ".join(parts)[:1000]


def ci_parse(paths):
    """{test id: {file, runs, passes, fails, skips, ms, error_class, error_hash}} from JUnit XML files, read in chunks
    with expat and no DTD. Raises CiProblem with a plain reason."""
    import xml.parsers.expat as expat
    tests = {}
    for path in paths:
        stack, case, fail = [], None, None

        def refuse(*_a):
            raise CiProblem(f"{os.path.basename(path)}: a DOCTYPE or entity declaration is refused (JUnit needs none)")

        def start(tag, attrs):
            nonlocal case, fail
            if tag == "testsuite":
                stack.append(attrs.get("file") or "")
            elif tag == "testcase":
                cls = attrs.get("classname") or ""
                f = attrs.get("file") or next((x for x in reversed(stack) if x), "") or cls
                try:
                    ms = max(0, int(round(float(attrs.get("time") or 0) * 1000)))
                except (TypeError, ValueError, OverflowError):
                    ms = 0
                case = {"id": ci_test_id(attrs.get("file") or "", cls, attrs.get("name") or ""), "file": ci_clean(f, 400),
                        "ms": ms if ms < 10 ** 12 else 0, "outcome": "pass"}
            elif case is not None and tag in ("failure", "error"):
                if case["outcome"] != "fail":
                    case["outcome"] = "fail"
                    case["class"] = ci_error_class(attrs.get("type"), tag)
                    msg = (attrs.get("message") or "").strip()
                    case["line"] = msg.splitlines()[0] if msg else None
                    fail = [] if case["line"] is None else None  # no message attribute: the text's first line
            elif case is not None and tag == "skipped" and case["outcome"] == "pass":
                case["outcome"] = "skip"

        def text(data):
            if fail is not None and sum(len(x) for x in fail) < 4096:
                fail.append(data)

        def end(tag):
            nonlocal case, fail
            if tag == "testsuite" and stack:
                stack.pop()
            elif tag in ("failure", "error") and fail is not None and case is not None:
                lines = [x.strip() for x in "".join(fail).splitlines() if x.strip()]
                case["line"], fail = (lines[0] if lines else ""), None
            elif tag == "testcase" and case is not None:
                c, case = case, None
                if not c["id"]:
                    return
                t = tests.setdefault(c["id"], {"file": c["file"] or "(none)", "runs": 0, "passes": 0, "fails": 0,
                                               "skips": 0, "ms": 0})
                t["runs"] += 1
                if c["outcome"] != "skip":
                    t["ms"] += c["ms"]
                t[{"pass": "passes", "fail": "fails", "skip": "skips"}[c["outcome"]]] += 1
                if c["outcome"] == "fail" and "error_class" not in t:
                    t["error_class"], t["error_hash"] = c["class"], ci_error_hash(c.get("line") or "")

        p = expat.ParserCreate()
        p.StartDoctypeDeclHandler = refuse
        p.EntityDeclHandler = refuse
        p.UnparsedEntityDeclHandler = refuse
        p.ExternalEntityRefHandler = refuse
        p.SetParamEntityParsing(expat.XML_PARAM_ENTITY_PARSING_NEVER)
        p.StartElementHandler, p.EndElementHandler, p.CharacterDataHandler = start, end, text
        try:
            with open(path, "rb") as f:
                while True:
                    b = f.read(CI_READ_CHUNK)
                    p.Parse(b, not b)
                    if not b:
                        break
        except OSError as e:
            raise CiProblem(f"{os.path.basename(path)}: can't be read ({e.strerror or e})")
        except expat.ExpatError as e:
            raise CiProblem(f"{os.path.basename(path)}: not JUnit XML ({expat.ErrorString(e.code)}, line {e.lineno})")
    return tests


def ci_iso_week(now):
    """The ISO week of a unix time, as 2026-W48 (UTC)."""
    import datetime
    y, w, _d = datetime.datetime.fromtimestamp(now, datetime.timezone.utc).isocalendar()[:3]
    return f"{y}-W{w:02d}"


def ci_instant(v):
    """A stored ISO time as a unix time, or None."""
    import datetime
    try:
        return datetime.datetime.fromisoformat(str(v).strip().replace("Z", "+00:00")).timestamp()
    except (TypeError, ValueError):
        return None


class CiClient:
    """The datastash calls of one report, on the agent key: batch upserts and reads on the MCP door, the one-row save
    only if unchanged on REST. Brakes and busy answers are waited out (until the deadline); other errors raise CiProblem."""

    sleep = staticmethod(time.sleep)  # its own name, so a test can watch this client's waits alone

    def __init__(self, key, workbook, deadline):
        self.key, self.wb, self.deadline = key, workbook, deadline
        self.hang_left = CI_HANG_SECONDS

    def _call(self, what, fn):
        """fn(timeout): one call, given at most CI_CALL_SECONDS, the time left before the deadline and the hang budget."""
        tries = 0
        while True:
            timeout = min(CI_CALL_SECONDS, self.deadline - time.time(), self.hang_left)
            if timeout <= 0:
                raise CiProblem(f"{what}: datastash did not answer in time; this report was not finished")
            began = time.time()
            try:
                return fn(max(0.1, timeout))
            except _CiWait as w:
                wait = max(1.0, float(w.seconds or 5))
            except ApiError as e:
                if e.status == 429:
                    wait = float(e.retry_after or 5)
                elif e.status in (401, 403):
                    raise CiProblem(f"{what}: the agent key was refused (HTTP {e.status}); check the CI secret")
                elif e.status >= 500 and tries < CI_RETRIES:
                    tries += 1
                    wait = CI_RETRY_SECONDS * tries
                else:
                    raise CiProblem(f"{what}: datastash answered HTTP {e.status} {ci_clean(e.body.get('code') or e.body.get('error'), 60)}".rstrip())
            except (OSError, ValueError, httpclient.HTTPException) as e:
                self.hang_left -= time.time() - began
                if self.hang_left <= 0:
                    raise CiProblem(f"{what}: datastash did not answer in {int(CI_HANG_SECONDS)} s; this report was not finished")
                if tries >= CI_RETRIES:
                    raise CiProblem(f"{what}: datastash can't be reached ({ci_clean(e, 120)})")
                tries += 1
                wait = CI_RETRY_SECONDS * tries
            if time.time() + wait > self.deadline:
                raise CiProblem(f"{what}: still slowed down after {int(CI_WAIT_SECONDS)} s; this report was not finished")
            self.sleep(wait)

    def tool(self, name, args, what, missing_ok=False, soft=False):
        """One MCP tool call. A read of a tab that is not there yet (missing_ok) answers None; a write never does. A soft
        read answers None for any refusal (busy and brake answers are still waited out)."""
        def once(timeout):
            is_err, body = mcp_tool(self.key, name, args, timeout=timeout)
            if is_err:
                code = str(body.get("code") or body.get("error") or "")
                ra = body.get("retry_after_seconds")
                if isinstance(ra, (int, float)) and ra > 0 or code in ("busy", "rate_limited", "agent_slowed_down"):
                    raise _CiWait(ra if isinstance(ra, (int, float)) else 3)
                if (code == "not_found" and missing_ok) or soft:
                    return None
                raise CiProblem(f"{what}: {ci_clean(body.get('message') or code or 'refused', 200)}")
            return body
        return self._call(what, once)

    def upsert(self, tab, rows, tag):
        """rows in pages of CI_PAGE, each with its own idempotency key (a retry never counts twice)."""
        for i in range(0, len(rows), CI_PAGE):
            self.tool("ledger_rows_upsert", {"workbook_id": self.wb, "tab": tab, "rows": rows[i:i + CI_PAGE], "key": "key",
                                             "idempotency_key": f"{tag}-{i // CI_PAGE}"}, f"writing {tab}")

    def filter(self, tab, where, order=None, pages=None):
        out, cursor, n = [], None, 0
        while True:
            args = {"workbook_id": self.wb, "tab": tab, "where": where, "limit": CI_PAGE}
            if order:
                args["order"] = order
            if cursor:
                args["cursor"] = cursor
            body = self.tool("ledger_rows_filter", args, f"reading {tab}", missing_ok=True)
            if body is None:
                return out
            out += [r for r in body.get("rows") or [] if isinstance(r, dict)]
            cursor, n = body.get("cursor"), n + 1
            if not cursor or (pages and n >= pages):
                return out

    def get(self, tab, keys):
        out = {}
        for i in range(0, len(keys), CI_PAGE):
            body = self.tool("ledger_rows_get", {"workbook_id": self.wb, "tab": tab, "keys": keys[i:i + CI_PAGE]},
                             f"reading {tab}", missing_ok=True)
            for r in (body or {}).get("rows") or []:
                if isinstance(r, dict) and isinstance(r.get("key"), str):
                    out[r["key"]] = r
        return out

    def first_pass(self, key):
        """Move the failure row's passes from 0 to 1, saved only if unchanged (if_version). True when this call did it
        (the caller then adds flaky_commits once); False when passes was already set by another report."""
        q = urllib.parse.urlencode({"workbook_id": self.wb, "tab": CI_FAILURES, "key": key}, quote_via=urllib.parse.quote)
        for _ in range(CI_CAS_TRIES):
            row = self._call("reading Test failures", lambda t: api_json("GET", ROWS_PATH + "/key?" + q, self.key, timeout=t))
            if _ci_num((row.get("cells") or {}).get("passes")) > 0:
                return False
            body = {"workbook_id": self.wb, "tab": CI_FAILURES, "key": "key", "row": {"key": key, "passes": 1},
                    "if_version": row.get("row_version")}

            def save(timeout):
                try:
                    api_json("POST", ROWS_PATH, self.key, body=body, timeout=timeout)
                    return True
                except ApiError as e:
                    if e.status == 409:
                        return False  # another report moved the row since it was read: read it again
                    raise
            if self._call("writing Test failures", save):
                return True
        raise CiProblem("writing Test failures: the row kept changing; flaky not recorded this time")


def _ci_num(v):
    try:
        return float(v or 0)
    except (TypeError, ValueError):
        return 0.0


def _ci_ids_text(ids):
    """The failed ids for a Test runs row (one per line) and whether the list is complete."""
    out, n = [], 0
    for t in ids:
        n += len(t) + 1
        if n > CI_IDS_CHARS:
            return "\n".join(out), False
        out.append(t)
    return "\n".join(out), True


def ci_pass_hash(t):
    return hashlib.sha256(t.encode("utf-8")).hexdigest()[:CI_PASS_HASH]


def ci_report(paths, repo, sha, branch, run_url, job, default_branch, key, wb, on_main=None, now=None, local=False):
    """Send one CI report. Returns a summary dict; raises CiProblem with a plain reason. local: a run on this computer
    (maybe on uncommitted edits): never main's state and never the commit's flaky bookkeeping (Test failures, Test runs)."""
    now = time.time() if now is None else now
    tests = ci_parse(paths)
    if not tests:
        raise CiProblem("no test cases in " + ", ".join(os.path.basename(p) for p in paths))
    iso = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(now))
    week, base_week = ci_iso_week(now), ci_iso_week(now - 28 * 86400)
    on_main = False if local else ((branch == default_branch) if on_main is None else on_main)
    client = CiClient(key, wb, time.time() + CI_WAIT_SECONDS)
    tag = "ci-report-" + secrets.token_hex(8)
    failed = sorted(t for t, v in tests.items() if v["fails"])
    passed = sorted(t for t, v in tests.items() if v["passes"])
    executed = sorted(t for t, v in tests.items() if v["passes"] or v["fails"])
    tkey = lambda t: f"{repo} / {t}"  # noqa: E731
    fkey = lambda t: f"{repo} / {sha} / {t}"  # noqa: E731

    # 1. This report's outcome on the commit, before anything is read: its failure rows and its Test runs rows (the
    # first holds the failed ids; each holds up to CI_IDS_CHARS of passed-test hashes). Never for a --local run.
    set_hash = hashlib.sha256("\n".join(executed).encode("utf-8")).hexdigest()
    ids, complete = _ci_ids_text(failed)
    run_key = f"{repo} / {sha} / {set_hash[:16]} / {hashlib.sha256(ids.encode('utf-8')).hexdigest()[:16]}"
    if not local:
        client.upsert(CI_FAILURES, [{
            "key": fkey(t), "repo": repo, "sha": sha, "test": t, "branch": branch, "run_url": run_url,
            "error_class": tests[t]["error_class"], "error_hash": tests[t]["error_hash"], "fails": {"inc": tests[t]["fails"]},
        } for t in failed], tag + "-f")
        per = CI_IDS_CHARS // (CI_PASS_HASH + 1)
        hashes = sorted({ci_pass_hash(t) for t in passed})
        parts = [hashes[i:i + per] for i in range(0, len(hashes), per)] or [[]]
        runs = [{
            "key": run_key, "repo": repo, "sha": sha, "branch": branch, "job": job, "set_hash": set_hash,
            "tests": len(executed), "failed_count": len(failed), "failed_ids": ids, "failed_listed": complete,
            "passed_hashes": "\n".join(parts[0]), "parts": len(parts),
            "reports": {"inc": 1}, "first_seen": {"min": iso}, "last_seen": {"max": iso},
        }]
        runs += [{"key": f"{run_key} / {i}", "repo": repo, "sha": sha, "job": job, "set_hash": set_hash, "part": i,
                  "passed_hashes": "\n".join(part), "first_seen": {"min": iso}, "last_seen": {"max": iso}}
                 for i, part in enumerate(parts[1:], 1)]
        client.upsert(CI_RUNS, runs, tag + "-r")

    # 2. Reads that must come before the Tests rows move: main's last outcome, and each file's week four weeks back.
    broke = set()
    if on_main and failed:
        prev = client.get(CI_TESTS, [tkey(t) for t in failed])
        broke = {t for t in failed if str((prev.get(tkey(t)) or {}).get("main_outcome") or "") == "pass"}
    files = {}
    for t, v in tests.items():
        f = files.setdefault(v["file"], {"runs": 0, "fails": 0, "ms": 0})
        f["runs"] += v["passes"] + v["fails"]
        f["fails"] += v["fails"]
        f["ms"] += v["ms"]
    base = client.get(CI_WEEKS, [f"{repo} / {f} / {base_week}" for f in sorted(files)])

    # 3. One Tests row per test, one Test weeks row per file, folded with ops.
    rows = []
    for t, v in sorted(tests.items()):
        ran = v["passes"] + v["fails"]
        outcome = "fail" if v["fails"] else ("pass" if v["passes"] else "skip")
        r = {"key": tkey(t), "repo": repo, "test": t, "file": v["file"], "runs": {"inc": ran}, "fails": {"inc": v["fails"]},
             "skips": {"inc": v["skips"]}, "ms_sum": {"inc": v["ms"]}, "last_outcome": outcome, "last_sha": sha,
             "first_seen": {"min": iso}, "last_seen": {"max": iso}}
        if ran:
            r["last_ms"] = v["ms"] // ran
        if on_main and ran:
            r["main_outcome"], r["main_sha"] = outcome, sha
        if t in broke:
            r["main_broke_at"] = sha
        rows.append(r)
    client.upsert(CI_TESTS, rows, tag + "-t")
    wrows = []
    for f, v in sorted(files.items()):
        r = {"key": f"{repo} / {f} / {week}", "repo": repo, "file": f, "week": week, "runs": {"inc": v["runs"]},
             "fails": {"inc": v["fails"]}, "ms_sum": {"inc": v["ms"]}}
        b = base.get(f"{repo} / {f} / {base_week}") or {}
        avg = _ci_num(b.get("avg_ms")) or (_ci_num(b.get("ms_sum")) / _ci_num(b.get("runs")) if _ci_num(b.get("runs")) else 0)
        if avg > 0:
            r["base_avg_ms"] = round(avg, 3)
        wrows.append(r)
    client.upsert(CI_WEEKS, wrows, tag + "-w")

    if local:
        return {"tests": len(tests), "files": len(files), "failed": len(failed), "flaky": [], "new_flaky": [],
                "broke": []}

    # 4. Flaky, order-independent: read the commit's failures and runs only now, after this report's own writes. One
    # rule whichever report comes first and whatever tests each ran: a recorded pass and a recorded failure.
    here = {"and": [{"eq": ["repo", repo]}, {"eq": ["sha", sha]}]}
    failed_here = {str(r.get("test")) for r in client.filter(CI_FAILURES, here) if _ci_num(r.get("fails")) > 0}
    flaky = {t for t in passed if t in failed_here}  # it failed in another job or run on this commit
    flaky |= {t for t in failed if tests[t]["passes"]}  # failed and passed in this report (a retry)
    passed_there = set()
    for r in client.filter(CI_RUNS, here):
        k = str(r.get("key") or "")
        if k == run_key or k.startswith(run_key + " / "):
            continue  # this report's own rows (or a report with the same outcome)
        passed_there |= set(str(r.get("passed_hashes") or "").split("\n"))
    flaky |= {t for t in failed if ci_pass_hash(t) in passed_there}  # it passed in another job or run on this commit
    new, more = [], []
    for t in sorted(flaky):
        if client.first_pass(fkey(t)):
            new.append(t)
        elif tests[t]["passes"]:
            more.append({"key": fkey(t), "passes": {"inc": tests[t]["passes"]}})
    client.upsert(CI_FAILURES, more, tag + "-p")
    client.upsert(CI_TESTS, [{"key": tkey(t), "flaky_commits": {"inc": 1}} for t in new], tag + "-k")

    # 5. Test runs rows are needed only while a commit's jobs report: remove this repo's rows past CI_RUNS_KEEP_DAYS.
    cutoff = now - CI_RUNS_KEEP_DAYS * 86400
    old = [r["key"] for r in client.filter(CI_RUNS, {"eq": ["repo", repo]}, order=[{"column": "last_seen", "dir": "asc"}],
                                           pages=1)
           if isinstance(r.get("key"), str) and (ci_instant(r.get("last_seen")) or now) < cutoff]
    if old:
        client.tool("ledger_rows_delete", {"workbook_id": wb, "tab": CI_RUNS, "keys": old}, "tidying Test runs")
    return {"tests": len(tests), "files": len(files), "failed": len(failed), "flaky": sorted(flaky), "new_flaky": new,
            "broke": sorted(broke)}


def _ci_args(args):
    opts = {"paths": [], "repo": None, "sha": None, "branch": None, "run_url": None, "job": os.environ.get("GITHUB_JOB", ""),
            "default_branch": "main", "workbook": os.environ.get("DATASTASH_WORKBOOK_ID", ""), "local": False}
    flags = {"--repo": "repo", "--sha": "sha", "--branch": "branch", "--run-url": "run_url", "--job": "job",
             "--default-branch": "default_branch", "--workbook": "workbook"}
    it = iter(args)
    for a in it:
        if a in flags:
            v = next(it, None)
            if v is None:
                raise CiProblem(f"{a} needs a value. {CI_USAGE}")
            opts[flags[a]] = v
        elif a == "--local":
            opts["local"] = True
        elif a.startswith("--"):
            raise CiProblem(f"unknown option {ci_clean(a, 40)}. {CI_USAGE}")
        else:
            opts["paths"].append(a)
    if opts["local"]:  # a run on this computer: the repo, commit and branch from git; never the default branch's state
        top = _fp_git(os.getcwd(), "rev-parse", "--show-toplevel")
        if top:
            opts["repo"] = opts["repo"] or _fp_repo(top)
            opts["sha"] = opts["sha"] or _fp_git(top, "rev-parse", "--verify", "-q", "HEAD")
            opts["branch"] = opts["branch"] or _fp_git(top, "rev-parse", "--abbrev-ref", "HEAD")
        opts["run_url"] = opts["run_url"] or ""
    if not opts["paths"]:
        raise CiProblem("name the JUnit XML file(s). " + CI_USAGE)
    for k in ("repo", "sha", "branch", "run_url"):
        if opts[k] is None or (k != "run_url" and not str(opts[k]).strip()):
            raise CiProblem(f"--{k.replace('_', '-')} is missing. {CI_USAGE}")
    if not CI_REPO_RE.fullmatch(opts["repo"].strip()):
        raise CiProblem("--repo takes owner/name")
    if not CI_SHA_RE.fullmatch(opts["sha"].strip()):
        raise CiProblem("--sha takes the commit's hex id")
    if opts["run_url"]:
        u = urllib.parse.urlsplit(opts["run_url"].strip())
        if u.scheme != "https" or not u.hostname or u.username is not None or u.password is not None:
            raise CiProblem("--run-url takes an https address with no user or password in it")
    if not CI_WB_RE.fullmatch(opts["workbook"].strip()):
        raise CiProblem("set DATASTASH_WORKBOOK_ID (or --workbook) to the agent workbook's id")
    return {"paths": opts["paths"], "repo": opts["repo"].strip(), "sha": opts["sha"].strip().lower(),
            "branch": ci_clean(opts["branch"], 200), "run_url": opts["run_url"].strip(), "job": ci_clean(opts["job"], 200),
            "default_branch": ci_clean(opts["default_branch"], 200), "wb": opts["workbook"].strip().lower(),
            "local": opts["local"]}


def cmd_ci_report(args):
    """datastash ci-report: always exits 0 (a reporting problem never fails a build); prints one line."""
    if any(a in ("-h", "--help") for a in args):
        print(CI_USAGE)
        return 0
    try:
        o = _ci_args(args)
        key = os.environ.get("DATASTASH_AGENT_KEY", "").strip()
        if not re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", key):
            raise CiProblem("set DATASTASH_AGENT_KEY (a CI secret) to the agent's key (ldgr_ag_...)")
        s = ci_report(o["paths"], o["repo"], o["sha"], o["branch"], o["run_url"], o["job"], o["default_branch"], key,
                      o["wb"], local=o["local"])
        extra = (f", flaky on this commit: {len(s['flaky'])}" if s["flaky"] else "") + \
                (f", main broke: {len(s['broke'])}" if s["broke"] else "")
        print(f"datastash ci-report: {s['tests']} tests from {s['files']} files sent for {o['repo']} "
              f"{o['sha'][:12]} ({s['failed']} failed{extra})")
    except CiProblem as e:
        print(f"datastash ci-report: not sent: {ci_clean(e, 300)}")
    except SystemExit:
        print("datastash ci-report: not sent: stopped")
    except Exception as e:  # noqa: BLE001 a reporting problem must never fail the build
        print(f"datastash ci-report: not sent: unexpected {type(e).__name__}")
    return 0


# --- XLI-378 D: datastash eval-report, eval results into the "evals" preset (ledger_feeds_setup services ["evals"]:
# Evals, one row per suite, case, model and version; Eval versions, one row per suite, model and version).
#
# Reads a results file on this computer or in CI: JSONL (one object per case run: case, passed, score, ms, tokens, cost,
# model, output), promptfoo's JSON output (results.results[]) or an Inspect eval log (samples[]). Privacy (plan section 1):
# prompts, vars, outputs, expected answers and grader text are never sent or printed; only suite, case, model and version
# names, pass, score, counts, times, tokens, the tool's own cost and (unless --no-output-hash) a sha256 of the output.
# Runs of one case fold into its row with inc; inc takes whole numbers, so a score goes in as score_milli (times 1000) and a
# cost as cost_micros (millionths). Every rate (pass_rate, delta_vs_prev, worse_count, ...) is the engine's formula column;
# this command does no math on them. With --vs PREV it first reads PREV's rows of the same cases and copies each one's
# passed as prev_passed, so the engine's worse column can see a case that passed before and fails now.
# Like ci-report, a reporting problem never fails the build: one line, exit 0 (the same client: brakes waited out, pages of
# 1,000 rows with an idempotency key each).
EV_USAGE = ("usage: datastash eval-report <results.jsonl | promptfoo.json | inspect-log.json ...> --suite S --version V "
            "[--model M] [--vs PREV] [--pass-at 1.0] [--no-output-hash] [--workbook ID]  (agent key in "
            "DATASTASH_AGENT_KEY, workbook id in DATASTASH_WORKBOOK_ID or --workbook)")
EV_EVALS, EV_VERSIONS = "Evals", "Eval versions"
EV_INSPECT_PASS = {"C": True, "I": False}  # Inspect's correct / incorrect marks; P (partial) and N count as not passed


def _ev_num(v):
    """A finite number from a result field (not a bool), or None."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    return float(v) if math.isfinite(v) else None


def _ev_hash(out):
    if out is None or out == "":
        return None
    text = out if isinstance(out, str) else json.dumps(out, sort_keys=True, ensure_ascii=False)
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()


def _ev_record(case, passed, score, ms, tokens, cost, model, output):
    return {"case": ci_clean(case, 400), "passed": passed, "score": score, "ms": ms, "tokens": tokens, "cost": cost,
            "model": ci_clean(model, 200) if isinstance(model, str) else "", "output": output}


def _ev_promptfoo(doc):
    res = doc.get("results")
    rows = res.get("results") if isinstance(res, dict) else res
    out = []
    for i, r in enumerate(rows if isinstance(rows, list) else []):
        if not isinstance(r, dict):
            continue
        tc = r.get("testCase") if isinstance(r.get("testCase"), dict) else {}
        resp = r.get("response") if isinstance(r.get("response"), dict) else {}
        usage = resp.get("tokenUsage") if isinstance(resp.get("tokenUsage"), dict) else (
            r.get("tokenUsage") if isinstance(r.get("tokenUsage"), dict) else {})
        prov = r.get("provider")
        model = (prov.get("label") or prov.get("id")) if isinstance(prov, dict) else prov
        case = tc.get("description") or r.get("description") or f"test-{r.get('testIdx', i)}"
        out.append(_ev_record(case, r.get("success") if isinstance(r.get("success"), bool) else None, _ev_num(r.get("score")),
                              _ev_num(r.get("latencyMs")), _ev_num(usage.get("total")), _ev_num(r.get("cost")), model,
                              resp.get("output")))
    return out


def _ev_inspect(doc):
    ev = doc.get("eval") if isinstance(doc.get("eval"), dict) else {}
    model = ev.get("model") if isinstance(ev.get("model"), str) else ""
    out = []
    for s in doc.get("samples") if isinstance(doc.get("samples"), list) else []:
        if not isinstance(s, dict):
            continue
        scores = s.get("scores") if isinstance(s.get("scores"), dict) else {}
        first = next((v for v in scores.values() if isinstance(v, dict)), {})
        val = first.get("value")
        passed, score = None, _ev_num(val)
        if isinstance(val, str) and val in EV_INSPECT_PASS:
            passed, score = EV_INSPECT_PASS[val], (1.0 if EV_INSPECT_PASS[val] else 0.0)
        elif isinstance(val, str):
            passed, score = False, (0.5 if val == "P" else 0.0)
        elif isinstance(val, bool):
            passed, score = val, (1.0 if val else 0.0)
        usage = s.get("model_usage") if isinstance(s.get("model_usage"), dict) else {}
        tokens = sum(_ev_num(u.get("total_tokens")) or 0 for u in usage.values() if isinstance(u, dict)) or None
        t = _ev_num(s.get("total_time"))
        out.append(_ev_record(str(s.get("id", "")), passed, score, t * 1000 if t is not None else None, tokens, None, model,
                              (s.get("output") or {}).get("completion") if isinstance(s.get("output"), dict) else None))
    return out


def ev_parse(paths):
    """The case runs in the results files, as records; raises CiProblem with a plain reason. Only the fields the records
    keep are read (vars, prompts and expected answers are never looked at)."""
    recs = []
    for path in paths:
        name = os.path.basename(path)
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                text = f.read()
        except OSError as e:
            raise CiProblem(f"{name}: can't be read ({e.strerror or e})")
        doc = None
        if text.lstrip().startswith(("{", "[")):
            try:
                doc = json.loads(text)
            except ValueError:
                doc = None  # JSONL: one object per line
        if isinstance(doc, dict) and "samples" in doc and "eval" in doc:
            recs += _ev_inspect(doc)
            continue
        if isinstance(doc, dict) and "results" in doc:
            recs += _ev_promptfoo(doc)
            continue
        lines = doc if isinstance(doc, list) else None
        if lines is None:
            lines = []
            for n, line in enumerate(text.splitlines(), 1):
                if not line.strip():
                    continue
                try:
                    lines.append(json.loads(line))
                except ValueError:
                    raise CiProblem(f"{name}: line {n} is not JSON (JSONL, promptfoo or Inspect JSON expected)")
        for r in lines:
            if not isinstance(r, dict):
                continue
            passed = next((r[k] for k in ("passed", "pass", "success") if isinstance(r.get(k), bool)), None)
            recs.append(_ev_record(r.get("case") or r.get("id") or r.get("name") or "", passed, _ev_num(r.get("score")),
                                   _ev_num(r.get("ms") if "ms" in r else r.get("latency_ms")), _ev_num(r.get("tokens")),
                                   _ev_num(r.get("cost")), r.get("model"), r.get("output")))
    return recs


def eval_report(paths, suite, version, model, prev, key, wb, pass_at=1.0, output_hash=True, now=None):
    """Send one eval run. Returns a summary dict; raises CiProblem with a plain reason."""
    now = time.time() if now is None else now
    recs = ev_parse(paths)
    cases = {}
    for r in recs:
        m = model or r["model"]
        if not r["case"]:
            raise CiProblem("a result has no case name (case, id or name)")
        if not m:
            raise CiProblem(f"no model for case {ci_clean(r['case'], 60)}: pass --model")
        passed = r["passed"] if r["passed"] is not None else (r["score"] is not None and r["score"] >= pass_at)
        c = cases.setdefault((r["case"], m), {"runs": 0, "passes": 0, "score_milli": 0, "ms": 0, "tokens": 0, "cost_micros": 0})
        c["runs"] += 1
        c["passes"] += 1 if passed else 0
        c["passed"] = passed
        score = r["score"] if r["score"] is not None else (1.0 if passed else 0.0)
        c["last_score"] = score
        c["score_milli"] += int(round(score * 1000))
        for f, v, mul in (("ms", r["ms"], 1), ("tokens", r["tokens"], 1), ("cost_micros", r["cost"], 1_000_000)):
            if v is not None and v >= 0:
                c[f] += int(round(v * mul))
        h = _ev_hash(r["output"]) if output_hash else None
        if h:
            c["output_hash"] = h
    if not cases:
        raise CiProblem("no eval results in " + ", ".join(os.path.basename(p) for p in paths))
    iso = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(now))
    ekey = lambda case, m, v: f"{suite} / {case} / {m} / {v}"  # noqa: E731
    vkey = lambda m, v: f"{suite} / {m} / {v}"  # noqa: E731
    client = CiClient(key, wb, time.time() + CI_WAIT_SECONDS)
    tag = "eval-report-" + secrets.token_hex(8)
    before = {}
    if prev:  # each case's passed at the version this one is compared with (a copy; the engine decides "worse")
        before = client.get(EV_EVALS, [ekey(c, m, prev) for c, m in sorted(cases)])
    rows = []
    for (case, m), c in sorted(cases.items()):
        r = {"key": ekey(case, m, version), "suite": suite, "case": case, "model": m, "version": version,
             "version_key": vkey(m, version), "runs": {"inc": c["runs"]}, "passes": {"inc": c["passes"]},
             "score_milli": {"inc": c["score_milli"]}, "last_score": c["last_score"], "passed": c["passed"],
             "ms_sum": {"inc": c["ms"]}, "tokens": {"inc": c["tokens"]}, "cost_micros": {"inc": c["cost_micros"]},
             "first_seen": {"min": iso}, "last_seen": {"max": iso}}
        p = (before.get(ekey(case, m, prev)) or {}).get("passed") if prev else None
        if isinstance(p, bool):
            r["prev_passed"] = p
        if c.get("output_hash"):
            r["output_hash"] = c["output_hash"]
        rows.append(r)
    client.upsert(EV_EVALS, rows, tag + "-e")
    models = sorted({m for _c, m in cases})
    vrows = []
    for m in models:
        v = {"key": vkey(m, version), "suite": suite, "model": m, "version": version, "first_seen": {"min": iso},
             "last_seen": {"max": iso}}
        if prev:
            v["prev_version"] = prev
        vrows.append(v)
    client.upsert(EV_VERSIONS, vrows, tag + "-v")
    return {"cases": len(cases), "runs": sum(c["runs"] for c in cases.values()),
            "passed": sum(1 for c in cases.values() if c["passed"]), "models": models,
            "compared": sum(1 for r in rows if "prev_passed" in r)}


def _ev_args(args):
    opts = {"paths": [], "suite": None, "version": None, "model": "", "vs": "", "pass_at": "1.0",
            "workbook": os.environ.get("DATASTASH_WORKBOOK_ID", ""), "output_hash": True}
    flags = {"--suite": "suite", "--version": "version", "--model": "model", "--vs": "vs", "--pass-at": "pass_at",
             "--workbook": "workbook"}
    it = iter(args)
    for a in it:
        if a in flags:
            v = next(it, None)
            if v is None:
                raise CiProblem(f"{a} needs a value. {EV_USAGE}")
            opts[flags[a]] = v
        elif a == "--no-output-hash":
            opts["output_hash"] = False
        elif a.startswith("--"):
            raise CiProblem(f"unknown option {ci_clean(a, 40)}. {EV_USAGE}")
        else:
            opts["paths"].append(a)
    if not opts["paths"]:
        raise CiProblem("name the results file(s). " + EV_USAGE)
    for k in ("suite", "version"):
        if not ci_clean(opts[k], 200):
            raise CiProblem(f"--{k} is missing. {EV_USAGE}")
    try:
        pass_at = float(opts["pass_at"])
    except (TypeError, ValueError):
        pass_at = float("nan")
    if not math.isfinite(pass_at):
        raise CiProblem("--pass-at takes a number (the score at which a case without a pass field passes)")
    if not CI_WB_RE.fullmatch(opts["workbook"].strip()):
        raise CiProblem("set DATASTASH_WORKBOOK_ID (or --workbook) to the agent workbook's id")
    return {"paths": opts["paths"], "suite": ci_clean(opts["suite"], 200), "version": ci_clean(opts["version"], 200),
            "model": ci_clean(opts["model"], 200), "vs": ci_clean(opts["vs"], 200), "pass_at": pass_at,
            "wb": opts["workbook"].strip().lower(), "output_hash": opts["output_hash"]}


def cmd_eval_report(args):
    """datastash eval-report: always exits 0 (a reporting problem never fails a build); prints one line."""
    if any(a in ("-h", "--help") for a in args):
        print(EV_USAGE)
        return 0
    try:
        o = _ev_args(args)
        key = os.environ.get("DATASTASH_AGENT_KEY", "").strip()
        if not re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", key):
            raise CiProblem("set DATASTASH_AGENT_KEY (a CI secret) to the agent's key (ldgr_ag_...)")
        s = eval_report(o["paths"], o["suite"], o["version"], o["model"], o["vs"], key, o["wb"], pass_at=o["pass_at"],
                        output_hash=o["output_hash"])
        vs = f", {s['compared']} compared with {o['vs']}" if o["vs"] else ""
        print(f"datastash eval-report: {s['cases']} cases ({s['runs']} runs, {s['passed']} passed last) sent for "
              f"{o['suite']} {o['version']}{vs}; pass_rate, delta_vs_prev and worse_count are on tab \"Eval versions\"")
    except CiProblem as e:
        print(f"datastash eval-report: not sent: {ci_clean(e, 300)}")
    except SystemExit:
        print("datastash eval-report: not sent: stopped")
    except Exception as e:  # noqa: BLE001 a reporting problem must never fail the build
        print(f"datastash eval-report: not sent: unexpected {type(e).__name__}")
    return 0


# --- XLI-378 G: datastash xlsx-test, spreadsheet output tests (ledger_feeds_setup services ["outputs"]: Expected outputs,
# one row per set, sheet and cell; Output runs, one row per set and commit).
#
# A CI step after the build. The produced .xlsx goes from CI straight to the engine (api.xlsx-for-ai.dev, or XFA_API_BASE)
# with the dev's own engine key (XFA_API_KEY): its chunked cache upload, then xlsx_check on the handle (stale saved values)
# and xlsx_eval on the handle with one comparison formula per expected cell, e.g. =ABS('Summary'!B7-(1234.5))<=0.005 or
# =EXACT('Summary'!B9,"Total"), plus ='Summary'!B7 for the value now. The engine's TRUE is a pass, its FALSE a fail, and
# anything else (an error, a decline) is "not known", which fails too. This command compares nothing itself; it builds the
# formula text and copies the engine's answers into the tabs. The file never goes to datastash.
# --record copies the engine's current values as the expected ones (for the dev to check once), for --cells or for the
# set's rows already there.
# Unlike ci-report this is a test: exit 0 when every cell passed and the file has no stale saved value, 1 when a value
# moved, could not be checked or is stale, 2 when the test could not run (no key, no file, the engine unreachable). A
# datastash write that fails after the engine answered is one line and does not change the exit code.
XT_USAGE = ("usage: datastash xlsx-test <file.xlsx> --set NAME [--sha SHA] [--branch B] [--run-url U] [--workbook ID] "
            "[--record [--cells \"Sheet!B7,Sheet!C9\"] [--tolerance 0]]  (engine key in XFA_API_KEY, else the one "
            "`npx xlsx-for-ai login` saved; agent key in "
            "DATASTASH_AGENT_KEY, workbook id in DATASTASH_WORKBOOK_ID or --workbook)")
XT_EXPECTED, XT_RUNS = "Expected outputs", "Output runs"
XT_ENGINE_ORIGIN = "https://api.xlsx-for-ai.dev"
XT_CHUNK = 16 * 1024 * 1024  # the engine cache's chunk size (a transport detail, not a cap)
XT_EVAL_ITEMS = 100  # formulas per xlsx_eval call on a handle (the engine's own cap)
XT_FORMULA_CHARS = 4096  # the engine's longest formula
XT_CELL_RE = re.compile(r"\$?([A-Za-z]{1,3})\$?([1-9][0-9]{0,6})")
XT_DATE_RE = re.compile(r"(\d{4})-(\d{2})-(\d{2})")
XT_MIN_WAIT = 1.0  # 1.0.9: the shortest pause before trying a 429 or busy answer again (pacing, not a cap): Retry-After 0
# would otherwise retry at once, over and over, until the deadline
# 1.0.9: what xlsx-test says when there is no engine key (exit 2): neither XFA_API_KEY nor a key saved by the engine's
# own device sign-in. After that sign-in the next run finds the saved key by itself (xt_engine_key).
XT_NO_ENGINE_KEY = ("datastash xlsx-test: did not run: no engine key. Run: npx xlsx-for-ai login (a link and a code, about "
                    "a minute; the free plan covers test runs). Then run this again.")
XT_ENGINE_CONFIG_MAX = 1024 * 1024  # a sign-in config is a few hundred bytes


def xt_engine_config_path():
    """Where the engine's own CLI (`npx xlsx-for-ai login`) saves its key: ~/.xlsx-for-ai/config.json, field api_key."""
    return os.path.join(HOME, ".xlsx-for-ai", "config.json")


def xt_engine_key():
    """The engine key and where it came from ("env" or "login"), or ("", None): XFA_API_KEY first, then the api_key the
    engine's login saved. The key is never printed, logged or put in any message; a config that can't be read is no key."""
    k = os.environ.get("XFA_API_KEY", "").strip()
    if k:
        return k, "env"
    try:
        with open(xt_engine_config_path(), "rb") as f:
            raw = f.read(XT_ENGINE_CONFIG_MAX + 1)
        cfg = json.loads(raw.decode("utf-8")) if len(raw) <= XT_ENGINE_CONFIG_MAX else None
    except (OSError, ValueError):
        cfg = None
    k = cfg.get("api_key") if isinstance(cfg, dict) else None
    k = k.strip() if isinstance(k, str) else ""
    return (k, "login") if k else ("", None)


def xt_engine(path, body, engine_key, deadline, what):
    """One engine call (POST <XFA_API_BASE>/<path>), its JSON answer. A 429 or busy answer is waited out until the deadline;
    a network or server error is tried CI_RETRIES times; any other refusal raises CiProblem with the engine's code."""
    if os.environ.get("DATASTASH_NO_NETWORK") == "1":
        raise CiProblem(f"{what}: network off (DATASTASH_NO_NETWORK=1)")
    base = (os.environ.get("XFA_API_BASE") or "").strip() or XT_ENGINE_ORIGIN
    url = base.rstrip("/") + "/" + path.lstrip("/")
    data = json.dumps(body).encode()
    tries = 0
    while True:
        req = urllib.request.Request(url, data=data, method="POST", headers={
            "Content-Type": "application/json", "Accept": "application/json", "User-Agent": USER_AGENT,
            "Authorization": "Bearer " + engine_key})
        wait = None
        try:
            with _opener.open(req, timeout=max(1.0, min(CI_CALL_SECONDS * 2, deadline - time.time()))) as r:
                return json.loads(r.read().decode("utf-8", "replace") or "{}")
        except urllib.error.HTTPError as e:
            text = e.read().decode("utf-8", "replace") if e.fp else ""
            try:
                err = (json.loads(text) or {}).get("error") or {}
            except (ValueError, AttributeError):
                err = {}
            err = err if isinstance(err, dict) else {"code": str(err)}
            code = ci_clean(err.get("code"), 60)
            if e.code in (401, 403):
                raise CiProblem(f"{what}: the engine refused the key (HTTP {e.code}); check XFA_API_KEY, or run "
                                "npx xlsx-for-ai login again")
            if e.code == 429 or code in ("busy", "rate_limited"):
                try:
                    wait = float((e.headers or {}).get("Retry-After") or err.get("retry_after_seconds") or 5)
                except (TypeError, ValueError):
                    wait = 5.0
                if not wait >= XT_MIN_WAIT:  # 0, negative or NaN: a short pause all the same
                    wait = XT_MIN_WAIT
            elif e.code >= 500 and tries < CI_RETRIES:
                tries += 1
                wait = CI_RETRY_SECONDS * tries
            else:
                msg = ci_clean(err.get("message"), 200)
                raise CiProblem(f"{what}: the engine answered HTTP {e.code} {code}" + (f" ({msg})" if msg else ""))
        except (OSError, ValueError, httpclient.HTTPException) as e:
            if tries >= CI_RETRIES:
                raise CiProblem(f"{what}: the engine can't be reached ({ci_clean(e, 120)})")
            tries += 1
            wait = CI_RETRY_SECONDS * tries
        if time.time() + wait > deadline:
            raise CiProblem(f"{what}: the engine was still busy at the deadline")
        CiClient.sleep(wait)


def xt_upload(path, engine_key, deadline):
    """The file into the engine's cache under a new random handle; the handle."""
    try:
        size = os.path.getsize(path)
        f = open(path, "rb")
    except OSError as e:
        raise CiProblem(f"{os.path.basename(path)}: can't be read ({e.strerror or e})")
    if size == 0:
        f.close()
        raise CiProblem(f"{os.path.basename(path)}: the file is empty")
    handle = str(uuid.uuid4())
    total = (size + XT_CHUNK - 1) // XT_CHUNK
    with f:
        for i in range(total):
            chunk = f.read(XT_CHUNK)
            xt_engine("api/v1/cache/upload-chunk", {"handle": handle, "chunk_index": i, "total_chunks": total,
                                                    "chunk_b64": base64.b64encode(chunk).decode("ascii")},
                      engine_key, deadline, "uploading the file to the engine")
    xt_engine("api/v1/cache/finalize", {"handle": handle, "ttl_seconds": 3600}, engine_key, deadline, "finalizing the upload")
    return handle


def xt_stale(handle, engine_key, deadline):
    """The engine's xlsx_check on the handle: (stale saved values, whether the list was cut short)."""
    out = xt_engine("api/v1/tools/xlsx_check", {"cache_handle": handle}, engine_key, deadline, "the engine's check")
    meta = out.get("_meta") if isinstance(out, dict) and isinstance(out.get("_meta"), dict) else {}
    findings = [f for f in meta.get("findings") or [] if isinstance(f, dict)]
    return (sum(1 for f in findings if f.get("code") == "stale_cached_value"),
            any(f.get("code") == "findings_truncated" for f in findings))


def xt_eval(handle, formulas, engine_key, deadline):
    """The engine's typed answer to each formula, in order ({"type", "value"}; None where it gave none)."""
    out = []
    for i in range(0, len(formulas), XT_EVAL_ITEMS):
        part = formulas[i:i + XT_EVAL_ITEMS]
        body = xt_engine("api/v1/tools/xlsx_eval", {"cache_handle": handle, "formulas": part, "options": {"value_format": "typed"}},
                         engine_key, deadline, "the engine's eval")
        meta = body.get("_meta") if isinstance(body, dict) and isinstance(body.get("_meta"), dict) else {}
        vals = [v for v in meta.get("cell_values") or [] if isinstance(v, dict)]
        by_index = {v["index"]: v for v in vals if isinstance(v.get("index"), int) and not isinstance(v.get("index"), bool)}
        out += [by_index.get(n) for n in range(len(part))]  # index is the 0-based place in formulas
    return out


def xt_ref(sheet, cell):
    """The formula reference 'Sheet'!B7, or None for a cell that is not one A1 address."""
    m = XT_CELL_RE.fullmatch((cell or "").strip())
    if not m or not sheet:
        return None
    return "'" + sheet.replace("'", "''") + "'!" + m.group(1).upper() + m.group(2)


def xt_number_text(v):
    """A number as formula text that reads back the same (repr of a float, no inf or nan), or None."""
    try:
        f = float(v)
    except (TypeError, ValueError):
        return None
    if not math.isfinite(f):
        return None
    return repr(int(f)) if f.is_integer() and abs(f) < 1e15 else repr(f)


def xt_compare(ref, kind, expected, tolerance):
    """The one comparison formula for an expected cell (the engine answers TRUE or FALSE), or None when it can't be built."""
    tol = xt_number_text(tolerance if tolerance not in (None, "") else 0)
    if tol is None or float(tol) < 0:
        return None
    if kind == "text":
        f = "=EXACT(" + ref + ",\"" + str(expected if expected is not None else "").replace("\"", "\"\"") + "\")"
    elif kind == "date" and XT_DATE_RE.fullmatch(str(expected or "").strip()):
        y, mo, d = XT_DATE_RE.fullmatch(str(expected).strip()).groups()
        f = f"=ABS({ref}-DATE({int(y)},{int(mo)},{int(d)}))<={tol}"
    elif kind in ("number", "date"):
        n = xt_number_text(expected)
        if n is None:
            return None
        f = f"=ABS({ref}-({n}))<={tol}"
    else:
        return None
    return f if len(f) <= XT_FORMULA_CHARS else None


def xt_value_text(v):
    """The engine's typed value as the text kept in last_actual or expected."""
    if not isinstance(v, dict):
        return ""
    t, val = v.get("type"), v.get("value")
    if t == "number" or t == "date":
        return xt_number_text(val) or ""
    if t == "boolean":
        return "TRUE" if val is True else "FALSE"
    if t == "blank" or val is None:
        return ""
    return ci_clean(val, 2000) if t == "error" else str(val)[:4000]


def xt_parse_cells(text):
    """--cells "Summary!B7,'My sheet'!C9" as [(sheet, cell)]; raises CiProblem for one that is not Sheet!A1."""
    out = []
    for part in re.findall(r"(?:'(?:[^']|'')*'|[^,])+", text or ""):
        part = part.strip()
        if not part:
            continue
        sheet, sep, cell = part.rpartition("!")
        if sheet.startswith("'") and sheet.endswith("'") and len(sheet) >= 2:
            sheet = sheet[1:-1].replace("''", "'")
        if not sep or not sheet or not XT_CELL_RE.fullmatch(cell.strip()):
            raise CiProblem(f"--cells: {ci_clean(part, 60)} is not Sheet!A1")
        m = XT_CELL_RE.fullmatch(cell.strip())
        out.append((ci_clean(sheet, 200), m.group(1).upper() + m.group(2)))
    if not out:
        raise CiProblem("--cells names no cell (\"Sheet!B7,Sheet!C9\")")
    return out


def xlsx_test(path, set_name, key, wb, engine_key, sha="", branch="", run_url="", record=False, cells=None, tolerance=None,
              now=None):
    """One output test (or --record). Returns a summary dict; raises CiProblem when it can't run. tolerance (record only):
    set on each recorded number cell; None keeps a row's own (0 for a new one)."""
    now = time.time() if now is None else now
    iso = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(now))
    deadline = time.time() + CI_WAIT_SECONDS
    client = CiClient(key, wb, deadline)
    ekey = lambda sheet, cell: f"{set_name} / {sheet}!{cell}"  # noqa: E731
    if record and cells:
        rows = [{"key": ekey(s, c), "sheet": s, "cell": c} for s, c in cells]
    else:
        rows = [r for r in client.filter(XT_EXPECTED, {"eq": ["set", set_name]}) if isinstance(r.get("key"), str)]
        rows.sort(key=lambda r: r["key"])
    if not rows:
        raise CiProblem(f"set {set_name!r} has no expected cells on tab \"{XT_EXPECTED}\"; record them first: "
                        "datastash xlsx-test <file> --set NAME --record --cells \"Sheet!B7\"")
    handle = xt_upload(path, engine_key, deadline)
    refs = [xt_ref(str(r.get("sheet") or ""), str(r.get("cell") or "")) for r in rows]
    if record:
        vals = xt_eval(handle, ["=" + ref for ref in refs if ref], engine_key, deadline)
        it, out, skipped = iter(vals), [], []
        for r, ref in zip(rows, refs):
            v = next(it) if ref else None
            if ref is None or not isinstance(v, dict) or v.get("type") == "error":
                skipped.append(r["key"])
                continue
            kind = "number" if v.get("type") in ("number", "date") else "text"
            m = XT_CELL_RE.fullmatch(str(r["cell"]))
            row = {"key": r["key"], "set": set_name, "sheet": r["sheet"], "cell": m.group(1).upper() + m.group(2),
                   "kind": kind, "expected": xt_value_text(v)}
            if kind != "number":
                row["tolerance"] = 0
            elif tolerance is not None or "tolerance" not in r:
                row["tolerance"] = tolerance or 0
            out.append(row)
        if out:
            client.upsert(XT_EXPECTED, out, "xlsx-test-" + secrets.token_hex(8))
        return {"record": True, "recorded": len(out), "skipped": skipped}
    stale, cut = xt_stale(handle, engine_key, deadline)
    formulas, slots = [], []
    for r, ref in zip(rows, refs):
        cmp_ = xt_compare(ref, str(r.get("kind") or "number"), r.get("expected"), r.get("tolerance")) if ref else None
        if cmp_ is None:
            slots.append(None)
            continue
        slots.append(len(formulas))
        formulas += ["=" + ref, cmp_]
    vals = xt_eval(handle, formulas, engine_key, deadline) if formulas else []
    results, upd = [], []
    for r, slot in zip(rows, slots):
        actual = vals[slot] if slot is not None and slot < len(vals) else None
        answer = vals[slot + 1] if slot is not None and slot + 1 < len(vals) else None
        if isinstance(answer, dict) and answer.get("type") == "boolean" and isinstance(answer.get("value"), bool):
            outcome = "pass" if answer["value"] else "fail"
        else:
            outcome = "unknown"
        results.append((r["key"], outcome, xt_value_text(actual), r.get("expected")))
        row = {"key": r["key"], "runs": {"inc": 1}, "fails": {"inc": 0 if outcome == "pass" else 1},
               "last_pass": outcome == "pass", "last_actual": xt_value_text(actual) if slot is not None else "", "last_run": iso}
        if sha:
            row["last_sha"] = sha
        upd.append(row)
    s = {"record": False, "checked": len(results), "passed": sum(1 for x in results if x[1] == "pass"),
         "failed": sum(1 for x in results if x[1] == "fail"), "unknown": sum(1 for x in results if x[1] == "unknown"),
         "stale": stale, "stale_cut": cut, "results": results, "write_problem": None}
    try:
        tag = "xlsx-test-" + secrets.token_hex(8)
        client.upsert(XT_EXPECTED, upd, tag + "-e")
        if sha:
            run = {"key": f"{set_name} / {sha}", "set": set_name, "sha": sha, "file": ci_clean(os.path.basename(path), 200),
                   "runs": {"inc": 1}, "checked": s["checked"], "passed": s["passed"], "failed": s["failed"],
                   "unknown": s["unknown"], "stale_cells": stale, "first_seen": {"min": iso}, "last_seen": {"max": iso}}
            if branch:
                run["branch"] = branch
            if run_url:
                run["run_url"] = run_url
            client.upsert(XT_RUNS, [run], tag + "-r")
    except CiProblem as e:
        s["write_problem"] = str(e)
    return s


def _xt_args(args):
    opts = {"paths": [], "set": "", "sha": "", "branch": "", "run_url": "", "cells": "", "tolerance": None,
            "workbook": os.environ.get("DATASTASH_WORKBOOK_ID", ""), "record": False}
    flags = {"--set": "set", "--sha": "sha", "--branch": "branch", "--run-url": "run_url", "--cells": "cells",
             "--tolerance": "tolerance", "--workbook": "workbook"}
    it = iter(args)
    for a in it:
        if a in flags:
            v = next(it, None)
            if v is None:
                raise CiProblem(f"{a} needs a value. {XT_USAGE}")
            opts[flags[a]] = v
        elif a == "--record":
            opts["record"] = True
        elif a.startswith("--"):
            raise CiProblem(f"unknown option {ci_clean(a, 40)}. {XT_USAGE}")
        else:
            opts["paths"].append(a)
    if len(opts["paths"]) != 1:
        raise CiProblem("name one .xlsx file. " + XT_USAGE)
    if not ci_clean(opts["set"], 200):
        raise CiProblem(f"--set is missing. {XT_USAGE}")
    sha = opts["sha"].strip()
    if sha and not CI_SHA_RE.fullmatch(sha):
        raise CiProblem("--sha takes a commit sha (7 to 64 hex characters)")
    if opts["cells"] and not opts["record"]:
        raise CiProblem("--cells goes with --record (a test run checks the set's rows)")
    tol = None if opts["tolerance"] is None else xt_number_text(opts["tolerance"])
    if opts["tolerance"] is not None and (tol is None or float(tol) < 0):
        raise CiProblem("--tolerance takes a number, 0 or more")
    if tol is not None and not opts["record"]:
        raise CiProblem("--tolerance goes with --record (a test run uses each row's own tolerance)")
    if not CI_WB_RE.fullmatch(opts["workbook"].strip()):
        raise CiProblem("set DATASTASH_WORKBOOK_ID (or --workbook) to the agent workbook's id")
    return {"path": opts["paths"][0], "set": ci_clean(opts["set"], 200), "sha": sha.lower(), "branch": ci_clean(opts["branch"], 200),
            "run_url": ci_clean(opts["run_url"], 500), "record": opts["record"],
            "cells": xt_parse_cells(opts["cells"]) if opts["cells"] else None, "tolerance": None if tol is None else float(tol),
            "wb": opts["workbook"].strip().lower()}


def cmd_xlsx_test(args):
    """datastash xlsx-test: 0 all passed, 1 a value moved, was not known or is stale, 2 the test could not run."""
    if any(a in ("-h", "--help") for a in args):
        print(XT_USAGE)
        return 0
    engine_key, key_from = xt_engine_key()
    if not engine_key:
        # 1.0.9: no engine key (neither XFA_API_KEY nor the engine login's saved key), no test. Checked first: nothing is read, uploaded or sent (to the engine or to datastash)
        # and nothing else is tried in its place.
        print(XT_NO_ENGINE_KEY)
        return 2
    try:
        if re.search(r"[\s\x00-\x1f]", engine_key):
            raise CiProblem("XFA_API_KEY has a space or control character in it; set it to your engine key alone"
                            if key_from == "env" else "the engine key saved by npx xlsx-for-ai login has a space or "
                            "control character in it; run npx xlsx-for-ai login again")
        o = _xt_args(args)
        key = os.environ.get("DATASTASH_AGENT_KEY", "").strip()
        if not re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", key):
            raise CiProblem("set DATASTASH_AGENT_KEY (a CI secret) to the agent's key (ldgr_ag_...)")
        s = xlsx_test(o["path"], o["set"], key, o["wb"], engine_key, sha=o["sha"], branch=o["branch"], run_url=o["run_url"],
                      record=o["record"], cells=o["cells"], tolerance=o["tolerance"])
    except CiProblem as e:
        print(f"datastash xlsx-test: did not run: {ci_clean(e, 300)}")
        return 2
    except SystemExit:
        print("datastash xlsx-test: did not run: stopped")
        return 2
    except Exception as e:  # noqa: BLE001 one line, never a traceback with a key in it
        print(f"datastash xlsx-test: did not run: unexpected {type(e).__name__}")
        return 2
    if s["record"]:
        extra = f"; not recorded (no value or an error): {', '.join(s['skipped'][:10])}" if s["skipped"] else ""
        print(f"datastash xlsx-test: recorded {s['recorded']} expected values for set {o['set']} from the engine; check them "
              f"once on tab \"{XT_EXPECTED}\"{extra}")
        return 0
    for k, outcome, actual, expected in s["results"]:
        if outcome != "pass":
            what = "moved" if outcome == "fail" else "could not be checked"
            print(f"datastash xlsx-test: {ci_clean(k, 200)} {what}: expected {ci_clean(expected, 80)}, the engine reads {ci_clean(actual, 80)}")
    if s["stale"]:
        print(f"datastash xlsx-test: {'at least ' if s['stale_cut'] else ''}{s['stale']} saved values in the file do not match "
              "their formulas (the engine's check); recalculate before saving")
    if s["write_problem"]:
        print(f"datastash xlsx-test: results not written to datastash: {ci_clean(s['write_problem'], 200)}")
    bad = s["failed"] + s["unknown"] + s["stale"]
    print(f"datastash xlsx-test: {'FAIL' if bad else 'ok'} set {o['set']}: {s['passed']} of {s['checked']} cells passed"
          f" ({s['failed']} moved, {s['unknown']} not known, {s['stale']} stale)")
    return 1 if bad else 0


# --- XLI-378 E: time per card. The plugin side of ledger_feeds_setup services ["burn"] (tabs Burn, Cards cost, Prices):
# at each subagent stop and session end it reads this session's own Claude Code transcripts (the main one and its
# subagents' files) ON THIS COMPUTER and sends, per card, activity and model, the minutes, tool calls and token counts.
#
# On by default (owner 11-24, plugin 1.0.12): a folder that never chose sets the tabs up the way `datastash time-per-card
# on` does (at /datastash:install, else at its first hook) and is then on; `datastash time-per-card off` is kept for good. Privacy (plan section 3): no prompt, answer, file text, command text or path leaves this computer. Commands and
# paths are read here, in memory, only to pick the activity (and a short hash of a read target, kept in this computer's
# private state to tell a repeat lookup); only counts, minutes, model names, activity labels and card ids are sent. The
# split is by activity only, never by agent vs subagent.
#
# Activities (fixed local rules, first match): Edit/Write = coding; a test-runner command = testing; git commit or push,
# gh pr create/merge/ready, a lander or deploy = landing; a review subagent (its description says review) = reviewing for
# all its calls; Monitor, a wake-up or a `sleep`/datastash watch = wakes; a read (Read, Grep, Glob, a web read, a read-only
# shell command, an outside-tool lookup) of a target this session already read = lookups, else orienting; a shell command
# that writes a file (sed -i, a redirect, a script that writes) = coding; the rest (delegating, messages, other commands)
# = planning. A model turn's tokens go to its first tool call's activity (a turn with no tool call after a wake:
# wakes; else planning). Minutes are active time only: a model turn from its input (or its model request) to its last
# entry, and a tool from its call to its result (wall time, overlaps counted once); never the time before the person
# types, a tool waiting on the person (AskUserQuestion, ExitPlanMode, a permission prompt the person answered), a wait
# over 10 minutes before a model turn's first entry (a pause or a resume), nor a subagent's run in its parent. Burn takes
# whole minutes ({"inc": n} is whole numbers only); the rest of a minute is carried to the session's next send.
# The card: a subagent's description, else DATASTASH_CARD, else the git branch (an id like XLI-12), else "no card".
#
# Each send has an idempotency key from where it was read, so a retry never counts twice; each part is marked taken and
# the read offsets move only after datastash took the rows; a send left pending (a failed session-end send) is finished
# by the next session start or send of any session of that workbook. Then, past TPC_FOLD_AT Burn rows (the range-sheet limit of the card totals; an existing
# ruling, not a cap), finished cards (oldest last_seen first, never a card in this report) are folded: their Burn rows'
# sums are written to the card's folded_* cells (once per card; only on a Cards cost tab that has them) and those rows
# are deleted, so each card reads the same totals. The fold
# only moves counts already sent; every total, share and price a person reads is the engine's formula column.
# Never fails or slows a session: the hook starts a background run and returns at once.
TPC_USAGE = "usage: datastash time-per-card [on | off]   (time per card for this folder's agent; on by default)"
# {"projects": {folder: {"on": bool, "at": time, "by"?: "default"}}, "card_tabs": {wb: tab}, "default_tried": {folder: time}}
# A folder with no entry never chose (on by default, plugin 1.0.12); {"on": false} is the person's typed off, kept for good.
TPC_PATH = os.path.join(CONF, "time-per-card.json")
# The per-card tab: the card_tab ledger_feeds_setup answered at `on` ("Time per card" in a workbook set up since x-live #487,
# "Cards cost" in an older one), saved per workbook; "Cards cost" when none was saved (x-live also maps that name to "Time
# per card" in a newer workbook, so a send before the next `on` still lands).
TPC_BURN, TPC_CARDS = "Burn", "Cards cost"
TPC_FOLD_AT = 10_000  # x-live RANGE_SHEET_MAX_ROWS: past it the Cards cost totals can't be read (XLI-378 F review)
TPC_PROGRESS = ("coding", "testing", "landing")
TPC_WAIT_SECONDS = 300.0
TPC_LOCK_SECONDS = 120.0
TPC_STEP = "-"
TPC_CARD_RE = re.compile(r"(?<![A-Za-z0-9])([A-Za-z]{2,10})-(\d{1,7})(?![0-9])")
TPC_NOT_CARD = {"alpha", "beta", "build", "bugfix", "chore", "deps", "dev", "develop", "feat", "feature", "fix", "hotfix",
                "main", "master", "patch", "pr", "prod", "rc", "rel", "release", "stage", "staging", "temp", "test",
                "tests", "tmp", "ver", "version", "wip"}
TPC_EDIT_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
TPC_READ_TOOLS = {"Read", "Grep", "Glob", "LS", "WebFetch", "WebSearch", "ToolSearch", "NotebookRead"}
TPC_WAKE_TOOLS = {"Monitor", "ScheduleWakeup", "TaskOutput"}
TPC_AGENT_TOOLS = {"Agent", "Task"}
# Active minutes only (PM ruling on review M1): a tool that waits on the person is never timed, nor a tool whose result
# says the person answered its permission prompt (permissionDecision.source "user_..."). A wait before a model turn's
# first entry longer than Claude Code's own model-request timeout (10 minutes) is a pause (a suspended, closed or resumed
# session), not work: it is left out. A measurement rule, not a data limit.
TPC_PERSON_TOOLS = {"AskUserQuestion", "ExitPlanMode"}
TPC_PAUSE_SECONDS = 600.0
TPC_FOLDED = ("folded_minutes", "folded_calls", "folded_tokens", "folded_progress_tokens", "folded_est_cost")
TPC_BURN_COUNTS = ("minutes", "calls", "tokens_in", "tokens_out", "cache_read", "cache_write", "retries")
TPC_TEST_RE = re.compile(
    r"(?:^|[\s/])(?:pytest|py\.test|vitest|jest|mocha|rspec|phpunit|tox|nox|xpm-vitest|unittest|go\s+test|cargo\s+test|"
    r"dotnet\s+test|deno\s+test|bun\s+test|playwright\s+test|mvn\s+(?:\S+\s+)*test|gradlew?\s+(?:\S+\s+)*test|"
    r"make\s+(?:\S+\s+)*(?:test|check)|(?:npm|pnpm|yarn)\s+(?:run\s+)?test|python3?\s+(?:-\S+\s+)*\S*test\S*\.py)(?:\s|$)")
TPC_LAND_RE = re.compile(r"\bgit\s+(?:-C\s+\S+\s+)?(?:commit|push|merge)\b|\bgh\s+pr\s+(?:create|merge|ready)\b|land-pr\b|"
                         r"\blander\b|\bdeploy")
TPC_WAKE_RE = re.compile(r"^\s*(?:sleep\s+\d|\S*datastash\s+(?:watch|listen|inbox)\b)")
TPC_EDIT_RE = re.compile(r"\bsed\s+(?:-\S*\s+)*-i|\bperl\s+-\S*i|\btee\b|\bpatch\b|\bgit\s+apply\b|"
                         r"(?<![0-9&>])>{1,2}\s*(?!/dev/null)[^&\s|>]|\.write(?:_text)?\(|open\([^)]*['\"][wa]")
TPC_READ_RE = re.compile(r"^\s*(?:cat|head|tail|less|grep|egrep|rg|find|ls|tree|wc|stat|file|jq|sort|uniq|cut|tr|awk|nl|"
                         r"column|comm|diff|cmp|du|df|date|pwd|which|type|basename|dirname|realpath|readlink|sha256sum|"
                         r"md5sum|sed\s+-n|git\s+(?:-C\s+\S+\s+)?(?:log|show|status|diff|blame|grep|ls-files|branch|"
                         r"rev-parse|remote|fetch|worktree\s+list|describe|tag\s+--list))(?:\s|$)")
TPC_NEUTRAL_RE = re.compile(r"^\s*(?:(?:cd|pushd|popd|export|set|true|echo|printf|:)(?:\s|$)|\d*>?\s*$|"
                            r"[A-Za-z_][A-Za-z0-9_]*=\S*\s*$)")


def tpc_card(text):
    """The first card id in a branch name or a description ("xli-378e" -> "XLI-378"), or None. Ids are letters, a dash
    and digits only, so a sent id never holds a wildcard or an operator."""
    for m in TPC_CARD_RE.finditer(text if isinstance(text, str) else ""):
        if m.group(1).lower() not in TPC_NOT_CARD:
            return f"{m.group(1).upper()}-{int(m.group(2))}"
    return None


def _tpc_hash(*parts):
    return hashlib.sha256("\0".join(str(p) for p in parts).encode("utf-8", "replace")).hexdigest()[:16]


def tpc_bash_kind(cmd):
    """("testing" | "landing" | "wakes" | "read" | None, read target) for one shell command, from its text in memory."""
    if not isinstance(cmd, str):
        return None, None
    segs = [s.strip() for s in _SEG_RE.split(cmd[:100000]) if s.strip() and not TPC_NEUTRAL_RE.match(s)]
    for kind, rx in (("testing", TPC_TEST_RE), ("landing", TPC_LAND_RE)):
        if any(rx.search(s) for s in segs):
            return kind, None
    if TPC_EDIT_RE.search(cmd[:100000]):
        return "coding", None
    if segs and all(TPC_WAKE_RE.search(s) for s in segs):
        return "wakes", None
    if segs and all(TPC_READ_RE.search(s) or lookup_shape(s) for s in segs):
        return "read", _tpc_hash("Bash", " ".join(cmd.split()))
    return None, None


def tpc_tool_kind(name, args):
    """(activity or "read", read target or None) for one tool call."""
    args = args if isinstance(args, dict) else {}
    if name in TPC_EDIT_TOOLS:
        return "coding", None
    if name in TPC_WAKE_TOOLS:
        return "wakes", None
    if name in TPC_AGENT_TOOLS:
        about = f"{args.get('description') or ''} {args.get('subagent_type') or ''}"
        return ("reviewing" if re.search(r"review", about, re.I) else "planning"), None
    if name in ("Bash", "PowerShell"):
        kind, target = tpc_bash_kind(args.get("command"))
        return kind or "planning", target
    if name in TPC_READ_TOOLS:
        what = next((args.get(k) for k in ("file_path", "notebook_path", "url", "pattern", "query", "path") if args.get(k)), "")
        return "read", _tpc_hash(name, what, args.get("path") or "", args.get("glob") or "")
    return "planning", None




class TpcReader:
    """One transcript file's new part, folded per (card, activity, model). Its state (open tool calls, read targets, the
    turn being read, the last input's time) carries over to the next read. Only numbers leave it."""

    def __init__(self, state, card_hint=None, review=False):
        self.st, self.card_hint, self.review = state, card_hint, review
        self.rows, self.cards = {}, {}

    @staticmethod
    def _span(r, ts):
        if ts is not None:
            r["first"] = ts if r.get("first") is None else min(r["first"], ts)
            r["last"] = ts if r.get("last") is None else max(r["last"], ts)
        return r

    def row(self, card, activity, model, ts):
        r = self.rows.setdefault((card, activity, model), {"minutes": 0.0, "calls": 0, "tokens_in": 0, "tokens_out": 0,
                                                           "cache_read": 0, "cache_write": 0, "retries": 0})
        return self._span(r, ts)

    def card_row(self, card, ts):
        return self._span(self.cards.setdefault(card, {"wakes": 0, "retries": 0}), ts)

    def card_of(self, e):
        return (self.card_hint or tpc_card(os.environ.get("DATASTASH_CARD", "")) or tpc_card(e.get("gitBranch"))
                or "no card")

    def activity(self, kind, target):
        if self.review:
            return "reviewing"
        if kind != "read":
            return kind
        seen = self.st.setdefault("seen", [])
        if target in seen:
            return "lookups"
        seen.append(target)
        return "orienting"

    def minutes(self, card, activity, model, secs, ts):
        if secs > 0:
            self.row(card, activity, model, ts)["minutes"] += secs / 60.0

    def mark(self, ts):
        """The latest input or model request so far; it never moves back (a compaction rewrites old times)."""
        if ts is not None:
            self.st["mark"] = ts if self.st.get("mark") is None else max(self.st["mark"], ts)

    def finish_turn(self):
        """The turn being read is complete (or the read ends): its tokens and its active time, from its input (or its
        model request) to its last entry. A wait before its first entry longer than TPC_PAUSE_SECONDS is a pause, left
        out."""
        t = self.st.pop("turn", None)
        if not t:
            return
        activity = t.get("activity") or ("reviewing" if self.review else "wakes" if t.get("wake") else "planning")
        r = self.row(t["card"], activity, t["model"], t.get("end"))
        for col, v in (t.get("usage") or {}).items():
            r[col] += v
        start, first, end = t.get("start"), t.get("first"), t.get("end")
        if first is not None and end is not None:
            secs = max(0.0, end - first)
            if start is not None and 0 <= first - start <= TPC_PAUSE_SECONDS:
                secs += first - start
            self.minutes(t["card"], activity, t["model"], secs, end)
        self.mark(end)

    def entry(self, e):
        if not isinstance(e, dict):
            return
        ts = _week_ts(e.get("timestamp"))
        if e.get("type") == "assistant":
            self.assistant(e, ts)
        elif e.get("type") == "user":
            if e.get("isCompactSummary") or e.get("isVisibleInTranscriptOnly"):
                return  # a compaction's summary carries an old prompt's time: not an input
            self.finish_turn()
            self.user(e, ts)
        elif e.get("type") == "api-request":
            self.mark(ts)  # a model request starts here (after a resume too): the turn's time starts at it at the latest

    def user(self, e, ts):
        st = self.st
        msg = e.get("message") if isinstance(e.get("message"), dict) else {}
        content = msg.get("content")
        results = [c for c in content if isinstance(c, dict) and c.get("type") == "tool_result"] if isinstance(content, list) else []
        if results:
            pd = e.get("permissionDecision") if isinstance(e.get("permissionDecision"), dict) else {}
            asked = str(pd.get("source") or "").startswith("user") or str(e.get("toolDenialKind") or "").startswith("user")
            for c in results:
                call = st.setdefault("open", {}).pop(str(c.get("tool_use_id")), None)
                if call is None:
                    continue
                if c.get("is_error") is True:
                    st["error"] = call["sig"]
                if ts is not None and call["timed"] and not asked:  # the person answered its prompt: not timed
                    since = max(call["ts"], st.get("until") or 0)
                    self.minutes(call["card"], call["activity"], call["model"], ts - since, ts)
                    st["until"] = max(st.get("until") or 0, ts)
            st["wake"] = False
        elif not e.get("isMeta"):
            origin = e.get("origin") if isinstance(e.get("origin"), dict) else {}
            st["wake"] = origin.get("kind") == "task-notification"
            if st["wake"]:
                self.card_row(self.card_of(e), ts)["wakes"] += 1
        self.mark(ts)

    def assistant(self, e, ts):
        st = self.st
        msg = e.get("message") if isinstance(e.get("message"), dict) else {}
        model = re.sub(r"[^A-Za-z0-9._:@/\-]", "", str(msg.get("model") or ""))[:80] or "unknown"
        if model == "synthetic":
            return
        mid = str(msg.get("id") or e.get("requestId") or e.get("uuid") or "")
        card = self.card_of(e)
        if (st.get("turn") or {}).get("id") != mid:
            self.finish_turn()
            if mid and mid in st.setdefault("done", []):
                t = None  # the rest of a turn already counted at an earlier read: its tool calls only
            else:
                u = msg.get("usage") if isinstance(msg.get("usage"), dict) else {}
                usage = {col: u[k] for col, k in (("tokens_in", "input_tokens"), ("tokens_out", "output_tokens"),
                                                  ("cache_read", "cache_read_input_tokens"),
                                                  ("cache_write", "cache_creation_input_tokens"))
                         if isinstance(u.get(k), int) and not isinstance(u.get(k), bool) and u[k] > 0}
                t = st["turn"] = {"id": mid, "card": card, "model": model, "usage": usage, "start": st.get("mark"),
                                  "first": ts, "end": ts, "wake": st.get("wake"), "activity": None}
                st["done"] = (st["done"] + [mid])[-50:]
        else:
            t = st["turn"]
            if ts is not None:
                t["end"] = ts if t.get("end") is None else max(t["end"], ts)
                t["first"] = ts if t.get("first") is None else t["first"]
        blocks = msg.get("content") if isinstance(msg.get("content"), list) else []
        for b in blocks:
            if not isinstance(b, dict) or b.get("type") != "tool_use":
                continue
            name = str(b.get("name") or "")
            args = b.get("input") if isinstance(b.get("input"), dict) else {}
            activity = self.activity(*tpc_tool_kind(name, args))
            r = self.row(card, activity, model, ts)
            r["calls"] += 1
            sig = _tpc_hash(name, json.dumps(args, sort_keys=True, default=str))
            if st.get("error") == sig:
                r["retries"] += 1
                self.card_row(card, ts)["retries"] += 1
            st["error"] = None
            st.setdefault("open", {})[str(b.get("id"))] = {"ts": ts or 0, "card": card, "activity": activity, "model": model,
                                                           "sig": sig, "timed": ts is not None and name not in TPC_AGENT_TOOLS
                                                           and name not in TPC_PERSON_TOOLS}
            if t is not None and t["activity"] is None:
                t["activity"] = activity


def tpc_read(path, fst, card_hint=None, review=False):
    """Read path's complete lines from fst["offset"]; returns (reader, new offset). fst (the file's state) is changed in
    place; the caller keeps it only once the rows were sent."""
    rd = TpcReader(fst, card_hint, review)
    off = int(fst.get("offset") or 0)
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            if f.tell() < off:
                off = 0  # the file was replaced: read it from the start
            f.seek(off)
            while True:
                line = f.readline()
                if not line.endswith(b"\n"):
                    break  # a line still being written: next time
                off += len(line)
                try:
                    rd.entry(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        return rd, int(fst.get("offset") or 0)
    rd.finish_turn()
    return rd, off


def _tpc_iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime(t)) if isinstance(t, (int, float)) else None


def _tpc_projects_root():
    return os.path.realpath(os.path.join(CLAUDE_DIR, "projects"))


def tpc_files(transcript, sid):
    """[(path, card hint, review)] for this session: its main transcript and each of its subagents' files, only regular
    files of this user inside Claude Code's own projects folder."""
    root = _tpc_projects_root()
    out = []
    real = os.path.realpath(transcript) if isinstance(transcript, str) and transcript else ""

    def ok(p):
        try:
            s = os.lstat(p)
        except OSError:
            return False
        return stat.S_ISREG(s.st_mode) and s.st_uid == os.getuid() and os.path.realpath(p).startswith(root + os.sep)
    if real and ok(real):
        out.append((real, None, False))
        sub = os.path.join(os.path.dirname(real), sid or "", "subagents")
        try:
            names = sorted(os.listdir(sub)) if sid else []
        except OSError:
            names = []
        for n in names:
            p = os.path.join(sub, n)
            if not re.fullmatch(r"agent-[A-Za-z0-9_\-]{1,80}\.jsonl", n) or not ok(p):
                continue
            meta = read_json(p[:-len(".jsonl")] + ".meta.json", {})
            about = f"{meta.get('description') or ''} {meta.get('agentType') or ''}"
            out.append((os.path.realpath(p), tpc_card(str(meta.get("description") or "")), bool(re.search(r"review", about, re.I))))
    return out


def tpc_rows(readers, ended, main_card, now, carry=None):
    """The Burn and Cards cost rows for one send: Burn one row per (card, activity, model), Cards cost one per card, and
    the minutes carried to the next send. datastash's {"inc": n} adds whole numbers only, so Burn gets the whole minutes
    and the part of a minute left over is kept here for the next send of this session ({key: [card, activity, model,
    minutes]}); the session's last send (ended) rounds what is left to the nearest minute."""
    cards, merged = {}, {}
    carry = {k: v for k, v in (carry or {}).items() if isinstance(v, list) and len(v) == 4}

    def card(c):
        return cards.setdefault(c, {"card": c})
    for rd, new_sub in readers:
        for (c, activity, model), r in sorted(rd.rows.items()):
            m = merged.setdefault((c, activity, model), {k: 0 for k in TPC_BURN_COUNTS})
            for k in TPC_BURN_COUNTS:
                m[k] += r.get(k) or 0
            if r.get("first") is not None:
                m["first"] = r["first"] if m.get("first") is None else min(m["first"], r["first"])
                m["last"] = r["last"] if m.get("last") is None else max(m["last"], r["last"])
        for c, x in rd.cards.items():
            cr = card(c)
            for col in ("wakes", "retries"):
                if x[col]:
                    cr[col] = {"inc": (cr.get(col) or {}).get("inc", 0) + x[col]}
        if new_sub:
            cr = card(new_sub)
            cr["subagents"] = {"inc": (cr.get("subagents") or {}).get("inc", 0) + 1}
    if ended:  # the rest carried from earlier sends of this session goes out now
        for k, (c, activity, model, _) in carry.items():
            merged.setdefault((c, activity, model), {x: 0 for x in TPC_BURN_COUNTS})
    burn, left = [], {}
    for (c, activity, model), r in sorted(merged.items()):
        key = f"{c} / {TPC_STEP} / {activity} / {model}"
        total = r["minutes"] + float((carry.get(key) or [0, 0, 0, 0])[3] or 0)
        whole = int(math.floor(total + (0.5 if ended else 1e-9)))
        if not ended and total - whole > 1e-9:
            left[key] = [c, activity, model, round(total - whole, 6)]
        counts = {k: int(r[k]) for k in TPC_BURN_COUNTS if k != "minutes"}
        if whole <= 0 and not any(counts.values()):
            continue  # only part of a minute so far: it waits in the carry
        row = {"key": key, "card": c, "step": TPC_STEP, "activity": activity, "model": model, "minutes": {"inc": whole},
               **{k: {"inc": v} for k, v in counts.items()}}
        if r.get("first") is not None:
            row["first_seen"], row["last_seen"] = {"min": _tpc_iso(r["first"])}, {"max": _tpc_iso(r["last"])}
            cr = card(c)
            cr["first_seen"] = {"min": min(_tpc_iso(r["first"]), (cr.get("first_seen") or {}).get("min") or "9")}
            cr["last_seen"] = {"max": max(_tpc_iso(r["last"]), (cr.get("last_seen") or {}).get("max") or "")}
        burn.append(row)
    for key, v in carry.items():  # a key with no new lines this time keeps its carry
        if not ended and key not in left and (v[0], v[1], v[2]) not in merged:
            left[key] = v
    if ended:
        cr = card(main_card or "no card")
        cr["sessions"] = {"inc": 1}
        cr.setdefault("last_seen", {"max": _tpc_iso(now)})
    return burn, [cards[c] for c in sorted(cards)], left


def _tpc_state_path(sid):
    return os.path.join(STATE, f"tpc-{sid}.json")


def _tpc_card_tab(wb):
    """The per-card tab saved for this workbook at `on`, else "Cards cost"."""
    t = (_tpc_settings().get("card_tabs") or {}).get(str(wb or "").lower())
    return t if _tpc_card_tab_ok(t) else TPC_CARDS


def _tpc_card_tab_ok(t):
    return isinstance(t, str) and 0 < len(t) <= 100 and t == t.strip() and not any(ord(c) < 32 or ord(c) == 127 for c in t)


def _tpc_cards(client):
    return getattr(client, "cards_tab", None) or TPC_CARDS


def _tpc_fold_ready(client):
    """True only when Cards cost has every folded_* column (x-live #486). An older Cards cost tab is never folded: its
    Burn rows stay and are only added to, so no total can drop."""
    body = client.tool("ledger_rows_filter", {"workbook_id": client.wb, "tab": _tpc_cards(client), "where": {"ne": ["card", ""]},
                                              "columns": ["card", *TPC_FOLDED], "limit": 1}, "checking Cards cost", soft=True)
    return body is not None


def tpc_fold(client, keep, journal_path):
    """Past TPC_FOLD_AT Burn rows, fold finished cards (oldest last_seen first, never one in `keep`, only ones not folded
    before) until Burn is back at the limit, and only on a Cards cost tab with the folded_* columns. A card's fold: its
    Burn rows' sums written to its folded_* cells (plain values: a card is folded once, so a replay writes the same
    numbers, and a card whose folded_* cells are already set is never written again), then those rows deleted. A fold cut
    short is finished first on the next run (the journal), however late, so nothing counts twice. One fold per workbook
    at a time (a lock beside the journal). Returns the cards folded."""
    lock = open(journal_path + ".lock", "a")
    try:
        if fcntl is not None:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return []  # another send is folding this workbook now
        ready = None
        j = read_json(journal_path, None)
        if isinstance(j, dict) and isinstance(j.get("row"), dict) and isinstance(j.get("keys"), list):
            ready = _tpc_fold_ready(client)
            if not ready:
                return []
            _tpc_fold_apply(client, j, journal_path)
            _drop(journal_path)
        body = client.tool("ledger_rows_filter", {"workbook_id": client.wb, "tab": TPC_BURN, "where": {"ne": ["key", ""]},
                                                  "limit": 1}, "counting Burn", missing_ok=True)
        n = int(_ci_num((body or {}).get("rows_matched")))
        folded = []
        if n <= TPC_FOLD_AT or not (ready if ready is not None else _tpc_fold_ready(client)):
            return folded
        oldest = client.filter(_tpc_cards(client), {"blank": ["folded_tokens"]}, order=[{"column": "last_seen", "dir": "asc"}], pages=1)
        for c in oldest:
            card = c.get("card")
            if not isinstance(card, str) or not card or card in keep:
                continue
            rows = [r for r in client.filter(TPC_BURN, {"eq": ["card", card]}) if isinstance(r.get("key"), str)]
            if not rows:
                continue
            tot = {k: 0.0 for k in TPC_FOLDED}
            for r in rows:
                toks = r.get("tokens")
                toks = toks if isinstance(toks, (int, float)) and not isinstance(toks, bool) else sum(
                    _ci_num(r.get(k)) for k in ("tokens_in", "tokens_out", "cache_read", "cache_write"))
                tot["folded_minutes"] += _ci_num(r.get("minutes"))
                tot["folded_calls"] += _ci_num(r.get("calls"))
                tot["folded_tokens"] += toks
                if r.get("activity") in TPC_PROGRESS:
                    tot["folded_progress_tokens"] += toks
                cost = r.get("est_cost")
                if isinstance(cost, (int, float)) and not isinstance(cost, bool):
                    tot["folded_est_cost"] += cost  # the engine's value at fold time (no Prices row yet: none)
            keys = sorted(r["key"] for r in rows)
            snap = {r["key"]: {k: _ci_num(r.get(k)) for k in TPC_BURN_COUNTS} for r in rows}
            row = {"card": card, **{k: round(v, 6) for k, v in tot.items()}}
            j = {"row": row, "keys": keys, "snap": snap, "done": [],
                 "idem": "tpc-fold-" + _tpc_hash(card, *keys, json.dumps(row, sort_keys=True))}
            write_private(journal_path, json.dumps(j))
            _tpc_fold_apply(client, j, journal_path)
            _drop(journal_path)
            folded.append(card)
            n -= len(keys)
            if n <= TPC_FOLD_AT:
                break
        return folded
    finally:
        lock.close()


def _tpc_fold_apply(client, j, journal_path):
    """One card's fold, from its journal: the folded_* cells (only when none is set yet), then each Burn row deleted if it
    still holds what was folded; a row that took more since (another session) gives back only what was folded."""
    card = j["row"]["card"]
    now = client.filter(_tpc_cards(client), {"eq": ["card", card]}, pages=1)
    if not any(r.get(k) not in (None, "") for r in now for k in TPC_FOLDED):
        client.tool("ledger_rows_upsert", {"workbook_id": client.wb, "tab": _tpc_cards(client), "rows": [j["row"]], "key": "card",
                                           "idempotency_key": j["idem"]}, "folding a card")
    done = j.setdefault("done", [])
    snaps = j.get("snap") if isinstance(j.get("snap"), dict) else {}
    have = {r["key"]: r for r in client.filter(TPC_BURN, {"eq": ["card", card]}) if isinstance(r.get("key"), str)}
    gone, back = [], []
    for k in j["keys"]:
        if k in done or k not in have:
            continue
        snap = snaps.get(k)
        if not isinstance(snap, dict) or all(abs(_ci_num(have[k].get(c)) - _ci_num(v)) < 1e-9 for c, v in snap.items()):
            gone.append(k)
        else:
            back.append({"key": k, **{c: {"inc": -int(round(_ci_num(v)))} for c, v in snap.items() if int(round(_ci_num(v)))}})
    for i in range(0, len(gone), CI_PAGE):
        client.tool("ledger_rows_delete", {"workbook_id": client.wb, "tab": TPC_BURN, "keys": gone[i:i + CI_PAGE]},
                    "folding a card")
        done += gone[i:i + CI_PAGE]
        write_private(journal_path, json.dumps(j))
    for i in range(0, len(back), CI_PAGE):
        client.tool("ledger_rows_upsert", {"workbook_id": client.wb, "tab": TPC_BURN, "rows": back[i:i + CI_PAGE], "key": "key",
                                           "idempotency_key": f"{j['idem']}-back-{i // CI_PAGE}"}, "folding a card")
        done += [r["key"] for r in back[i:i + CI_PAGE]]
        write_private(journal_path, json.dumps(j))


def tpc_run(sid, transcript, ended, key, wb, now=None):
    """One send for this session: first any send of this workbook left pending (this session's, then other sessions'),
    then read what is new, send it, then fold if Burn is past the limit. Returns a summary."""
    now = time.time() if now is None else now
    path = _tpc_state_path(sid)
    lock = open(path + ".lock", "a")
    try:
        deadline = time.time() + TPC_LOCK_SECONDS
        while fcntl is not None:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except OSError:
                if time.time() > deadline:
                    raise CiProblem("another send for this session is still running")
                time.sleep(0.5)
        state = read_json(path, {})
        files = state.setdefault("files", {})
        client = CiClient(key, wb, time.time() + TPC_WAIT_SECONDS)
        client.cards_tab = _tpc_card_tab(wb)

        def save():
            write_private(path, json.dumps(state))
        pend = state.get("pending")
        if isinstance(pend, dict):  # a send that did not finish: its parts not yet taken, same rows and keys, then its offsets
            _tpc_finish_pending(client, state, pend, save)
            files = state["files"]
        retried = tpc_retry_pending(client, wb, sid)
        new_files = json.loads(json.dumps(files))
        readers, main_card, sent = [], state.get("main_card"), {"burn": 0, "cards": 0}
        todo = tpc_files(transcript, sid)
        if not todo:  # no transcript of this user inside Claude Code's projects folder: nothing is read or sent
            return dict(sent, folded=[], fold_problem=None, retried=retried)
        for p, hint, review in todo:
            fst = new_files.setdefault(p, {"offset": 0})
            start = int(fst.get("offset") or 0)
            rd, off = tpc_read(p, fst, hint, review)
            fst["offset"] = off
            new_sub = None
            if p != os.path.realpath(transcript) and not fst.get("counted") and (rd.rows or off):
                fst["counted"] = True
                new_sub = hint or (sorted(rd.rows)[0][0] if rd.rows else "no card")
            if p == os.path.realpath(transcript) and rd.rows:
                main_card = max(rd.rows.items(), key=lambda kv: kv[1].get("last") or 0)[0][0]
            readers.append((rd, new_sub))
            fst["read_from"] = start
        burn, cards, carry = tpc_rows(readers, ended, main_card, now, state.get("carry"))
        tag = "tpc-" + _tpc_hash(sid, json.dumps(sorted((p, f.get("read_from"), f.get("offset")) for p, f in new_files.items())),
                                 bool(ended))
        pend = {"tag": tag, "wb": wb, "burn": burn, "cards": cards, "files": new_files, "carry": carry, "done": []}
        if burn or cards:
            state["pending"] = pend
            save()
            _tpc_send(client, pend, save)
            sent = {"burn": len(burn), "cards": len(cards)}
        state.pop("pending", None)
        state["files"], state["main_card"], state["carry"] = new_files, main_card, carry
        save()
        folded, fold_problem = [], None
        if burn:
            try:
                folded = tpc_fold(client, {c["card"] for c in cards}, os.path.join(STATE, f"tpc-fold-{wb}.json"))
            except CiProblem as e:  # the rows are sent; the fold is tried again at the next send
                fold_problem = str(e)
        return dict(sent, folded=folded, fold_problem=fold_problem, retried=retried)
    finally:
        lock.close()


def _tpc_finish_pending(client, state, pend, save):
    """Send what is left of a pending send, then move its offsets and carry into the state and drop it."""
    _tpc_send(client, pend, save)
    state["files"] = pend.get("files") if isinstance(pend.get("files"), dict) else state.get("files") or {}
    if isinstance(pend.get("carry"), dict):
        state["carry"] = pend["carry"]
    state.pop("pending", None)
    save()


def tpc_retry_pending(client, wb, own_sid):
    """Other sessions' sends to this workbook left pending (a session-end send that failed has no later hook of its own):
    each is finished under that session's own lock, skipped while that session's run holds it. Parts already taken are
    never sent again. A problem stops the retries for now (the next send tries again). Returns how many were finished."""
    n = 0
    try:
        names = sorted(os.listdir(STATE))
    except OSError:
        return 0
    for name in names:
        m = re.fullmatch(r"tpc-(" + SID_RE + r")\.json", name)
        if not m or m.group(1) == own_sid or m.group(1).startswith("fold-"):
            continue
        path = os.path.join(STATE, name)
        p = read_json(path, {}).get("pending")
        if not isinstance(p, dict) or p.get("wb") != wb:
            continue
        lock = open(path + ".lock", "a")
        try:
            if fcntl is not None:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except OSError:
                    continue
            st = read_json(path, {})  # again, under its lock
            p = st.get("pending")
            if not isinstance(p, dict) or p.get("wb") != wb:
                continue
            try:
                _tpc_finish_pending(client, st, p, lambda st=st, path=path: write_private(path, json.dumps(st)))
            except CiProblem:
                break
            n += 1
        finally:
            lock.close()
    return n


def _tpc_send(client, pend, save):
    """The pending send's parts not taken yet, in order. Each part is marked done (and saved) once datastash took it, so
    a retry, however late (past the idempotency window too), never sends a part twice."""
    done = pend.setdefault("done", [])
    parts = [(f"b-{i // CI_PAGE}", TPC_BURN, "key", pend["burn"][i:i + CI_PAGE]) for i in range(0, len(pend.get("burn") or []), CI_PAGE)]
    parts += [(f"c-{i // CI_PAGE}", _tpc_cards(client), "card", pend["cards"][i:i + CI_PAGE])
              for i in range(0, len(pend.get("cards") or []), CI_PAGE)]
    for pid, tab, keycol, rows in parts:
        if pid in done:
            continue
        client.tool("ledger_rows_upsert", {"workbook_id": client.wb, "tab": tab, "rows": rows, "key": keycol,
                                           "idempotency_key": f"{pend['tag']}-{pid}"}, f"writing {tab}")
        done.append(pid)
        save()


class TpcUnreadable(Exception):
    """time-per-card.json is there but can't be read, parsed, or has an unexpected shape: every folder counts as chose off
    for this run, no default is applied and nothing rewrites the file (fail closed, plugin 1.0.12 review)."""


_TPC_UNREADABLE = []  # why the latest read of the file failed in this run, for the one log line


def _tpc_read():
    """(settings, None) from a file read cleanly (a missing file reads as empty: nobody chose), else (None, why)."""
    try:
        with open(TPC_PATH, "rb") as f:
            raw = f.read()
    except FileNotFoundError:
        return {"projects": {}}, None
    except OSError as e:
        return None, f"can't be read ({type(e).__name__})"
    try:
        s = json.loads(raw.decode("utf-8"))
    except ValueError:
        return None, "is not valid JSON" if raw.strip() else "is empty"
    if not isinstance(s, dict) or not isinstance(s.get("projects"), dict):
        return None, "has an unexpected shape"
    if any(not isinstance(v, dict) or not isinstance(v.get("on"), bool) for v in s["projects"].values()):
        return None, "has an unexpected shape"
    if any(k in s and not isinstance(s[k], dict) for k in ("card_tabs", "default_tried")):
        return None, "has an unexpected shape"
    return s, None


def _tpc_settings():
    """The settings read cleanly, or a view where nothing is set (callers that decide on or off use tpc_choice)."""
    s, why = _tpc_read()
    _TPC_UNREADABLE[:] = [] if why is None else [why]  # the latest read decides
    if why is not None:
        return {"projects": {}, "unreadable": why}
    return s


def tpc_unreadable_line():
    """The one plain log line for a run that found the settings file unreadable, or None."""
    if not _TPC_UNREADABLE:
        return None
    return (f"time per card: the settings file time-per-card.json {_TPC_UNREADABLE[0]}, so time per card was left off "
            f"for every folder in this run and the file was not changed")


def tpc_choice(folder):
    """This folder's own choice: "on", "off", or None when nobody chose here (plugin 1.0.12: on by default). An unreadable
    or odd settings file means "off" for every folder (fail closed)."""
    s = _tpc_settings()
    if "unreadable" in s:
        return "off"
    got = s["projects"].get(os.path.realpath(folder))
    if got is None:
        return None
    return "on" if got["on"] is True else "off"


def tpc_is_on(folder):
    """On unless the folder chose off: a typed `off` is kept for good (owner 11-24: time per card ships on)."""
    return tpc_choice(folder) != "off"


def _tpc_update(fn):
    """Read, change and write the settings under one lock, so a typed choice and a default never overwrite each other.
    The write is atomic (a temp file, then a rename), so a crash or a reader never sees half a file. A file that can't be
    read cleanly is never rewritten: TpcUnreadable."""
    ensure_dirs()
    lock = open(TPC_PATH + ".lock", "a")
    try:
        if fcntl is not None:
            fcntl.flock(lock, fcntl.LOCK_EX)
        s = _tpc_settings()
        if "unreadable" in s:
            raise TpcUnreadable(s["unreadable"])
        out = fn(s)
        write_private(TPC_PATH, json.dumps(s))
        return out
    finally:
        lock.close()


def _tpc_setup(agent, key):
    """ledger_feeds_setup services ["burn"] (tabs Burn, Time per card and Prices): (feed, None) or (None, why not)."""
    try:
        is_err, body = mcp_tool(key, "ledger_feeds_setup", {"workbook_id": agent["workbook_id"], "services": ["burn"]})
    except (OSError, ValueError, ApiError, httpclient.HTTPException) as e:
        return None, f"datastash can't be reached ({ci_clean(e, 120)})"
    feed = next((f for f in body.get("feeds") or [] if isinstance(f, dict) and f.get("service") == "burn"), {})
    if is_err or feed.get("ok") is not True:
        return None, f"the tabs were not set up ({ci_clean(feed.get('message') or body.get('message') or body.get('code'), 200)})"
    return feed, None


def _tpc_save_tab(s, agent, feed):
    if _tpc_card_tab_ok(feed.get("card_tab")):  # the per-card tab this workbook has (x-live #487)
        tabs = s.get("card_tabs") if isinstance(s.get("card_tabs"), dict) else {}
        tabs[str(agent["workbook_id"]).lower()] = feed["card_tab"]
        s["card_tabs"] = tabs


TPC_DEFAULT_RETRY = 3600.0  # a default set-up that failed is tried again at most once an hour


def tpc_default_due(folder):
    """True when this folder never chose and its tabs are not set up yet (and no set-up failed in the last hour)."""
    folder = os.path.realpath(folder)
    if tpc_choice(folder) is not None:
        return False
    tried = (_tpc_settings().get("default_tried") or {}).get(folder)
    return not isinstance(tried, (int, float)) or time.time() - tried >= TPC_DEFAULT_RETRY


def tpc_default_on(folder, agent, key):
    """The default for a folder that never chose: set the tabs up as `on` does, then save it as on (by default). A
    choice typed meanwhile wins. (True, None) when it is on now, else (False, why not)."""
    folder = os.path.realpath(folder)
    choice = tpc_choice(folder)
    if _TPC_UNREADABLE:
        return False, tpc_unreadable_line()
    if choice is not None:
        return choice == "on", None
    feed, why = _tpc_setup(agent, key)

    def save(s):
        # The default only adds a new folder entry; it never rewrites or drops one that is there.
        if folder in s["projects"]:
            return s["projects"][folder]["on"] is True  # the person chose meanwhile: theirs stands
        if feed is None:
            tried = s.get("default_tried", {})
            tried[folder] = int(time.time())
            s["default_tried"] = tried
            return False
        s["projects"][folder] = {"on": True, "at": int(time.time()), "by": "default"}
        if str(agent["workbook_id"]).lower() not in s.get("card_tabs", {}):
            _tpc_save_tab(s, agent, feed)
        return True

    try:
        on = _tpc_update(save)
    except TpcUnreadable:
        return False, tpc_unreadable_line()
    return on, (None if on else why or "the folder chose off")


def tpc_install_kick(inp):
    """After /datastash:install: set up time per card for this session's agent in the background (on by default), when
    its folder never chose. Never fails or slows the install."""
    try:
        own = _own_agent(inp)
        folder = os.path.realpath(project_of(inp))
        if own is None or off_here(inp) or not read_key(own["slug"]) or not tpc_default_due(folder):
            return
        spawn_detached([sys.executable, os.path.realpath(__file__), "time-per-card", "setup", own["slug"]], folder)
    except Exception:  # noqa: BLE001 the install's answer never depends on it
        pass


def cmd_time_per_card(args):
    """`datastash time-per-card [on|off]`: this folder's choice (on by default; a typed off is kept); on also sets up the tabs. The hook entry
    points (`hook`, `run`) are run by Claude Code and by the hook itself."""
    sub = args[0] if args else ""
    if sub == "hook":
        return _tpc_hook()
    if sub == "run":
        return _tpc_bg(args[1:])
    if sub == "setup":
        return _tpc_bg_setup(args[1:])
    if sub in ("-h", "--help") or sub not in ("", "on", "off"):
        print(TPC_USAGE)
        return 0 if sub in ("-h", "--help") else 1
    folder = os.path.realpath(project_of({}))
    if "unreadable" in _tpc_settings():
        print(f"time per card: the settings file {TPC_PATH} {_TPC_UNREADABLE[0]}, so time per card is left off for every "
              f"folder and nothing changed. Fix or move that file, then choose again. {TPC_USAGE}")
        return 0 if sub == "" else 1
    if sub == "":
        how = {"on": "on", "off": "off"}.get(tpc_choice(folder), "on (by default)")
        print(f"time per card is {how} for this folder. {TPC_USAGE}")
        return 0
    agent = _own_agent({})
    if sub == "on":
        key = read_key(agent["slug"]) if agent else None
        if agent is None or not key:
            print("time per card: this folder has no datastash agent with a key yet; nothing changed")
            return 1
        feed, why = _tpc_setup(agent, key)
        if feed is None:
            print(f"time per card: {why}; nothing changed")
            return 1

    def save(s):
        s["projects"][folder] = {"on": sub == "on", "at": int(time.time())}  # the person's own choice, kept for good
        if sub == "on":
            _tpc_save_tab(s, agent, feed)

    try:
        _tpc_update(save)
    except TpcUnreadable as e:
        print(f"time per card: the settings file {TPC_PATH} {e}, so time per card is left off for every folder and "
              f"nothing changed. Fix or move that file, then choose again.")
        return 1
    if sub == "on":
        print(f'time per card is on for this folder: at each subagent stop and session end, minutes, tool calls and token '
              f'counts per card, activity and model go to "{disp(agent["name"])}"\'s workbook (tab Burn, and one total row '
              f'per card worked out by the engine; a price per model in the Prices tab weighs models against each other). '
              f'Only counts, model names, activity labels and card ids are sent, never prompt, code or command text. '
              f'To stop: datastash time-per-card off')
    else:
        print("time per card is off for this folder: nothing more is read or sent. To start again: datastash time-per-card on")
    return 0


def _tpc_hook():
    """SessionStart, SubagentStop and SessionEnd: when this folder is on, start the background send and return at once
    (at a session start it finishes any send an earlier session left pending, e.g. a failed session-end send)."""
    inp = hook_input()
    try:
        folder = project_of(inp)
        sid, tp = inp.get("session_id"), inp.get("transcript_path")
        on = tpc_is_on(folder)
        if _TPC_UNREADABLE:  # fail closed: off for every folder this run, one plain line in the agent's log
            agent = _own_agent(inp)
            if agent is not None:
                log(agent["slug"], tpc_unreadable_line())
            return 0
        if not on or not isinstance(sid, str) or not re.fullmatch(SID_RE, sid) or not isinstance(tp, str):
            return 0
        agent = _own_agent(inp)
        if agent is None or not read_key(agent["slug"]):
            return 0
        if tpc_choice(folder) is None and (off_here(inp) or not tpc_default_due(folder)):
            return 0  # never chose: on by default, but never in an off folder, and a failed set-up waits an hour
        ended = "1" if inp.get("hook_event_name") == "SessionEnd" else "0"
        spawn_detached([sys.executable, os.path.realpath(__file__), "time-per-card", "run", agent["slug"], sid, tp, ended],
                       os.path.realpath(folder))
    except Exception:  # noqa: BLE001 a hook never fails a session
        pass
    return 0


def _tpc_bg(args):
    """The background send: one line in the agent's log, never an error out of it."""
    if len(args) != 4 or not re.fullmatch(r"[a-z0-9][a-z0-9\-]{0,63}", args[0]) or not re.fullmatch(SID_RE, args[1]):
        return 1
    s, sid, tp, ended = args
    try:
        agent = read_json(conf_path(s), None)
        key = read_key(s)
        if not agent or not key or not CI_WB_RE.fullmatch(str(agent.get("workbook_id") or "")):
            return 0
        ensure_dirs()
        choice = tpc_choice(os.getcwd())
        if _TPC_UNREADABLE:
            raise TpcUnreadable(tpc_unreadable_line())
        if choice == "off":
            raise CiProblem("this folder chose off")
        if choice is None:  # never chose: on by default once the tabs are set up (plugin 1.0.12)
            on, why = tpc_default_on(os.getcwd(), agent, key)
            if not on and _TPC_UNREADABLE:
                raise TpcUnreadable(why)
            if not on:
                raise CiProblem(f"time per card is not set up yet: {why}")
        r = tpc_run(sid, tp, ended == "1", key, agent["workbook_id"].lower())
        line = f"time per card: sent {r['burn']} Burn and {r['cards']} {_tpc_card_tab(agent['workbook_id'])} rows" + \
               (f"; finished {r['retried']} earlier sends" if r.get("retried") else "") + \
               (f"; folded {len(r['folded'])} finished cards" if r["folded"] else "") + \
               (f"; fold not done: {ci_clean(r['fold_problem'], 200)}" if r["fold_problem"] else "")
    except TpcUnreadable:
        line = tpc_unreadable_line()
    except CiProblem as e:
        line = f"time per card: not sent: {ci_clean(e, 300)}"
    except Exception as e:  # noqa: BLE001
        line = f"time per card: not sent: unexpected {type(e).__name__}"
    try:
        with open(log_path(s), "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + line + "\n")
    except OSError:
        pass
    return 0


def _tpc_bg_setup(args):
    """The install's background set-up (on by default): one line in the agent's log, never an error out of it."""
    if len(args) != 1 or not re.fullmatch(r"[a-z0-9][a-z0-9\-]{0,63}", args[0]):
        return 1
    s = args[0]
    try:
        agent = read_json(conf_path(s), None)
        key = read_key(s)
        if not agent or not key or not CI_WB_RE.fullmatch(str(agent.get("workbook_id") or "")):
            return 0
        on, why = tpc_default_on(os.getcwd(), agent, key)
        line = "time per card: on by default; tabs set up" if on else \
            (tpc_unreadable_line() or f"time per card: not set up: {ci_clean(why, 300)}")
    except Exception as e:  # noqa: BLE001
        line = f"time per card: not set up: unexpected {type(e).__name__}"
    try:
        with open(log_path(s), "a") as f:
            f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + line + "\n")
    except OSError:
        pass
    return 0


# --- XLI-392 N2: the step heartbeat (EPM 11-23: a heartbeat with no model). While a session of this folder's agent uses
# tools, the PostToolUse hook touches the agent's step row: POST /api/v1/agent/rows/touch (x-live #484) sets the row's
# last_seen (or the named column) to now on the row with that key, and only there; datastash never adds a row for a
# touch (no such row: 404, nothing written), and the plugin sends nothing else. At most once per STEP_TOUCH_SECONDS per
# folder and step, from a detached background run, so a tool call is never slowed. The step is named by
# `datastash heartbeat STEP [--tab TAB] [--column COLUMN]` in the folder (or DATASTASH_STEP / DATASTASH_STEP_TAB in the
# session's environment); `datastash heartbeat off` stops it. Never in the person's main session, an off or a private
# folder. With N1 (a deadline on a row) this makes "quiet for N minutes" mean no tool use for N minutes.
STEP_TOUCH_PATH = "/api/v1/agent/rows/touch"
STEP_CONF = os.path.join(CONF, "heartbeat.json")  # {"projects": {folder: {"key", "tab", "column", "at"}}}
STEP_TOUCH_SECONDS = 60.0
STEP_TAB_DEFAULT = "Card steps"
STEP_USAGE = ("usage: datastash heartbeat [STEP [--tab TAB] [--column COLUMN] | off]   (touch STEP's row in TAB, default "
              f'"{STEP_TAB_DEFAULT}", column last_seen, while this folder\'s agent uses tools)')
STEP_NAME_RE = re.compile(r"[^\x00-\x1f\x7f]{1,200}")


def _step_settings():
    s = read_json(STEP_CONF, {})
    return s if isinstance(s.get("projects"), dict) else {"projects": {}}


def step_for(folder):
    """{"key", "tab", "column"} for this folder's heartbeat, or None. DATASTASH_STEP (and DATASTASH_STEP_TAB) win."""
    env = os.environ.get("DATASTASH_STEP", "").strip()
    if env:
        st = {"key": env, "tab": os.environ.get("DATASTASH_STEP_TAB", "").strip() or STEP_TAB_DEFAULT, "column": "last_seen"}
    else:
        st = _step_settings()["projects"].get(os.path.realpath(folder))
    if not isinstance(st, dict) or not all(isinstance(st.get(k), str) and STEP_NAME_RE.fullmatch(st[k])
                                           for k in ("key", "tab", "column")):
        return None
    return {k: st[k] for k in ("key", "tab", "column")}


def step_touch_hook(inp):
    """PostToolUse (from _agent_tool): when this folder's agent has a step, start a touch at most every
    STEP_TOUCH_SECONDS. Never raises, never prints."""
    try:
        if not isinstance(inp, dict) or inp.get("hook_event_name") != "PostToolUse":
            return
        folder = project_of(inp)
        st = step_for(folder)
        if st is None or off_here(inp) or private_here(inp):
            return
        agent = _own_agent(inp)
        if agent is None or not read_key(agent["slug"]):
            return
        stamp = os.path.join(STATE, "step-touch-" + _tpc_hash(agent["slug"], st["tab"], st["key"], st["column"]) + ".json")
        try:
            if time.time() - os.stat(stamp).st_mtime < STEP_TOUCH_SECONDS:
                return
        except OSError:
            pass
        ensure_dirs()
        last = read_json(stamp, {}).get("last")
        write_private(stamp, json.dumps({"at": int(time.time()), "last": last}))  # first, so a burst starts one touch
        spawn_detached([sys.executable, os.path.realpath(__file__), "heartbeat", "run", agent["slug"], stamp],
                       os.path.realpath(folder))
    except Exception:  # noqa: BLE001 a hook never fails a session
        pass


def step_touch(key, wb, st):
    """One touch: "ok", "no row" (404: nothing was added), or a short problem word. Only the touch route is called."""
    try:
        api_json("POST", STEP_TOUCH_PATH, key, body={"workbook_id": wb, "tab": st["tab"], "key": st["key"],
                                                     "column": st["column"]}, timeout=20)
        return "ok"
    except ApiError as e:
        return "no row" if e.status == 404 else f"HTTP {e.status}"
    except (OSError, ValueError, httpclient.HTTPException):
        return "unreachable"


def _step_bg(args):
    """The background touch: one log line only when the outcome changed (a new problem, or ok again)."""
    if len(args) != 2 or not re.fullmatch(r"[a-z0-9][a-z0-9\-]{0,63}", args[0]) \
            or os.path.dirname(os.path.realpath(args[1])) != os.path.realpath(STATE) \
            or not re.fullmatch(r"step-touch-[0-9a-f]{16}\.json", os.path.basename(args[1])):
        return 1
    s, stamp = args
    try:
        agent = read_json(conf_path(s), None)
        key = read_key(s)
        folder = os.getcwd()
        st = step_for(folder)
        if not agent or not key or st is None or not CI_WB_RE.fullmatch(str(agent.get("workbook_id") or "")):
            return 0
        out = step_touch(key, agent["workbook_id"].lower(), st)
        rec = read_json(stamp, {})
        if rec.get("last") != out:
            write_private(stamp, json.dumps({"at": int(time.time()), "last": out}))
            line = "heartbeat: touching the step row again" if out == "ok" else (
                f"heartbeat: no row {disp(st['key'])} in {disp(st['tab'])}; nothing added (add the step row first)"
                if out == "no row" else f"heartbeat: not touched ({out})")
            with open(log_path(s), "a") as f:
                f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + line + "\n")
    except Exception:  # noqa: BLE001
        pass
    return 0


def cmd_heartbeat(args):
    """`datastash heartbeat [STEP [--tab TAB] [--column COLUMN] | off]`: this folder's step heartbeat."""
    if args and args[0] == "run":
        return _step_bg(args[1:])
    if args and args[0] in ("-h", "--help"):
        print(STEP_USAGE)
        return 0
    folder = os.path.realpath(project_of({}))
    if not args:
        st = step_for(folder)
        print(f'heartbeat is on for this folder: step "{disp(st["key"])}" in tab "{disp(st["tab"])}", column '
              f'{disp(st["column"])}' if st else f"heartbeat is off for this folder. {STEP_USAGE}")
        return 0
    s = _step_settings()
    if args == ["off"]:
        s["projects"].pop(folder, None)
        ensure_dirs()
        write_private(STEP_CONF, json.dumps(s))
        print("heartbeat is off for this folder: no step row is touched")
        return 0
    step, tab, column, rest = args[0], STEP_TAB_DEFAULT, "last_seen", args[1:]
    while rest:
        if rest[0] in ("--tab", "--column") and len(rest) > 1:
            tab, column = (rest[1], column) if rest[0] == "--tab" else (tab, rest[1])
            rest = rest[2:]
        else:
            print(STEP_USAGE)
            return 1
    if not all(STEP_NAME_RE.fullmatch(x) and x.strip() for x in (step, tab, column)) or step.startswith("-"):
        print(STEP_USAGE)
        return 1
    if _own_agent({}) is None:
        print("heartbeat: this folder has no datastash agent; nothing changed")
        return 1
    s["projects"][folder] = {"key": step, "tab": tab, "column": column, "at": int(time.time())}
    ensure_dirs()
    write_private(STEP_CONF, json.dumps(s))
    print(f'heartbeat is on for this folder: while this agent uses tools, the row "{disp(step)}" in tab "{disp(tab)}" '
          f'gets {disp(column)} set to now, at most once a minute; a touch never adds a row (add the step row first). '
          f'To stop: datastash heartbeat off')
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    args = sys.argv[2:]
    table = {"fetch": cmd_fetch, "link": cmd_link, "status": cmd_status, "api": cmd_api, "off": cmd_off,
             "watch": cmd_watch, "check": cmd_check, "listen": cmd_listen, "end": cmd_end, "reply": cmd_reply,
             "send": cmd_send, "main": cmd_main, "prompt": cmd_prompt, "auto-name": cmd_auto_name, "list": cmd_list,
             "read": cmd_read, "filter": cmd_filter, "agent-tool": cmd_agent_tool, "doctor": cmd_doctor,
             "login": cmd_login, "logout": cmd_logout, "token": cmd_token, "unfilter": lambda a: cmd_filter(a, hidden=False),
             "status-set": cmd_status_set, "status-send": cmd_status_send, "status-check": cmd_status_check,
             "status-verify": cmd_status_verify, "keep": cmd_keep, "lookups": cmd_lookups, "week": cmd_week,
             "where": cmd_where, "file": cmd_file, "map-refresh": cmd_map_refresh,
             "fingerprint": cmd_fingerprint, "self-update": cmd_self_update, "ci-report": cmd_ci_report, "eval-report": cmd_eval_report, "xlsx-test": cmd_xlsx_test,
             "time-per-card": cmd_time_per_card, "heartbeat": cmd_heartbeat}
    if cmd not in table:
        print(__doc__)
        return 0 if cmd in ("help", "-h", "--help") else 1
    try:
        # Decided before anything of this run writes into the plugin's folder (fresh vs updated); the connector's
        # helper waits only briefly on the decision's lock.
        signin_state(wait=SIGNIN_HELPER_WAIT if cmd == "token" else 2)
    except Exception:
        pass
    return table[cmd](args)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
