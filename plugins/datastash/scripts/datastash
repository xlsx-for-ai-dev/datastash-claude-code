# Owner 11-25: two lines join the list once their server cards are live, each gated (shown only when its gate is on, in
# the same place as the server's one list, src/agents/feature-list.ts): (group, the line it goes after, name, text, gate).
FEATURES_GATED = (
    ("Seeing your agents", "Morning update", "Show asks", "every open ask across all your agents in one list.",
     "XLI-415"),
    ("Cost", "Time per card", "Show DDS stats", "your agents, what they used, and the time datastash saved you, any time.",
     "card 8b"),
)
FEATURES_LIVE = frozenset({"card 8b", "XLI-415"})  # the gates that are live on prod; add one here when its card ships (card 8b: 1.0.19; XLI-415 with it)


def features():
    """FEATURES with each gated line whose gate is live, in its place."""
    out = []
    for head, items in FEATURES:
        items = list(items)
        for g, after, n, t, gate in FEATURES_GATED:
            if g == head and gate in FEATURES_LIVE:
                at = next((i + 1 for i, (x, _t) in enumerate(items) if x == after), len(items))
                items.insert(at, (n, t))
        out.append((head, tuple(items)))
    return tuple(out)


def features_post():
    """The feature list as the person reads it: a header, then one "- **Name:** what it does" bullet per line."""
    return "\n\n".join(head + "\n" + "\n".join(f"  - **{n}:** {t}" for n, t in items) for head, items in features())


