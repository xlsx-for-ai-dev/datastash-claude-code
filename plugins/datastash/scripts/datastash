                         r"(?:npm|pnpm|yarn|bun)(?: run)? test|make test|python3? (?:-\w+ )*-m (?:pytest|unittest)|"
                         r"python3? (?:-\w+ )*\S*test\w*\.py)(?:$|[\s;&|)])")


_CUT = [True]  # False while building what is sent: the agent's words go up whole (no new size caps)


def _clean(v, n=600):
    """Agent-written text made safe to show on one line: no control characters, spaces collapsed, at most n characters
    (only for showing; what is sent and stored on the server is never cut)."""
    if v is None or isinstance(v, (dict, list, bool)):
        return ""
    if not _CUT[0]:
        n = 10 ** 9
    t = re.sub(r"\s+", " ", re.sub(r"[\x00-\x1f\x7f  ‪-‮⁦-⁩]", " ", str(v))).strip()
    return t if len(t) <= n else t[: n - 1].rstrip() + "…"


def _when(v):
    """An update time (epoch seconds or ISO 8601) as epoch seconds, or None."""
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return float(v) / (1000.0 if v > 1e11 else 1.0)
    if isinstance(v, str) and v.strip():
        import datetime
        try:
            d = datetime.datetime.fromisoformat(v.strip().replace("Z", "+00:00"))
        except ValueError:
            return None
        if d.tzinfo is None:
            d = d.replace(tzinfo=datetime.timezone.utc)
        return d.timestamp()
    return None


def _version(v):
    """A row's or an ask's version as the server gave it (an integer or a short token), else None."""
    if isinstance(v, int) and not isinstance(v, bool):
        return v
    if isinstance(v, str) and re.fullmatch(r"[A-Za-z0-9._:\-]{1,64}", v):
        return v
    return None


def ask_id(text):
    """A stable id for an ask that came without one: the same words keep the same id across rewrites."""
    return "a" + hashlib.sha256(text.strip().lower().encode()).hexdigest()[:10]


ANSWER_ID_RE = r"[A-Za-z0-9._:\-]{1,64}"


def _norm_answer(v):
    """XLI-328 (P1): the server's answer on the reading agent's own ask, kept only when it carries the server's
    status_answer marker (the server sets it only on the asker's own list; no agent can set it). Else None."""
    if not isinstance(v, dict) or not isinstance(v.get("status_answer"), dict):
        return None
    m = v["status_answer"]
    aid = m.get("answer_id")
    if not isinstance(aid, str) or not re.fullmatch(ANSWER_ID_RE, aid):
        return None
    text = v.get("text")
    marker = {"answer_id": aid, "instance": _clean(m.get("instance"), 64), "how": _clean(m.get("how"), 32),
              "answered_at": _clean(m.get("answered_at"), 40), "relayed": m.get("relayed") is True,
              "relayed_from": _clean(m.get("relayed_from"), 64)}
    out = {"status_answer": marker, "from": _clean(v.get("from"), 120),
           "text": _clean(text if isinstance(text, (str, int, float)) and not isinstance(text, bool) else "", 2000),
           "read_as": _clean(v.get("read_as"), 300)}
    if isinstance(v.get("option"), (str, int)) and not isinstance(v.get("option"), bool):
        out["option"] = _clean(v["option"], 120)
    return out


# XLI-310 item 2: the plain ask, as the server's isPlainAsk (src/agents/answers.ts) judges it: only these fields (beside
# the ones the server itself adds to a listed ask), each a single value, options a list of text or {label: text}, and
# needs_person absent or false. Only a plain ask is answered from here with a typed proof; any other one (an ask with
# effects: touches, if_yes, if_no) keeps the site click (EPM ruling, D2 no).
PLAIN_ASK_FIELDS = ("id", "text", "details", "options", "default", "by_when", "needs_person")
SERVER_ASK_FIELDS = ("instance", "status_answer", "answer", "default_due_at")


def _single(v):
    return v is None or isinstance(v, (str, bool)) or (isinstance(v, (int, float)) and math.isfinite(v))


def _plain_option(o):
    return isinstance(o, str) or (isinstance(o, dict) and list(o) == ["label"] and isinstance(o["label"], str))


def _plain_ask(a):
    if isinstance(a, str):
        return True
    if not isinstance(a, dict) or ("needs_person" in a and a["needs_person"] is not False):
        return False
    for k, v in a.items():
        if k in SERVER_ASK_FIELDS:
            continue
        if k not in PLAIN_ASK_FIELDS:
            return False
        if not (_single(v) or (k == "options" and isinstance(v, list) and all(_plain_option(o) for o in v))):
            return False
    return True


def _norm_ask(a, server=False, cached=False):
    """One ask. server: a row read from datastash, whose own asks may carry the server's instance and answer (P1);
    never for what an agent writes itself. cached: this computer's own copy of such a row (plain and options as kept)."""
    if isinstance(a, str):
        a = {"text": a}
    if not isinstance(a, dict):
        return None
    if a.get("answered") is True or a.get("answered_at") or a.get("status") in ("answered", "done"):
        return None
    text = _clean(a.get("text"), 300)
    if not text:
        return None
    out = {"id": _clean(a.get("id"), 64) or ask_id(text), "text": text, "touches": _clean(a.get("touches"), 160),
           "if_yes": _clean(a.get("if_yes"), 240), "if_no": _clean(a.get("if_no"), 240),
           "details": _clean(a.get("details"), 2000), "version": _version(a.get("version"))}
    if server:
        inst = a.get("instance")
        if isinstance(inst, str) and re.fullmatch(ANSWER_ID_RE, inst):
            out["instance"] = inst
        ans = _norm_answer(a.get("answer"))
        if ans is not None:
            out["answer"] = ans
        # XLI-310 item 2: whether a typed answer may go from here, and the options it must match (as the agent wrote them)
        if cached:
            out["plain"] = a.get("plain") is True and not (out["touches"] or out["if_yes"] or out["if_no"])
            opts = a.get("options")
        else:
            out["plain"] = _plain_ask(a)
            opts = a.get("options") if isinstance(a, dict) else None
            opts = [o["label"] if isinstance(o, dict) else o for o in opts] if isinstance(opts, list) and all(_plain_option(o) for o in opts) else None
        if isinstance(opts, list) and opts and all(isinstance(o, str) for o in opts):
            out["options"] = opts
    return out


CARD_STEPS = ("built", "review", "merged", "epm_pass", "live", "live_check")
CARD_STEP_WORDS = {"built": "built", "review": "review", "merged": "merged", "epm_pass": "EPM pass", "live": "live",
                   "live_check": "live check passed"}


def _norm_card(c):
    if not isinstance(c, dict):
        return None
    cid = _clean(c.get("id") or c.get("card") or c.get("pr"), 40)
    if not cid:
        return None
    step = _clean(c.get("step"), 20).lower().replace(" ", "_").replace("-", "_")
    step = {"epm": "epm_pass", "check": "live_check", "live_check_passed": "live_check"}.get(step, step)
    return {"id": cid, "title": _clean(c.get("title"), 80), "step": step if step in CARD_STEPS else "",
            "review": _clean(c.get("review"), 120), "blocker": _clean(c.get("blocker"), 120)}


def _norm_running(x):
    if isinstance(x, str):
        x = {"what": x}
    if not isinstance(x, dict) or not _clean(x.get("what"), 120):
        return None
    return {"what": _clean(x.get("what"), 120), "on": _clean(x.get("on"), 80), "stuck": x.get("stuck") is True}


def _norm_health(h):
    if isinstance(h, str):
        return {"new_errors": "", "failing_checks": [], "note": _clean(h, 160)}
    if not isinstance(h, dict):
        return {"new_errors": "", "failing_checks": [], "note": ""}
    fc = h.get("failing_checks") if isinstance(h.get("failing_checks"), list) else []
    ne = h.get("new_errors")
    return {"new_errors": _clean(ne if not isinstance(ne, bool) else "", 40),
            "failing_checks": [x for x in (_clean(f, 80) for f in fc) if x][:20], "note": _clean(h.get("note"), 160)}


def _norm_done(x):
    if isinstance(x, str):
        x = {"request": x}
    if not isinstance(x, dict) or not _clean(x.get("request"), 120):
        return None
    return {"request": _clean(x.get("request"), 120), "done": x.get("done") is True, "proof": _clean(x.get("proof"), 100)}


def _norm_waiting(x):
    if isinstance(x, str):
        x = {"what": x}
    if not isinstance(x, dict) or not _clean(x.get("what"), 120):
        return None
    return {"what": _clean(x.get("what"), 120), "who": _clean(x.get("who"), 64)}


def _list(v):
    return v if isinstance(v, list) else []


def norm_status_row(r, cached=False):
    """One (agent, project) status row from the server (or this machine), normalized; None when it has no agent name.
    cached: read back from this computer's own copy (already normalized once)."""
    if not isinstance(r, dict):
        return None
    name = _clean(r.get("agent") or r.get("name"), 64)
    if not name:
        return None
    ctx = r.get("context") if isinstance(r.get("context"), dict) else {}
    asof = ctx.get("as_of") if isinstance(ctx.get("as_of"), dict) else {}
    asks = [x for x in (_norm_ask(a, server=True, cached=cached) for a in _list(r.get("asks"))) if x]
    context = {k: _clean(ctx.get(k), 120) for k in STATUS_CONTEXT_KEYS}
    context["as_of"] = {k: _when(asof.get(k)) for k in ("git", "gh") if _when(asof.get(k))}
    return {"agent": name, "project": _clean(r.get("project") or ctx.get("project"), 64),
            "doing": _clean(r.get("doing"), 600), "details": _clean(r.get("details"), 2000),
            "context": context, "asks": asks,
            "cards": [x for x in (_norm_card(c) for c in _list(r.get("cards"))) if x],
            "running": [x for x in (_norm_running(c) for c in _list(r.get("running"))) if x],
            "health": _norm_health(r.get("health")),
            "done_asked": [x for x in (_norm_done(c) for c in _list(r.get("done_asked"))) if x],
            "waiting_on": [x for x in (_norm_waiting(c) for c in _list(r.get("waiting_on"))) if x],
            "version": _version(r.get("version")), "sequence": r.get("sequence") if _num_ok(r.get("sequence")) else None,
            "updated_at": _when(r.get("updated_at") if r.get("updated_at") is not None else r.get("updated"))}


def _row_key(r):
    return (r["agent"].lower(), (r.get("project") or "").lower())


def _status_rows(body):
    for k in ("agents", "statuses", "rows"):
        v = body.get(k) if isinstance(body, dict) else None
        if isinstance(v, list):
            return [x for x in (norm_status_row(r) for r in v) if x]
    return []


def _wb_tag(workbook_id):
    return re.sub(r"[^A-Za-z0-9-]", "", str(workbook_id))[:64] or "none"


def status_cache_path(workbook_id):
    return os.path.join(CONF, f"status-{_wb_tag(workbook_id)}.json")


def _read_private_big(path):
    """A JSON object from a private file of this user (mode 600, any size), or None."""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return None
    try:
        if not stat_ok(os.fstat(fd)):
            return None
        with os.fdopen(fd, "r") as f:
            fd = None
            v = json.loads(f.read())
        return v if isinstance(v, dict) else None
    except (OSError, ValueError):
        return None
    finally:
        if fd is not None:
            os.close(fd)


def read_status_cache(workbook_id):
    c = _read_private_big(status_cache_path(workbook_id))
    if not isinstance(c, dict) or not isinstance(c.get("agents"), list) or not _num_ok(c.get("fetched_at")):
        return None
    c["agents"] = [x for x in (norm_status_row(r, cached=True) for r in c["agents"]) if x]
    if not _changed_ok(c.get("changed")):
        c.pop("changed", None)
    if not _num_ok(c.get("failed_at")):
        c["failed_at"] = None
    return c


def _merge_rows(old, new):
    """The server's rows, except a row whose copy on this machine is newer (this machine's own write not yet sent)."""
    mine = {_row_key(r): r for r in old}
    out = []
    for r in new:
        o = mine.get(_row_key(r))
        out.append(o if o is not None and (o.get("updated_at") or 0) > (r.get("updated_at") or 0) else r)
    seen = {_row_key(r) for r in new}
    local = {a["name"].lower() for a in all_agents()}
    out += [r for r in old if _row_key(r) not in seen and r["agent"].lower() in local
            and time.time() - (r.get("updated_at") or 0) < 600]  # this machine's own write the server hasn't got yet
    return out


_KEEP_MORNING = object()  # an agent key's read has no morning lines: the copy keeps the person's last ones


def save_status_cache(workbook_id, rows, fetched_at, merge=True, morning=_KEEP_MORNING, changed=_KEEP_MORNING,
                      listening=_KEEP_MORNING, person_asks=_KEEP_MORNING):
    ensure_dirs()
    with StateLock(f"status-{_wb_tag(workbook_id)}"):
        old = read_status_cache(workbook_id)
        if merge and old:
            rows = _merge_rows(old["agents"], rows)
        c = {"workbook_id": workbook_id, "fetched_at": fetched_at, "agents": rows, "failed_at": None}
        if morning is _KEEP_MORNING:
            morning = (old or {}).get("morning")
            asked = (old or {}).get("morning_asked")
        else:
            asked = _today()  # XLI-375 MEDIUM: the person's read: the server's answer for today (lines or none) is here
        if _morning_ok(morning):
            c["morning"] = {"day": morning["day"], "lines": list(morning["lines"])}
        if _day_ok(asked):
            c["morning_asked"] = asked
        if changed is _KEEP_MORNING:
            changed = (old or {}).get("changed")  # an agent key's read has no changed block: keep the person's last
        elif _changed_ok(changed):
            changed = {"head": changed["head"], "lines": list(changed["lines"]),
                       "at": changed["at"] if _num_ok(changed.get("at")) else fetched_at}
        if _changed_ok(changed):
            c["changed"] = changed
        if listening is _KEEP_MORNING:
            listening = (old or {}).get("listening")  # an agent key's read has no lists: keep the person's last
        if isinstance(listening, dict):
            c["listening"] = listening
        if person_asks is _KEEP_MORNING or person_asks is None:
            person_asks = _person_asks_of(old)  # XLI-388: an agent key's read has none: keep the person's last
        if person_asks:
            c["person_asks"] = person_asks
        write_private(status_cache_path(workbook_id), json.dumps(c))
    return c


def note_refresh_failed(workbook_id):
    """The last refresh failed: say so beside the copy, so its age is never shown as fresh."""
    try:
        with StateLock(f"status-{_wb_tag(workbook_id)}"):
            c = read_status_cache(workbook_id)
            if c is not None:
                c["failed_at"] = time.time()
                write_private(status_cache_path(workbook_id), json.dumps(c))
    except OSError:
        pass


def put_own_row(workbook_id, row):
    """This machine's own write goes into the local copy at once (before it is sent)."""
    ensure_dirs()
    with StateLock(f"status-{_wb_tag(workbook_id)}"):
        old = read_status_cache(workbook_id) or {"agents": [], "fetched_at": 0, "failed_at": None}
        rows = [r for r in old["agents"] if _row_key(r) != _row_key(row)] + [row]
        c = {"workbook_id": workbook_id, "fetched_at": old["fetched_at"], "agents": rows, "failed_at": old.get("failed_at")}
        if _morning_ok(old.get("morning")):
            c["morning"] = old["morning"]
        if _day_ok(old.get("morning_asked")):
            c["morning_asked"] = old["morning_asked"]
        if isinstance(old.get("listening"), dict):
            c["listening"] = old["listening"]
        if _person_asks_of(old):
            c["person_asks"] = _person_asks_of(old)  # XLI-388
        write_private(status_cache_path(workbook_id), json.dumps(c))


# --- the status door (404 until the server builder lands it)

def door_missing():
    """True while the last status call answered 404 (the door is not on the server yet). Cleared by any success."""
    return _num_ok(read_json(DOOR_PATH, {}).get("missing_at"))


def note_door(found):
    try:
        if found:
            if os.path.exists(DOOR_PATH):
                _drop(DOOR_PATH)
        elif not door_missing():
            ensure_dirs()
            write_private(DOOR_PATH, json.dumps({"missing_at": time.time()}))
    except OSError:
        pass


def _status_cred(sess):
    if is_person(sess):
        return read_key(PERSON_SLUG), PERSON_STATUS_PATH
    return read_key(sess["slug"]), STATUS_PATH


STATUS_MAX_PAGES = 10000  # a guard against a server that never stops answering next_cursor (not a data limit)


def _utc_offset_minutes():
    """This machine's offset from UTC now, in minutes east (XLI-359: the person's day for the morning line)."""
    try:
        return int(time.localtime().tm_gmtoff // 60)
    except (AttributeError, TypeError, ValueError, OverflowError):
        return None


def _status_page(path, key, wb, cursor, timeout, asked=False):
    q = {"workbook_id": wb}
    if asked:
        q["asked"] = "1"  # XLI-359: someone asked for this read (the background refresh never says so)
    if cursor is not None:
        q["cursor"] = cursor
    elif path == PERSON_STATUS_PATH and _utc_offset_minutes() is not None:
        q["utc_offset"] = str(_utc_offset_minutes())  # XLI-359: the first page carries the morning lines in this day
    _status, _ctype, text = http("GET", path + "?" + urllib.parse.urlencode(q), key=key, timeout=timeout)
    try:
        body = json.loads(text)
    except ValueError:
        raise ApiError(_status, {"error": "not_json"})
    if not isinstance(body, dict):
        raise ApiError(_status, {"error": "not_json"})
    return body


def fetch_status(sess, timeout=10, asked=False):
    """Every agent's status in sess's agent workbook (XLI-332: a page at a time, following next_cursor to the end);
    saves the local copy only after a whole walk and returns it. A failure partway keeps the old copy and marks it."""
    key, path = _status_cred(sess)
    if key is None:
        raise ApiError(401, {"error": "no_key"})
    wb = sess["workbook_id"]
    rows, cursor, restarted, seq = [], None, False, None
    morning = _KEEP_MORNING if path != PERSON_STATUS_PATH else None
    changed = _KEEP_MORNING if path != PERSON_STATUS_PATH else None
    listening = _KEEP_MORNING if path != PERSON_STATUS_PATH else None
    person_asks = _KEEP_MORNING
    try:
        for _ in range(STATUS_MAX_PAGES):
            body = _status_page(path, key, wb, cursor, timeout, asked)
            if cursor is None and path == PERSON_STATUS_PATH:
                morning = body.get("morning")
                changed = body.get("changed")  # XLI-306: "Changed in the last hour", the person's first page only
                listening = norm_listening(body)  # XLI-375 P2: waiting for the OK, and not listening
                person_asks = norm_person_asks(body)  # XLI-388: hand-off and stuck asks, defaults taken
                person_asks = [] if person_asks is None else person_asks  # the person's read: none now means none
            if cursor is not None and body.get("note") and not restarted:
                # the server could not read our cursor and served page 1 again: start the walk over, once
                restarted, rows, cursor = True, [], None
                body = _status_page(path, key, wb, None, timeout, asked)
            elif cursor is not None and body.get("note"):
                raise ApiError(200, {"error": "cursor_restart"})
            if seq is None and _num_ok(body.get("seq")):
                seq = body["seq"]
            rows += _status_rows(body)
            nxt = body.get("next_cursor")
            if not isinstance(nxt, str) or not nxt:
                break
            cursor = nxt
        else:
            raise ApiError(200, {"error": "too_many_pages"})
    except ApiError as e:
        if e.status == 404:
            note_door(False)
        note_refresh_failed(wb)
        raise
    except Exception:
        note_refresh_failed(wb)
        raise
    note_door(True)
    # Addendum 6 N2: a `keep` value in this reply is ignored. Until the site has a person-only action that sets it (never
    # an agent key, the sync tool or anything an agent can call), only the person's typed words here turn keeping on.
    return save_status_cache(wb, rows, time.time(), morning=morning, changed=changed, listening=listening,
                             person_asks=person_asks)


# --- consent (PM ruling H2): the person's one yes, per project folder

def read_consent():
    c = read_json(CONSENT_PATH, {})
    keep = c.get("keep") if isinstance(c.get("keep"), dict) else {}
    no = c.get("no") if isinstance(c.get("no"), dict) else {}
    off = c.get("off") if isinstance(c.get("off"), dict) else {}
    return {"keep": {k: v for k, v in keep.items() if isinstance(k, str)}, "no": {k: v for k, v in no.items() if isinstance(k, str)},
            "off": {k: v for k, v in off.items() if isinstance(k, str) and k.startswith("/")}}


def off_folders():
    """XLI-328: the folders the person left off on this computer, {folder: the name they used, or None}. A 0.9.x "no"
    record (the old "leave X off") reads as off too."""
    c = read_consent()
    out = {os.path.realpath(k): None for k in c["no"] if k.startswith("/")}
    for k, v in c["off"].items():
        name = v.get("name") if isinstance(v, dict) else None
        out[os.path.realpath(k)] = name if isinstance(name, str) else None
    return out


def is_off(folder):
    """True when folder (or a folder holding it) is off: no datastash call is made from it, no agent works there."""
    if not folder:
        return False
    try:
        here = os.path.realpath(folder)
        return any(_within(here, k) for k in off_folders())
    except (OSError, ValueError):
        return True  # can't tell: off only ever means less sharing


def keep_state():
    """This computer's answer for all its agents: "yes", "no" or None (not asked yet), from the person's own typed answer
    here only (the keep phrase, or yes / no to the question). A server value is never read (Addendum 6 N2)."""
    v = read_json(CONSENT_PATH, {}).get("all")
    if isinstance(v, dict) and isinstance(v.get("keep"), bool):
        return "yes" if v["keep"] else "no"
    return None


KEPT_KEYS = ("all", "server", "clean")  # the per-person keys every consent write keeps (XLI-386: "clean")


def record_keep_all(keep, how):
    """Record this computer's yes or no for all its agents; how must be "typed" (the person's checked typed words here)."""
    if how != "typed":
        return
    c = read_json(CONSENT_PATH, {})
    c = c if isinstance(c, dict) else {}
    key = "all"
    old = c.get(key)
    if isinstance(old, dict) and old.get("keep") is keep:
        return
    c[key] = {"keep": bool(keep), "at": int(time.time())}
    ensure_dirs()
    write_private(CONSENT_PATH, json.dumps(c))


def consent_for(folder):
    """True when this folder (or the folder it is in) may be kept in datastash: a project the person named stays as
    they said (a no is never overridden); otherwise this computer's yes for all its agents."""
    if not folder or is_off(folder):
        return False
    here = os.path.realpath(folder)
    c = read_consent()
    if any(_within(here, os.path.realpath(k)) for k in c["keep"]):
        return True
    if any(_within(here, os.path.realpath(k)) for k in c["no"]):
        return False
    return keep_state() == "yes"


def record_consent(keep, no):
    whole = read_json(CONSENT_PATH, {})
    c = read_consent()
    c.update({k: v for k, v in (whole if isinstance(whole, dict) else {}).items() if k in KEPT_KEYS})
    now = int(time.time())
    for f in keep:
        c["keep"][os.path.realpath(f)] = now
        c["no"].pop(os.path.realpath(f), None)
    for f in no:
        if os.path.realpath(f) not in c["keep"]:
            c["no"][os.path.realpath(f)] = now
    ensure_dirs()
    write_private(CONSENT_PATH, json.dumps(c))


def record_left_off(folders, name=None):
    """The person's "leave <name> off" (XLI-328: full OFF, D4): these folders are off, even when named before. It only
    makes agents share less, so the words alone do it. The "no" record stays beside "off" for an older plugin."""
    whole = read_json(CONSENT_PATH, {})
    c = read_consent()
    c.update({k: v for k, v in (whole if isinstance(whole, dict) else {}).items() if k in KEPT_KEYS})
    now = int(time.time())
    for f in folders:
        c["keep"].pop(os.path.realpath(f), None)
        c["no"][os.path.realpath(f)] = now
        c["off"][os.path.realpath(f)] = {"at": now, "name": name if isinstance(name, str) else None}
    ensure_dirs()
    write_private(CONSENT_PATH, json.dumps(c))


def record_back_on(folders):
    """The person's own typed "put <name> back on datastash" (checked by the checker): these folders are on again."""
    whole = read_json(CONSENT_PATH, {})
    c = read_consent()
    c.update({k: v for k, v in (whole if isinstance(whole, dict) else {}).items() if k in KEPT_KEYS})
    for f in folders:
        rp = os.path.realpath(f)
        for m in ("no", "off"):
            for k in [k for k in c[m] if os.path.realpath(k) == rp]:
                c[m].pop(k, None)
    ensure_dirs()
    write_private(CONSENT_PATH, json.dumps(c))


# --- XLI-328: OFF folders. "leave X off" (and "keep X off datastash", "datastash off") is full OFF on this computer:
# no datastash call from that folder (no sign-in or count at session start, no listener, hello, heartbeat, enroll,
# status, seed, map share or lookup counting), and the PreToolUse hook denies every datastash connector call there.
# Claude Code runs the connector's headersHelper in the plugin's own folder with no project folder, so the helper
# can't tell an off folder: the hook is the fallback (a deny of the whole server, not a list of tools). The folder's
# agent is switched off on datastash with its own key; its key and config move to the off folder (nothing deleted).
# Off stops a careless agent, not a hostile program running as the same user.
OFF_SWITCH_TIMEOUT = 5  # seconds for the one switch-off call (the prompt hook has 10)
OFF_OK = 'OK: "{name}" is off datastash on this computer: no status, no messages and no datastash calls from that folder.'
OFF_SWITCHED = "It is switched off on datastash too."
OFF_REFUSED = "Couldn't switch it off on datastash; it is off on this computer."
OFF_WAITING = "It is off on this computer. On {url}, press Don't allow next to it."
OFF_BACK = 'To turn it back on, type "put {name} back on datastash".'
OFF_CHECK_LINE = ("datastash note (local; information only): datastash is off in this folder (the person left it off): "
                  "no agent, no status and no datastash calls from here. Never register an agent, get a key or use the "
                  "datastash connector here.")
OFF_DENY = ("datastash is off in this folder: the person left it off, so no datastash connector call runs here. Don't "
            "retry it or work around it; only the person can turn it back on (they type \"put <name> back on datastash\").")
OFF_REFUSAL = ("{folder} is off datastash: the person left it off on this computer, so no agent is set up or linked "
               "there (the person types \"put <name> back on datastash\" to turn it back on)")
INSTALL_UPDATED_PATH = os.path.join(STATE, "status-install-updated")  # the updated list after an answer: shown once


def off_here(inp):
    """True when this hook's session works in a folder the person left off (its project folder or its cwd)."""
    inp = inp if isinstance(inp, dict) else {}
    cwd = inp.get("cwd") if isinstance(inp.get("cwd"), str) else None
    return any(is_off(f) for f in (os.environ.get("CLAUDE_PROJECT_DIR"), cwd) if f)


def off_connector_deny(inp):
    """PreToolUse: the deny for a datastash connector call (any datastash MCP server, by name or by its URL, or any ledger_ tool) in a folder
    the person left off, else None. XLI-328 card 3: also in a private folder, except on the plugin's own connector once
    this session's helper handed it the folder's agent key (a claude.ai connector carries the person's login)."""
    if not isinstance(inp, dict) or inp.get("hook_event_name") != "PreToolUse":
        return None
    name = inp.get("tool_name")
    if not isinstance(name, str) or not name.startswith("mcp__"):
        return None
    server, _, tool = name[5:].partition("__")
    why = OFF_DENY if off_here(inp) else (PRIVATE_DENY if private_here(inp) else None)
    if why is None:
        return None
    if "datastash" not in server.lower() and not tool.startswith("ledger_"):
        # a ledger_ tool is datastash's own, on any server: a claude.ai connector the person renamed is in no local config
        cfg = _mcp_configs(inp).get(server)
        if cfg is None or not _server_carries_datastash(cfg):
            return None
    if why is PRIVATE_DENY and server == PLUGIN_SERVER and _helper_served(inp):
        return None
    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                   "permissionDecisionReason": why}}


def switch_off_on_datastash(agent):
    """The agent switches itself off on datastash, on its own key (ruling D1). True only when datastash says it did."""
    key = read_key(agent["slug"])
    if not key:
        return False
    try:
        err, out = mcp_tool(key, "ledger_agent_switch_off", {"name": agent["name"], "action": "off"},
                            timeout=OFF_SWITCH_TIMEOUT)
    except Exception:  # noqa: BLE001 (refused, not reached, not JSON: the plain line)
        return False
    return not err and isinstance(out.get("switched_off"), list)


def park_agent(s):
    """This computer stops using agent s: its key and config move to the off folder, its listener stops."""
    ensure_dirs()
    os.makedirs(OFF, mode=0o700, exist_ok=True)
    moved = []
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for p in (key_path(s), conf_path(s)):
        if os.path.exists(p):
            os.replace(p, os.path.join(OFF, f"{os.path.basename(p)}.{stamp}"))
            moved.append(os.path.basename(p))
    info = read_json(lock_path(s), {})
    if isinstance(info.get("pid"), int) and _alive(info["pid"]) and _is_listener(info["pid"]):
        try:
            os.kill(info["pid"], signal.SIGTERM)
        except OSError:
            pass
    return moved


def turn_off(folders, name):
    """Record these folders off (raises OSError when it can't), then switch off and park each agent all of whose
    folders are now off. Returns the lines for the person."""
    record_left_off(folders, name)
    lines = [OFF_OK.format(name=_clean(name, 64))]
    said = []
    for a in all_agents():
        projects = [p for p in (a.get("projects") or []) if isinstance(p, str)]
        if is_person(a) or not projects or not all(is_off(p) for p in projects):
            continue
        if not any(_within(os.path.realpath(p), f) or _within(f, os.path.realpath(p)) for p in projects for f in folders):
            continue
        line = OFF_SWITCHED if switch_off_on_datastash(a) else OFF_REFUSED
        park_agent(a["slug"])
        if line not in said:
            said.append(line)
    if any(any(_within(f, x) for x in folders) for f in _enrolled()) and OFF_WAITING not in said:
        said.append(OFF_WAITING.format(url=AGENTS_URL))
    return lines + said + [OFF_BACK.format(name=_clean(name, 64))]


def _name_hit(text, want):
    return isinstance(text, str) and _phrase(text) == want


def _off_matches(name):
    """The off folders the person means by name (the name they used, or the folder's name)."""
    want = _phrase(name)
    return sorted(f for f, n in off_folders().items()
                  if _name_hit(n, want) or _name_hit(os.path.basename(f.rstrip("/")), want))


def _known_match(name):
    """A folder of this user on this computer that the person means by name (its name, its path or ~/path), else None."""
    want = _phrase(name)
    home = os.path.realpath(HOME)
    for f in known_folders():
        rp = os.path.realpath(f)
        tilde = "~" + rp[len(home):] if _within(rp, home) else None
        if want in (_phrase(os.path.basename(rp.rstrip("/"))), _phrase(rp), _phrase(tilde or "")):
            return rp
    return None


def _here_root(here):
    """("datastash off"): this folder's agent's linked folder and name, else its waiting agent's, else the folder."""
    a = agent_for(here)
    if a is not None:
        return linked_folder(a, here), disp(a["name"])
    w = waiting_record(here)
    if w is not None:
        return w[0], disp(w[1]["name"])
    rp = os.path.realpath(here)
    return rp, _project_name(rp)


# --- XLI-328 card 3: PRIVATE folders. Private is set and cleared only by the person, on the agents page (ruling D2):
# the plugin never sets it and sends it in no request. It records an agent as private only from datastash's own answer
# to the plugin's own call (the approval poll, register or hello) that says private: true, and forgets it only on
# private: false; a missing field, an error or an answer about another agent changes nothing. In a private folder:
# the connector's headersHelper hands over the agent's own key (D3), never the person's login. Claude Code runs the
# helper with no project folder, so where it can't tell the folder the PreToolUse hook denies the datastash connector
# there (the whole server, as for OFF), unless this very Claude Code process's helper handed that folder's agent key.
# Status, hello's causes, the heartbeat, the map's tab share and lookup feeds stay on this computer; the map, `where`,
# lookup counting, nudges and check-backs keep working. The server enforces private either way (agent_private).
PRIVATE_PATH = os.path.join(CONF, "status-private.json")  # {"agents": {agent_id: {"at", "slug"}}, "field_at"}
PLUGIN_SERVER = "plugin_datastash_datastash"  # the plugin's own connector, the one whose helper this file is
PRIVATE_COMING = 'Private mode is coming. Until then, type "leave {name} off" to keep it off datastash.'
PRIVATE_LINK = "To keep {name} private, press 'Turn private on' next to it on {url}. Until you do, it is on datastash."
PRIVATE_ALREADY = ('"{name}" is private: datastash shares nothing from it with your other agents. Only you change that, '
                   "on {url}.")
PRIVATE_STATUS = ("kept on this machine only: this agent is private, so its status is not shared with your other agents "
                  "(the person changes private on the agents page)")
PRIVATE_FEED = "Not set up: a datastash feed would share it with your other agents."
PRIVATE_DENY = ("This folder's agent is private, and this session's datastash connector does not carry its own key, so "
                "no datastash connector call runs here (it would go out as the person). Don't retry it or work around "
                "it: use the datastash command here (`datastash api ...`), which uses the agent's own key. Only the "
                "person changes private, on the agents page.")
PRIVATE_REFUSAL = ("{folder}: this folder's agent is private, so it is never put into another folder and no other agent "
                   "is linked here (only the person changes private, on {url})")


def _private_rec():
    rec = read_json(PRIVATE_PATH, {})
    rec = rec if isinstance(rec, dict) else {}
    agents = rec.get("agents") if isinstance(rec.get("agents"), dict) else {}
    return {"agents": {k.lower(): (v if isinstance(v, dict) else {}) for k, v in agents.items()
                       if isinstance(k, str) and re.fullmatch(AGENT_ID_RE, k)},
            "field_at": rec.get("field_at") if _num_ok(rec.get("field_at")) else None}


def note_private(answer, agent_id, agent_slug=None):
    """Record what datastash's answer to the plugin's own call about agent_id says: private: true records the agent as
    private, private: false forgets it. Anything else (no field, not a boolean, not a dict, another agent's id in the
    answer, no agent asked about) changes nothing. Returns the boolean recorded, or None. Never raises."""
    if not isinstance(answer, dict) or not isinstance(agent_id, str) or not re.fullmatch(AGENT_ID_RE, agent_id):
        return None
    v = answer.get("private")
    if not isinstance(v, bool):
        return None
    said = answer.get("agent_id")
    if said is not None and (not isinstance(said, str) or said.lower() != agent_id.lower()):
        return None
    try:
        ensure_dirs()
        with StateLock("private"):
            rec = _private_rec()
            if v:
                rec["agents"][agent_id.lower()] = {"at": int(time.time()),
                                                   "slug": agent_slug if isinstance(agent_slug, str) else None}
            else:
                rec["agents"].pop(agent_id.lower(), None)
            rec["field_at"] = int(time.time())
            write_private(PRIVATE_PATH, json.dumps(rec))
    except OSError:
        return None
    return v


def private_field_seen():
    """True once a datastash answer carried the private field (card 2 is live): private can be offered."""
    return _private_rec()["field_at"] is not None


def agent_private(agent):
    """True when datastash told this computer that this agent is private."""
    if not isinstance(agent, dict) or is_person(agent):
        return False
    rec = _private_rec()["agents"]
    if not rec:
        return False
    aid = agent.get("agent_id")
    if isinstance(aid, str) and aid:
        return aid.lower() in rec
    return any(v.get("slug") == agent.get("slug") for v in rec.values())  # an older config without its agent_id


def shares_from(agent):
    """True when this agent's sharing calls (status, heartbeat, map tab, feeds) may go to datastash."""
    return not agent_private(agent)


def is_private(folder):
    """True when folder's agent (or the agent it waits for) is private. Can't tell, with private agents recorded: True
    (private only ever means less sharing)."""
    if not folder:
        return False
    try:
        rec = _private_rec()["agents"]
        if not rec:
            return False
        here = os.path.realpath(folder)
        a = agent_for(here)
        if a is not None:
            return agent_private(a)
        w = waiting_record(here)
        return w is not None and isinstance(w[1].get("agent_id"), str) and w[1]["agent_id"].lower() in rec
    except Exception:  # noqa: BLE001
        return True


def private_here(inp):
    """True when this hook's session works in a private folder (its project folder or its cwd)."""
    inp = inp if isinstance(inp, dict) else {}
    cwd = inp.get("cwd") if isinstance(inp.get("cwd"), str) else None
    return any(is_private(f) for f in (os.environ.get("CLAUDE_PROJECT_DIR"), cwd) if f)


def _helper_mark_path(proc):
    return os.path.join(STATE, f"private-helper-{int(proc[0])}-{re.sub(r'[^A-Za-z0-9]', '_', str(proc[1]))[:40]}.json")


def private_helper_header():
    """token --header: the header for a private folder the helper can see (CLAUDE_PROJECT_DIR, or a cwd outside the
    plugin's own folder): the agent's own key, or the signed-out placeholder when it has none (never the person's
    login). None when the helper sees no private folder. Records which folder this Claude Code process got the key for,
    so the PreToolUse hook lets the connector run there."""
    folder = os.environ.get("CLAUDE_PROJECT_DIR")
    if not folder:
        cwd = os.path.realpath(os.getcwd())
        if _within(cwd, os.path.realpath(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))):
            return None  # Claude Code's usual helper folder: the plugin's own; the hook is the fallback
        folder = cwd
    if not is_private(folder):
        return None
    agent = agent_for(folder)
    key = read_key(agent["slug"]) if agent is not None else None
    if not (isinstance(key, str) and re.fullmatch(r"ldgr_ag_[A-Za-z0-9_\-]+", key)):
        return {"Authorization": f"Bearer {SIGNED_OUT_BEARER}"}
    me = this_session()
    if me["proc"] is not None:
        try:
            ensure_dirs()
            write_private(_helper_mark_path(me["proc"]), json.dumps(
                {"folder": linked_folder(agent, folder), "slug": agent["slug"], "at": int(time.time())}))
        except OSError:
            pass  # no mark: the hook keeps denying the connector there (less, never more)
    return {"Authorization": f"Bearer {key}"}


def _helper_served(inp):
    """True when this session's own Claude Code process had its connector helper hand this folder's agent key."""
    me = this_session(inp)
    if me["proc"] is None:
        return False
    mark = read_json(_helper_mark_path(me["proc"]), None)
    if not isinstance(mark, dict) or not isinstance(mark.get("folder"), str):
        return False
    here = os.path.realpath(project_of(inp))
    agent = agent_for(here)
    return agent is not None and mark.get("slug") == agent["slug"] and _within(here, os.path.realpath(mark["folder"]))


def private_link_refusal(agent_slug, target, current):
    """The refusal (a line) when linking agent_slug into target would put a private folder's agent into another folder,
    or another agent into a private folder; else None."""
    target, current = os.path.realpath(target), os.path.realpath(current)
    if target != current and is_private(current):
        return PRIVATE_REFUSAL.format(folder=current, url=AGENTS_URL)
    c = read_json(conf_path(agent_slug), None) if agent_slug else None
    if isinstance(c, dict) and agent_private(dict(c, slug=agent_slug)) \
            and not any(_within(target, os.path.realpath(p)) for p in (c.get("projects") or []) if isinstance(p, str)):
        return PRIVATE_REFUSAL.format(folder=target, url=AGENTS_URL)
    if is_private(target):
        a = agent_for(target)
        if a is None or a["slug"] != agent_slug:
            return PRIVATE_REFUSAL.format(folder=target, url=AGENTS_URL)
    return None


def private_answer(name):
    """The plugin's own answer to the person's typed "keep X private". It sets nothing and calls nothing."""
    n = _clean(name, 64)
    folders = _leave_folders(name)
    if folders and all(is_private(f) for f in folders):
        return PRIVATE_ALREADY.format(name=n, url=AGENTS_URL)
    if private_field_seen():
        return PRIVATE_LINK.format(name=n, url=AGENTS_URL)
    return PRIVATE_COMING.format(name=n)


def install_window(sid):
    """True while the install question this session showed still takes "add <folder>" (30 minutes)."""
    rec = read_json(INSTALL_ASKED_PATH, {})
    return bool(sid) and rec.get("sid") == sid and _num_ok(rec.get("at")) and time.time() - rec["at"] <= VIEW_MAX_AGE


def install_update_lines():
    """After an answer to the install question: the updated list, once (local files only)."""
    if not os.path.exists(INSTALL_ASKED_PATH) or os.path.exists(INSTALL_UPDATED_PATH):
        return []
    try:
        ensure_dirs()
        write_private(INSTALL_UPDATED_PATH, json.dumps({"at": int(time.time())}))
    except OSError:
        return []
    on = []
    for a in all_agents():
        projects = [p for p in (a.get("projects") or []) if isinstance(p, str)]
        if not is_person(a) and not (projects and all(is_off(p) for p in projects)):
            on.append(disp(a["name"]) + (": private" if agent_private(a) else ""))
    for f, rec in sorted(_enrolled().items()):
        if not is_off(f) and not _folder_has_agent(f):
            on.append(f"{disp(rec['name'])}{': private' if is_private(f) else ''} (waiting for your OK on {AGENTS_URL})")
    off = [_clean(n or os.path.basename(f.rstrip("/")), 64) for f, n in sorted(off_folders().items())]
    out = ["Your agents on datastash now: " + (", ".join(on) if on else "none") + "."]
    if off:
        out.append("Off datastash on this computer: " + ", ".join(off) + ".")
    return out


# --- XLI-386: Clean sessions, two of the person's own choices for all their agents on this computer (owner 11-22: "it's
# a personal thing"; each is chosen by itself). Kept in the per-person settings file beside the keep answer.
CLEAN_DEFAULTS = {"commands": True, "no_code": False}  # commands through subagents: on; no code in sessions: off
CLEAN_NOTE = "datastash note (clean sessions; the person's own choices)"
CLEAN_BLOCK = "Clean sessions is on: hand this to a subagent (Agent tool), then report the result in plain words."
CLEAN_COMMANDS_RULE = ("Commands through subagents is on: this session doesn't edit files or run shell commands itself (the "
                       "plugin refuses them here; only a short read-only lookup runs). Hand the work to a subagent "
                       "(Agent tool), and ask it to report back in plain words only (what changed, the result, any "
                       "blocker), with no commands or output.")
CLEAN_NO_CODE_RULE = ("No code in sessions is on: code reading and writing go to a subagent too, and this session shows "
                      "no code and no code blocks; the subagent reports in plain words.")


def clean_settings():
    """The person's two Clean sessions choices on this computer: {"commands": bool, "no_code": bool} (the defaults when
    unset or unreadable)."""
    v = read_json(CONSENT_PATH, {})
    v = v.get("clean") if isinstance(v, dict) else None
    v = v if isinstance(v, dict) else {}
    return {k: v[k] if isinstance(v.get(k), bool) else d for k, d in CLEAN_DEFAULTS.items()}


def set_clean(commands=None, no_code=None):
    """Change one or both choices (None leaves it as it is); every other per-person setting stays."""
    cur = clean_settings()
    if commands is not None:
        cur["commands"] = bool(commands)
    if no_code is not None:
        cur["no_code"] = bool(no_code)
    whole = read_json(CONSENT_PATH, {})
    whole = whole if isinstance(whole, dict) else {}
    whole["clean"] = dict(cur, at=int(time.time()))
    ensure_dirs()
    write_private(CONSENT_PATH, json.dumps(whole))
    return cur


def _clean_rules(cur):
    return " ".join(r for on, r in ((cur["commands"], CLEAN_COMMANDS_RULE), (cur["no_code"], CLEAN_NO_CODE_RULE)) if on)


def clean_session_text(cur=None):
    """The rules for the AI, only for the choices that are on ("" when both are off)."""
    rules = _clean_rules(clean_settings() if cur is None else cur)
    if not rules:
        return ""
    return (f"{CLEAN_NOTE}: {rules} Decisions and plain-words reports stay in this session. It is the person's own "
            "choice; never comment on it.")


# XLI-396 (owner 11-23: clean sessions ENFORCES subagents; a block, not a nudge). Deny by default (review 2: a deny-list
# of named tools let Monitor and PowerShell through): the main session (no agent_id) runs only the tools on
# CLEAN_ALLOWED_TOOLS, which can't change a file or run code, and the read-only tools of the datastash connector. Every
# other tool is refused, an unknown or future one included, and so is any MCP tool that writes (but the connector steps
# the plugin checks or writes itself, CLEAN_DS_STEP_TOOLS). Every tool that runs a
# command (Bash, Monitor, PowerShell, or any tool input with a "command") goes through the one check, clean_command_ok:
# one short read-only lookup from the allow-list below, or a read of the plugin's own datastash command (Monitor also
# `datastash watch`). No code in sessions also refuses the lookups that show file text.
CLEAN_ALLOWED_TOOLS = frozenset((
    "Read", "Grep", "Glob",  # read files only
