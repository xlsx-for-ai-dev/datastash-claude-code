ORIGIN = "https://getdatastash.com"
# XLI-390 P2 (owner 11-23): every call names the real plugin version, in its own header and in the User-Agent, so datastash
# can count who is on 1.0. Read from this copy's plugin.json; never sent when it can't be read.
PLUGIN_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VERSION_RE = r"(\d{1,4})\.(\d{1,4})\.(\d{1,4})"


def plugin_version(root=PLUGIN_ROOT):
    """This copy's version from its plugin.json ("X.Y.Z"), or None."""
    try:
        with open(os.path.join(root, ".claude-plugin", "plugin.json")) as f:
            v = json.load(f).get("version")
    except (OSError, ValueError, AttributeError):
        return None
    return v if isinstance(v, str) and re.fullmatch(VERSION_RE, v) else None


def version_tuple(v):
    m = re.fullmatch(VERSION_RE, v) if isinstance(v, str) else None
    return tuple(int(x) for x in m.groups()) if m else None


PLUGIN_VERSION = plugin_version()
VERSION_HEADER = "X-Datastash-Plugin-Version"
USER_AGENT = "datastash-claude-code-plugin/" + (PLUGIN_VERSION or "unknown")
API_PREFIX = "/api/v1/agent/"
PICKUP_PATH = "/api/v1/agent/pickup"
INBOX_PATH = "/api/v1/agent/inbox"
PERSON_WATCH_PATH = "/api/v1/person/watch"
PERSON_INBOX_PATH = "/api/v1/person/inbox"
# The person's own session ("datastash main"): its files are person.key / person.json; its state uses this slug, which no
# agent can have (an agent's slug is letters, digits and dashes only).
PERSON_SLUG = "@person"
PERSON_KEY_RE = r"ldgr_pw_[A-Za-z0-9_\-]+"
# The person's main key (ldgr_pm_...): made once per machine from the person's own Google sign-in of the datastash
# connector (ledger_person_watch action "main", which datastash answers only on the person's own connection, never once it
# has registered agents); kept in main.key (mode 600, never printed). Person scope on the REST door's person routes.
# Owner ruling 11-19: the person typing "datastash main" is the approval; there is no approval page.
MAIN_KEY_RE = r"ldgr_pm_[A-Za-z0-9_\-]+"
PERSON_FILTER_PATH = "/api/v1/person/filter"
PERSON_WORKBOOKS_PATH = "/api/v1/person/agent-workbooks"
MAIN_PICKUP_RE = r"dsmk_[A-Za-z0-9_\-]{6,200}"
# The one connector call a clean session makes on its way to main (the plugin's own connector, exactly this input).
MAIN_CODE_TOOL = "mcp__plugin_datastash_datastash__ledger_person_watch"
MAIN_CODE_INPUT = {"action": "main"}
MAIN_CODE_KEYS = {"main_pickup_code", "expires_at", "note"}
WAIT_SECONDS = 25
# XLI-374: the listener has no time limit of its own. Its hook timeout in hooks.json is 2,000,000 s (about 23 days;
# Claude Code honours it, tested 11-21), so an idle session keeps listening for days and never wakes for nothing.
# A refused or missing key parks the listener: it re-reads the key file here every PARK_CHECK_SECONDS (local only, no
# network) and goes on once a working key is there. The listener never asks datastash for a key or a pickup code: a new
# key comes only from the person's own step (the join flow), because asking for one stops the agent's live key, which
# may be another computer's working key.
PARK_CHECK_SECONDS = 5
# The listening heartbeat (POST /api/v1/agent/heartbeat, XLI-318 presence), in its own thread: about every 10 minutes
# while the listener polls with a key; none while parked. A 404 (an older datastash) waits an hour.
HEARTBEAT_PATH = "/api/v1/agent/heartbeat"
BEAT_SECONDS = float(os.environ.get("DATASTASH_BEAT_SECONDS", "600"))
BEAT_NOT_FOUND_SECONDS = 3600
CHECK_BUDGET_SECONDS = 4
BACKOFF_START, BACKOFF_MAX = 5, 300
NOT_FOUND_BACKOFF = 600
# A cursor the server keeps calling expired (410) after this many straight tries is treated as an error (backoff).
GONE_LIMIT = 2
# A long poll that answers within FAST_POLL_SECONDS with nothing new is followed by a short pause (1-2 s, jittered).
FAST_POLL_SECONDS = 1.0
# Wake pacing (local only, not a user limit): after a first arrival the listener gathers for WAKE_GATHER_SECONDS so a
# burst becomes one wake, and it wakes the session at most once per WAKE_MIN_SECONDS; arrivals in between are batched
# into the next wake. Nothing is dropped: the cursor and the "new" ids are saved before every wake.
WAKE_GATHER_SECONDS = float(os.environ.get("DATASTASH_WAKE_GATHER_SECONDS", "3"))
WAKE_MIN_SECONDS = float(os.environ.get("DATASTASH_WAKE_MIN_SECONDS", "30"))
# A sender whose wakes bring nothing handled waits longer before its items wake the session again (local pause only;
# nothing is refused or dropped, and other senders are not slowed): WAKE_MIN_SECONDS doubled per idle wake, up to this.
WAKE_IDLE_MAX_SECONDS = float(os.environ.get("DATASTASH_WAKE_IDLE_MAX_SECONDS", "3600"))
# The SessionStart check never holds the session up longer than this, even if DNS or the network stalls.
CHECK_WAIT_SECONDS = float(os.environ.get("DATASTASH_CHECK_WAIT_SECONDS", "6"))
LOG_MAX_BYTES = 256 * 1024

HOME = os.path.expanduser("~")
CONF = os.environ.get("DATASTASH_CONFIG_DIR") or os.path.join(HOME, ".config", "datastash")
